#!/usr/bin/env sh
# .githooks/commit-msg - enforce Conventional Commits format

first_line="$(grep -v '^#' "${1}" | grep -v '^[[:space:]]*$' | head -1)"

case "${first_line}" in
Merge\ * | Revert\ *) exit 0 ;;
esac

if ! printf '%s' "${first_line}" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?(!)?: .+'; then
    printf 'commit-msg: does not follow Conventional Commits format\n' >&2
    printf '  expected: <type>[(<scope>)][!]: <description>\n' >&2
    printf '  types:    feat fix docs style refactor perf test build ci chore revert\n' >&2
    printf '  got:      %s\n' "${first_line}" >&2
    exit 1
fi
