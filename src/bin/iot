#!/bin/sh

# - TODO:  iot-store: Set a store for snap(craft)
# - TODO:  iot-corevm: Script for launching QEMU instances for Core
# - TODO:  Other env fuckery??
# - TODO:  Output instructions for correctly sourcing the command
#            i.e. `iot() { eval $(idiot "$@"); }`
# - FIXME: Standardize the different scripts
#            - Style, function names, etc
#            - Usage output

print_usage() {
	echo "IDIoT (Interactive Devtools for IoT)"
	echo
	echo "USAGE: ${PROG} [subcommand]"
	echo
	echo "SUBCOMMANDS"
	for _cmd in $COMMANDS; do
	  _cmd_name="$(basename "$_cmd")"; _cmd_name="${_cmd_name#iot-}"
		printf '%8s    %s\n' "${_cmd_name}" "$("${_cmd}" description)"
	done | sort
	alias_warning
} >&2

alias_warning() {
	# shellcheck disable=SC2016
	[ "${IDIOT_WARNING:-}" != "0" ] || {
		echo
		echo '-------------------------------------------------------------------------'
		echo
		echo 'NOTE: This program is meant to be used in the following way:'
		echo '  iot() { eval $(idiot "$@"); }'
		echo
		echo 'You can disable this warning by setting IDIOT_WARNING=0 in your environment.'
	} >&2
}

process_commands() {
	{ [ "$_arg" != "help" ]; } ||
		return 0

	for _cmd in $COMMANDS; do
	  _cmd_name="$(basename "$_cmd")"

	  [ "iot-${_arg}" = "$_cmd_name" ] ||
	  	continue

	  # shellcheck disable=SC2063
		exec "${_cmd}" "$@"
  done

	echo "err: command '${_arg}' not found." >&2
	echo >&2
}

main() {
	set -eu

	PROG="$(basename "$0")";
	export PROG

	: "${IDIOT_BIN:=/usr/bin}"
	: "${IDIOT_DATA_ROOT:=${XDG_DATA_HOME:-${HOME}/.local/share}}"
	export IDIOT_DATA_ROOT

	COMMANDS="$(find "${SNAP}/bin" -maxdepth 1 -executable -name 'iot-*')"

	_arg="${1:-help}"
	[ "$#" -eq 0 ] ||
		shift

	export IDIOT_DATA="${IDIOT_DATA_ROOT}/${_arg}"
	process_commands "$@"

	print_usage
	return 1
}

main "$@"
