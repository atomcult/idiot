#!/bin/sh

# - TODO:  iot-store: Set a store for snap(craft)
# - TODO:  iot-corevm: Script for launching QEMU instances for Core
# - TODO:  Other env fuckery??
# - TODO:  Output instructions for correctly sourcing the command
#            i.e. `iot() { eval $(idiot "$@"); }`
# - FIXME: Standardize the different scripts
#            - Style, function names, etc
#            - Usage output

PROG="$(basename "$0")";
readonly PROG; export PROG

# DEBUG
: "${SNAP:=$PWD}";
readonly SNAP; export SNAP

: "${SNAP_USER_COMMON:="${PWD}/data"}";
readonly SNAP_USER_COMMON; export SNAP_USER_COMMON

print_usage() {
	echo "IDIoT (Interactive Devtools for IoT)"
	echo
	echo "usage: ${PROG} [subcommand]"
	echo
	echo "SUBCOMMANDS"
	for _cmd in $_commands; do
	  _cmd_name="$(basename "$_cmd")"; _cmd_name="${_cmd_name#iot-}"
		printf '%8s    %s\n' "${_cmd_name}" "$("${_cmd}" description)"
	done | sort
} >&2

process_builtins() {
	case "$_arg" in
		help)
			# shellcheck disable=SC2016
			{
				echo 'This program is meant to be used in the following way:'
				echo '  iot() { eval $(idiot "$@"); }'
				echo
				print_usage
				return 1
			} >&2
			;;
	esac
}

process_commands() {
	for _cmd in $_commands; do
	  _cmd_name="$(basename "$_cmd")"

	  [ "iot-${_arg}" != "$_cmd_name" ] ||
			exec "${_cmd}" "$@"
  done
}

main() {
	_commands="$(find "${SNAP}/bin" -maxdepth 1 -executable -name 'iot-*')"

	_arg="${1:-help}"
	shift || true

	# Process builtins
	process_builtins "$@"
	process_commands "$@"

	print_usage
	return 1
}

main "$@"
