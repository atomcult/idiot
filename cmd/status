#!/usr/bin/env sh
# cmd/status - show current idiot environment at a glance

. "$(dirname "${0}")/../share/common.sh"
include arch.sh
include creds.sh
include stores.sh
include lp.sh

_row() {
	_r_label="${1}"
	_r_value="${2}"
	_r_ann="${3:-}"
	_r_gap=$((8 - ${#_r_label}))
	[ "${_r_gap}" -lt 1 ] && _r_gap=1
	if [ -n "${_r_ann}" ]; then
		say "  ${CYAN}${_r_label}${RESET}$(printf '%*s' "${_r_gap}" '')${_r_value}  ${DIM}${_r_ann}${RESET}"
	else
		say "  ${CYAN}${_r_label}${RESET}$(printf '%*s' "${_r_gap}" '')${_r_value}"
	fi
}

_repeat() {
	_rn="${1}" _rc="${2}" _rs=''
	while [ "${_rn}" -gt 0 ]; do
		_rs="${_rs}${_rc}"
		_rn=$((_rn - 1))
	done
	printf '%s' "${_rs}"
}

_xp_bar() {
	_xp=0
	_xp_file="${IDIOT_CACHE_DIR}/invoke-count"
	if [ -f "${_xp_file}" ]; then
		_xp="$(cat "${_xp_file}" 2>/dev/null || :)"
		case "${_xp}" in
		'' | *[!0-9]*) _xp=0 ;;
		esac
	fi

	if [ "${_xp}" -ge 10000 ]; then
		_cur='🌌' _start=10000 _next=0 _nxt=''
	elif [ "${_xp}" -ge 5000 ]; then
		_cur='🪐' _start=5000 _next=10000 _nxt='🌌'
	elif [ "${_xp}" -ge 2500 ]; then
		_cur='☀️' _start=2500 _next=5000 _nxt='🪐'
	elif [ "${_xp}" -ge 1000 ]; then
		_cur='🌍' _start=1000 _next=2500 _nxt='☀️'
	elif [ "${_xp}" -ge 500 ]; then
		_cur='🌲' _start=500 _next=1000 _nxt='🌍'
	elif [ "${_xp}" -ge 200 ]; then
		_cur='🌳' _start=200 _next=500 _nxt='🌲'
	elif [ "${_xp}" -ge 75 ]; then
		_cur='🌿' _start=75 _next=200 _nxt='🌳'
	elif [ "${_xp}" -ge 25 ]; then
		_cur='🌱' _start=25 _next=75 _nxt='🌿'
	elif [ "${_xp}" -ge 10 ]; then
		_cur='🥚' _start=10 _next=25 _nxt='🌱'
	else
		_cur='💀' _start=0 _next=10 _nxt='🥚'
	fi

	_bw=10
	if [ -z "${_nxt}" ]; then
		_filled="${_bw}"
		_empty=0
		_ann="max level"
	else
		_span=$((_next - _start))
		_filled=$(((_xp - _start) * _bw / _span))
		[ "${_filled}" -gt "${_bw}" ] && _filled="${_bw}"
		_empty=$((_bw - _filled))
		_ann="$((_xp - _start))/${_span}"
	fi

	_bar="${GREEN}$(_repeat "${_filled}" '█')${RESET}${DIM}$(_repeat "${_empty}" '▒')${RESET}"

	if [ -z "${_nxt}" ]; then
		_row "xp" "${_cur} [${_bar}]" "${_ann}"
	else
		_row "xp" "${_cur} [${_bar}] ${_nxt}" "${_ann}"
	fi
}

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot status"
		echo >&2
		say "Shows the active store credential, store, architecture, and Launchpad identity."
		exit 0
		;;
	esac

	# Auth
	if [ -n "${SNAPCRAFT_STORE_CREDENTIALS:-}" ] || [ -n "${UBUNTU_STORE_AUTH:-}" ]; then
		_auth_value="${BOLD}logged in${RESET}"
		_auth_ann=""
		if [ -n "${IDIOT_ACTIVE_CRED:-}" ]; then
			_auth_ann="${IDIOT_ACTIVE_CRED}"
			_whoami_cache="$(whoami_cache_path "${IDIOT_ACTIVE_CRED}")"
			if [ -f "${_whoami_cache}" ]; then
				_email="$(grep '^email: ' "${_whoami_cache}" | sed 's/^email: //')"
				[ -n "${_email}" ] && _auth_ann="${IDIOT_ACTIVE_CRED} · ${_email}"
			fi
		fi
	else
		_auth_value="${DIM}not logged in${RESET}"
		_auth_ann=""
	fi
	_row "auth" "${_auth_value}" "${_auth_ann}"

	# Store
	if [ -n "${UBUNTU_STORE_ID:-}" ]; then
		_store_name=""
		if [ -d "${IDIOT_STORES_DIR}" ]; then
			for _f in "${IDIOT_STORES_DIR}"/*; do
				[ -f "${_f}" ] || continue
				_fid="$(cat "${_f}")"
				if [ "${_fid}" = "${UBUNTU_STORE_ID}" ]; then
					_store_name="${_f##*/}"
					break
				fi
			done
		fi
		if [ -n "${_store_name}" ]; then
			_row "store" "${BOLD}${_store_name}${RESET}" "${UBUNTU_STORE_ID}"
		else
			_row "store" "${BOLD}${UBUNTU_STORE_ID}${RESET}"
		fi
	else
		_row "store" "${DIM}global${RESET}"
	fi

	# Arch
	if [ -n "${UBUNTU_STORE_ARCH:-}" ]; then
		_row "arch" "${BOLD}${UBUNTU_STORE_ARCH}${RESET}"
	else
		_host_arch="$(uname_to_snap_arch)"
		_row "arch" "${DIM}${_host_arch}${RESET}" "host default"
	fi

	# Launchpad
	_lp_val="$(lp_user_value)"
	if [ -n "${_lp_val}" ]; then
		_row "lp" "${BOLD}${_lp_val}${RESET}"
	else
		_row "lp" "${DIM}not set${RESET}"
	fi

	# XP
	echo >&2
	_xp_bar
}
main "$@"
