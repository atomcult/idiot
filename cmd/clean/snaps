#!/usr/bin/env sh
# cmd/clean/snaps - remove all dangerously-installed (unasserted) snaps

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    dry_run=0
    while [ $# -gt 0 ]; do
        case "${1}" in
            -h|--help|help)
                help_heading "Usage:" "idiot clean snaps [-n]"
                echo >&2
                help_heading "Options:"
                help_option "-n, --dry-run" "Print what would be removed without deleting"
                exit 0 ;;
            -n|--dry-run) dry_run=1 ;;
            *) die "unknown option: ${1}" ;;
        esac
        shift
    done

    require snap

    # Dangerously-installed snaps have sideloaded revisions (x<N>)
    snaps=$(snap list 2>/dev/null | awk 'NR>1 && $3 ~ /^x[0-9]+$/ {print $1}')
    [ -n "${snaps}" ] || { say "No unasserted snaps found."; exit 0; }

    printf '%s\n' "${snaps}" | while IFS= read -r name; do
        if [ "${dry_run}" -eq 1 ]; then
            say "${DIM}would remove${RESET} ${BOLD}${name}${RESET}"
        else
            say "Removing ${BOLD}${name}${RESET}..."
            snap remove "${name}" >/dev/null 2>&1
        fi
    done
}
main "$@"
