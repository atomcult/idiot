#!/usr/bin/env sh
# cmd/clean/snaps - remove all dangerously-installed (unasserted) snaps

. "$(dirname "${0}")/../../share/common.sh"
include clean.sh

main() {
	dry_run=0
	yes=0
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot clean snaps [-n] [-y]"
			echo >&2
			help_heading "Options:"
			help_option "-n, --dry-run" "Print what would be removed without deleting"
			help_option "-y, --yes" "Remove without asking for confirmation"
			exit 0
			;;
		-n | --dry-run) dry_run=1 ;;
		-y | --yes) yes=1 ;;
		*) die "unknown option: ${1}" ;;
		esac
		shift
	done

	require snap

	snaps="$(clean_list_snaps)"
	[ -n "${snaps}" ] || {
		say "No unasserted snaps found."
		exit 0
	}

	if [ "${dry_run}" -eq 1 ]; then
		clean_show "Would remove these sideloaded snaps:" "${snaps}"
		exit 0
	fi

	clean_show "These sideloaded snaps will be removed:" "${snaps}"
	[ "${yes}" -eq 1 ] || clean_confirm "Remove them?" || {
		say "Nothing removed."
		exit 0
	}
	clean_remove_snaps "${snaps}" ||
		die "some snaps could not be removed"
}
main "$@"
