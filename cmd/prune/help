#!/usr/bin/env sh
# cmd/prune/help - usage for the prune subcommand group

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    say "${BOLD}${BLUE}Usage:${RESET} idiot prune <subcommand>"
    echo >&2
    say "${BOLD}${BLUE}Subcommands:${RESET}"
    say "  ${CYAN}all${RESET}          Remove all snapcraft build containers and unasserted snaps"
    say "  ${CYAN}containers${RESET}   Remove all snapcraft build containers"
    say "  ${CYAN}snaps${RESET}        Remove all unasserted snaps"
}
main "$@"
