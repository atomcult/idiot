#!/usr/bin/env sh
# cmd/assertion/edit - edit a model, system-user or validation-set (a draft,
#   a signed one, or one fetched from the store)
# idiot: host
# shellcheck disable=SC2034,SC2154 # as_* and no_edit are shared with share/assertion.sh

. "$(dirname "${0}")/../../share/common.sh"
include arch.sh
include creds.sh
include models.sh
include assertion.sh

USAGE="usage: idiot assertion edit <file|-> [options]  or: idiot assertion edit <model|validation-set> <key> [options]"

usage() {
	help_heading "Usage:" "idiot assertion edit <file|-> [options]"
	say "       idiot assertion edit model <brand-id>/<model> [options]"
	say "       idiot assertion edit validation-set <account-id>/<name>[=<sequence>] [options]"
	echo >&2
	help_heading "Options:"
	help_option "--refresh" "Look every snap's ID (and type, or revision) up again"
	help_option "--snap <name>[=<channel>]" "Update a snap from that channel, or add it"
	help_option "--set <header>=<value>" "Give a header (never asked)"
	help_option "--add <header>=<value>" "Add to a list header"
	help_option "--arch <arch>" "Target architecture (default: the model's, else UBUNTU_STORE_ARCH or the host's)"
	help_option "--cred <name>" "Use this saved credential instead of the active one"
	help_option "--no-edit" "Don't open the draft in an editor"
	help_option "-o <file>" "Write here instead of back to <file.json> (- for stdout)"
	echo >&2
	say "Asks for the headers as idiot assertion new does, the assertion's values"
	say "as defaults, offers to raise a model's revision (or a validation set's"
	say "revision or sequence), and moves the timestamp on. Fields idiot doesn't"
	say "know (modes, components…) are kept as they are."
	echo >&2
	say "The input can be a JSON draft or a signed assertion (a .model, or a"
	say "stream such as idiot store assertion --chain --raw gives); with a type"
	say "and key it is fetched from the active store. A signed one is never"
	say "written to: its draft goes to <model>.json, <username>.json or"
	say "<name>-<sequence>.json here, or to -o. From stdin (-) nothing is asked."
}

_cleanup() {
	as_restore_tty
	[ -z "${work:-}" ] || rm -rf "${work:?}"
}

main() {
	file='' key=''
	refresh=0
	arch='' cred='' no_edit=0 out=''
	case "${1:-}" in
	'' | -h | --help | help)
		usage
		[ -n "${1:-}" ] || exit 2
		exit 0
		;;
	esac
	work="$(mktemp -d)" || die "can't create a temporary directory"
	trap _cleanup EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	trap 'exit 129' HUP
	as_init
	as_snaps_given=''
	# --set/--add are applied once the file is read, so they win
	: >"${work}/opts"
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			usage
			exit 0
			;;
		--refresh) refresh=1 ;;
		--set | --add)
			[ -n "${2:-}" ] || die "${1} needs <header>=<value>"
			printf '%s\t%s\n' "${1}" "${2}" >>"${work}/opts"
			shift
			;;
		--snap)
			[ -n "${2:-}" ] || die "--snap needs <name>[=<channel>]"
			as_snaps_given="${as_snaps_given}${2}
"
			shift
			;;
		--arch | --cred | -o)
			[ -n "${2:-}" ] || die "${1} needs a value"
			case "${1}" in
			--arch) arch="${2}" ;;
			--cred) cred="${2}" ;;
			-o) out="${2}" ;;
			esac
			shift
			;;
		--no-edit) no_edit=1 ;;
		-)
			[ -z "${file}" ] || die "${USAGE}"
			file=-
			;;
		-*) die "unknown option: ${1}" ;;
		*)
			if [ -z "${file}" ]; then
				file="${1}"
			elif [ -z "${key}" ]; then
				key="${1}"
			else
				die "${USAGE}"
			fi
			;;
		esac
		shift
	done
	[ -n "${file}" ] || die "${USAGE}"
	[ -z "${cred}" ] || {
		validate_cred_name "${cred}"
		require_cred "${cred}"
	}
	if [ -n "${key}" ]; then
		case "${file}" in
		model | validation-set) ;;
		*) die "unknown assertion type '${file}' to fetch (model or validation-set) — ${USAGE}" ;;
		esac
		as_source_fetch "${file}" "${key}"
	else
		as_source_file "${file}"
	fi
	as_source_read
	type="${as_src_type}"
	cat "${work}/source.records" >>"${as_rec}"
	# a signed source (or stdin) is never written back
	writeback=1
	if [ "${as_src_kind}" = signed ] || [ -n "${key}" ] || [ "${file}" = - ]; then
		writeback=0
	fi
	[ "${as_src_kind}" != signed ] || as_source_say
	[ "${type}" != system-user ] || umask 077
	while IFS="${AS_TAB}" read -r _o _v; do
		as_option "${_o}" "${_v}"
	done <"${work}/opts"
	as_arch=''
	if as_has architecture; then
		as_arch="$(as_get architecture)"
	fi
	as_arch="${arch:-${as_arch:-${UBUNTU_STORE_ARCH:-$(uname_to_snap_arch)}}}"
	[ "${as_tty}" -eq 0 ] || [ "${type}" = system-user ] || require fzf "install fzf for the snap pickers"

	as_mode=edit
	case "${type}" in
	model)
		as_model_headers
		as_model_snaps
		;;
	system-user) as_system_user_headers ;;
	validation-set)
		as_vs_headers
		as_vs_snaps
		;;
	esac
	if [ "${refresh}" -eq 1 ] && [ "${type}" != system-user ]; then
		as_snap_names >"${work}/names"
		while IFS= read -r _n; do
			printf '%s' "${as_snaps_given}" | sed 's/=.*//' | grep -qx -- "${_n}" && continue
			as_refresh_snap "${_n}" ''
		done <"${work}/names"
	fi

	as_build "${type}"
	if [ -n "${out}" ]; then
		as_write "${work}/draft.json" "${out}"
	elif [ "${writeback}" -eq 1 ]; then
		as_write "${work}/draft.json" "${file}" 1
	else
		as_write "${work}/draft.json" "$(as_default_name "${work}/draft.json")"
	fi
}
main "$@"
