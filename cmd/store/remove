#!/usr/bin/env sh
# cmd/store/remove - remove a saved store
# Usage: idiot store remove <name>

. "$(dirname "${0}")/../../share/common.sh"
# shellcheck source=share/stores.sh
. "$(dirname "${0}")/../../share/stores.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot store remove <name>"
		exit 0
		;;
	esac
	name="${1:-}"

	[ -n "${name}" ] || die "usage: idiot store remove <name>"

	mkdir -p "${IDIOT_STORES_DIR}"
	require_store "${name}"
	store_file="${IDIOT_STORES_DIR}/${name}"

	rm "${store_file}"
	say "Removed store '${BOLD}${name}${RESET}'"
}
main "$@"
