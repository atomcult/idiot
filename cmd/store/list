#!/usr/bin/env sh
# cmd/store/list - list saved stores and their IDs
# Usage: idiot store list

. "$(dirname "${0}")/../../lib/common.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot store list"
		exit 0
		;;
	esac
	mkdir -p "${IDIOT_STORES_DIR}"

	max_len=0
	for f in "${IDIOT_STORES_DIR}"/*; do
		[ -f "${f}" ] || continue
		name="$(basename "${f}")"
		len="${#name}"
		[ "${len}" -gt "${max_len}" ] && max_len="${len}"
	done

	[ "${max_len}" -ne 0 ] || {
		say "No stores saved yet (use 'idiot store add <name> <store-id>')"
		exit 0
	}

	say "Saved stores:"
	echo >&2
	for f in "${IDIOT_STORES_DIR}"/*; do
		[ -f "${f}" ] || continue
		name="$(basename "${f}")"
		store_id="$(cat "${f}")"
		padded="$(printf "%-${max_len}s" "${name}")"
		say "  ${BOLD}${padded}${RESET}  ${store_id}"
	done
}
main "$@"
