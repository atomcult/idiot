#!/usr/bin/env sh
# cmd/store/assertion - fetch an assertion from the store
# idiot: host
# Usage: idiot store assertion [--chain] [--raw | -o <file>] [--no-verify] [--arch <arch>] [--cred <name>] <type> [<key>...]

. "$(dirname "${0}")/../../share/common.sh"
include arch.sh
include creds.sh
include stores.sh

usage() {
	help_heading "Usage:" "idiot store assertion [options] <type> [<key>...]"
	echo >&2
	say "Fetches an assertion from the store and summarises it, as idiot inspect"
	say "assertion does; --raw prints it as served, -o saves it."
	echo >&2
	help_heading "Types:"
	help_option "account <id>" "An account"
	help_option "account-key <sha3-384>" "A signing key"
	help_option "store [<id>]" "A store (default: the active one)"
	help_option "model <brand>/<model>" "A model"
	help_option "snap-declaration <snap>" "A snap's declaration, by name"
	help_option "snap-revision <snap> <rev>" "A revision's assertion, by snap and revision"
	help_option "snap-revision <sha3-384>" "...or by its SHA3-384 (hex or base64url)"
	help_option "validation-set <acct>/<name>[=<seq>]" "A validation set (default: latest)"
	help_option "<type> <header>=<value>..." "Any type the store serves, by its primary key"
	echo >&2
	help_heading "Options:"
	help_option "--chain" "Also fetch what snapd needs to accept it (keys, declarations, accounts)"
	help_option "--raw" "Print the assertions as served (for snap ack /dev/stdin)"
	help_option "-o <file>" "Save the assertions to <file>"
	help_option "--no-verify" "Summarise without checking signatures"
	help_option "--arch <arch>" "For revision lookups (default: UBUNTU_STORE_ARCH, else the host's)"
	help_option "--cred <name>" "Use this saved credential instead of the active one"
}

main() {
	chain=0 raw=0 out='' noverify='' arch='' cred=''
	kind=''
	set_keys=0
	keys=''
	nl='
'
	while [ "$#" -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			usage
			exit 0
			;;
		--chain) chain=1 ;;
		--raw) raw=1 ;;
		--no-verify) noverify=--no-verify ;;
		-o | --arch | --cred)
			[ -n "${2:-}" ] || die "${1} needs a value"
			case "${1}" in
			-o) out="${2}" ;;
			--arch) arch="${2}" ;;
			--cred) cred="${2}" ;;
			esac
			shift
			;;
		-*) die "unknown option: ${1}" ;;
		*)
			if [ -z "${kind}" ]; then
				kind="${1}"
			else
				keys="${keys}${1}${nl}"
				set_keys=$((set_keys + 1))
			fi
			;;
		esac
		shift
	done
	[ -n "${kind}" ] || die "usage: idiot store assertion [options] <type> [<key>...]"
	[ "${raw}" -eq 0 ] || [ -z "${out}" ] || die "--raw and -o can't both be given"

	# the shortcuts, as header words; "header=value" words pass through
	k1="$(printf '%s' "${keys}" | sed -n 1p)"
	k2="$(printf '%s' "${keys}" | sed -n 2p)"
	case "${kind}:${k1}" in
	*:*=*) words="${keys}" ;;
	account:?*) words="account-id=${k1}" ;;
	account-key:?*) words="public-key-sha3-384=${k1}" ;;
	store:*)
		id="${k1:-${UBUNTU_STORE_ID:-}}"
		[ -n "${id}" ] || die "no store is active — name one: idiot store assertion store <store-id>"
		words="store=${id}"
		;;
	model:*/*) words="brand-id=${k1%%/*}${nl}model=${k1#*/}" ;;
	model:*) die "a model is fetched by <brand-id>/<model>, e.g. idiot store assertion model canonical/ubuntu-core-24-amd64" ;;
	snap-declaration:?*) words="snap-name=${k1}" ;;
	snap-revision:?*)
		if [ -n "${k2}" ]; then
			words="snap-name=${k1}${nl}snap-revision=${k2}"
		else
			words="snap-sha3-384=${k1}"
		fi
		;;
	validation-set:*/*)
		vs="${k1#*/}"
		words="account-id=${k1%%/*}${nl}name=${vs%%=*}"
		[ "${vs}" = "${vs%%=*}" ] || words="${words}${nl}sequence=${vs#*=}"
		;;
	validation-set:*) die "a validation set is fetched by <account-id>/<name>[=<sequence>]" ;;
	*) words="${keys}" ;;
	esac

	chainflag=''
	[ "${chain}" -eq 0 ] || chainflag=--chain
	query_cred "${cred}" || :
	helper="$(store_helper)" || exit 1
	arch="${arch:-${UBUNTU_STORE_ARCH:-$(uname_to_snap_arch)}}"
	work="$(mktemp -d)" || die "can't create a temporary directory"
	trap 'rm -rf "${work}"' EXIT INT TERM HUP

	set --
	while IFS= read -r w; do
		[ -z "${w}" ] || set -- "$@" "${w}"
	done <<EOF
${words}
EOF
	# shellcheck disable=SC2154 # query_file is set by query_cred (creds.sh)
	"${helper}" assertion ${query_file:+--file "${query_file}"} \
		${UBUNTU_STORE_ID:+--store "${UBUNTU_STORE_ID}"} --arch "${arch}" \
		${chainflag} "${kind}" "$@" >"${work}/stream" 2>"${work}/err"
	rc=$?
	if [ "${rc}" -ne 0 ]; then
		msg="$(sed 's/^idiot-store: //' "${work}/err")"
		case "${rc}" in
		4)
			case "${kind}:${k2}" in
			snap-declaration:* | snap-revision:?*)
				case "${msg}" in
				*"doesn't show"*" to this credential")
					die "${msg} — find out why: idiot store check ${k1}"
					;;
				esac
				;;
			esac
			die "${msg}"
			;;
		*) die "${msg:-idiot-store failed (exit ${rc})}" ;;
		esac
	fi
	n="$(grep -c '^type: ' "${work}/stream")"

	if [ "${raw}" -eq 1 ]; then
		cat "${work}/stream"
		exit 0
	fi
	if [ -n "${out}" ]; then
		dir="$(dirname "${out}")"
		tmp="$(mktemp "${dir}/.$(basename "${out}").XXXXXX")" || die "can't write in ${dir}"
		if ! { cat "${work}/stream" >"${tmp}" && mv "${tmp}" "${out}"; }; then
			rm -f "${tmp}"
			die "couldn't write ${out}"
		fi
		say "Wrote ${n} assertion$([ "${n}" -eq 1 ] || echo s) to ${out}"
		exit 0
	fi
	rc=0
	"${IDIOT_ROOT}/cmd/inspect/assertion" ${noverify} "${work}/stream" >"${work}/summary" || rc=$?
	cat "${work}/summary"
	if [ "${chain}" -eq 0 ] && grep -q '^signature: *unverified' "${work}/summary"; then
		say "${DIM}A signing key isn't known here: add --chain to fetch it too.${RESET}"
	fi
	exit "${rc}"
}
main "$@"
