#!/usr/bin/env sh
# cmd/store/snaps - the snaps in the active store
# idiot: host
# Usage: idiot store snaps [--tsv | --pick] [--cred <name>]

. "$(dirname "${0}")/../../share/common.sh"
include creds.sh
include stores.sh
include fzf.sh

usage() {
	help_heading "Usage:" "idiot store snaps [--tsv | --pick] [--cred <name>]"
	echo >&2
	say "Lists the snaps in the active store: all of them for a store admin"
	say "using a credential with store_admin, otherwise the ones you publish or"
	say "collaborate on there (and says why the list is partial)."
	echo >&2
	help_heading "Options:"
	help_option "--tsv" "Tab-separated: name, owner, private|public"
	help_option "--pick" "Pick one in fzf and print its name"
	help_option "--cred <name>" "Use this saved credential instead of the active one"
}

main() {
	mode=table
	cred=''
	while [ "$#" -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			usage
			exit 0
			;;
		--tsv) mode=tsv ;;
		--pick) mode=pick ;;
		--cred)
			[ -n "${2:-}" ] || die "--cred needs a credential name"
			cred="${2}"
			shift
			;;
		*) die "usage: idiot store snaps [--tsv | --pick] [--cred <name>]" ;;
		esac
		shift
	done
	[ "${mode}" != pick ] || require fzf
	query_cred "${cred}" ||
		die "no active credential — activate one first (idiot auth use), or use --cred <name>"
	store_snap_list
	[ -z "${store_snap_partial:-}" ] || store_partial_note "${store_snap_partial:-}" "store snaps"
	rows="$(printf '%s\n' "${store_snap_rows:-}" | cut -f1-3)"
	[ -n "${rows}" ] || {
		say "${DIM}No snaps to list.${RESET}"
		exit 0
	}
	case "${mode}" in
	tsv) printf '%s\n' "${rows}" ;;
	pick)
		printf '%s\n' "${rows}" | fzf --delimiter='	' --with-nth=1,2,3 --prompt='snap> ' | cut -f1
		;;
	*)
		stdout_colors
		printf '%s\n' "${rows}" | awk -F '\t' -v d="${OUT_DIM}" -v r="${OUT_RESET}" '
			{ if (length($1) > w1) w1 = length($1); if (length($2) > w2) w2 = length($2); row[NR] = $0 }
			END { for (n = 1; n <= NR; n++) { split(row[n], f, "\t"); printf "%-" w1 "s  %-" w2 "s  %s%s%s\n", f[1], f[2], d, f[3], r } }'
		;;
	esac
}
main "$@"
