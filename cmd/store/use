#!/usr/bin/env sh
# cmd/store/use - set UBUNTU_STORE_ID to the named store's ID
# Usage: idiot store use [<name>]
# Outputs: eval-able export statements (via the eval file)

. "$(dirname "${0}")/../../share/common.sh"
include creds.sh
include stores.sh
include fzf.sh

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot store use [<name>]"
		exit 0
		;;
	esac
	require_wrapper
	name="${1:-}"

	[ -n "${name}" ] || {
		name=$(fzf_pick_from_dir \
			"${IDIOT_STORES_DIR}" \
			"store> " \
			"no stores saved — use 'idiot store add' to add a store") || exit 0
	}

	mkdir -p "${IDIOT_STORES_DIR}"
	emit_store_use "${name}"
	warn_store_mismatch "${IDIOT_ACTIVE_CRED:-}" "$(store_id "${name}")"
}
main "$@"
