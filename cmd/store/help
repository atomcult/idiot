#!/usr/bin/env sh
# cmd/store/help - usage for the store subcommand group

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    say "${BOLD}${BLUE}Usage:${RESET} idiot store <subcommand>"
    echo >&2
    say "${BOLD}${BLUE}Subcommands:${RESET}"
    say "  ${CYAN}use${RESET}       Activate a store"
    say "  ${CYAN}unset${RESET}     Clear the active store"
    say "  ${CYAN}status${RESET}    Show the active store"
    echo >&2
    say "  ${CYAN}add${RESET}       Save a store"
    say "  ${CYAN}remove${RESET}    Remove a saved store"
    say "  ${CYAN}list${RESET}      List saved stores"
    echo >&2
    say "${BOLD}${BLUE}Environment:${RESET}"
    say "  ${BOLD}IDIOT_STORES_DIR${RESET}    Stores directory"
}
main "$@"
