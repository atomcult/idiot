#!/usr/bin/env sh
# cmd/arch/set - set the target architecture for store operations
# Usage: idiot arch set [<architecture>]
# Outputs: eval-able export statements (via the eval file)

. "$(dirname "${0}")/../../share/common.sh"
include arch.sh

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot arch set [<arch>]"
		exit 0
		;;
	esac
	require_wrapper
	arch="${1:-}"

	[ -n "${arch}" ] || {
		require fzf "install fzf for interactive selection"
		# shellcheck disable=SC2086 # one arch per word
		arch=$(printf '%s\n' ${STORE_ARCHES} | fzf --prompt="arch> ") || exit 0
	}

	is_store_arch "${arch}" ||
		die "invalid architecture: '${arch}' (valid: $(printf '%s' "${STORE_ARCHES}" | sed 's/ /, /g'))"
	emit_export UBUNTU_STORE_ARCH "${arch}"
}
main "$@"
