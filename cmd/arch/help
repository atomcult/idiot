#!/usr/bin/env sh
# cmd/arch/help - usage for the arch subcommand group

. "$(dirname "$0")/../../lib/common.sh"

say "Usage: idiot arch <subcommand>"
echo >&2
say "Subcommands:"
say "  set       Set the target architecture"
say "  unset     Clear the target architecture"
say "  status    Show the active architecture"
echo >&2
say "Environment:"
say "  UBUNTU_STORE_ARCH    Target architecture override"
