#!/usr/bin/env sh
# cmd/arch/unset - unset the target architecture
# Usage: idiot arch unset
# Outputs: eval-able unset statement

. "$(dirname "${0}")/../../lib/common.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot arch unset"
		exit 0
		;;
	esac
	emit_unset UBUNTU_STORE_ARCH
}
main "$@"
