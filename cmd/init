#!/usr/bin/env sh
# cmd/init - print shell integration code for the given shell
# Usage: idiot init <bash|zsh|fish>
#
# Installs a shell function named 'idiot' that runs the binary with
# IDIOT_EVAL_FILE pointing at a private temp file, then reads the file,
# deletes it and evaluates what it read, so env changes (and commands handed
# off to the host, see emit_handoff) take effect in the current shell.
# stdout and stderr pass through untouched.

. "$(dirname "${0}")/../share/common.sh"

# The command path baked into the user's shell must outlive upgrades: the
# snap's /snap/bin entry (never a path inside one revision, which goes away
# on refresh), else the installed launcher, else this checkout's script.
if [ -n "${SNAP:-}" ]; then
	IDIOT_BIN="/snap/bin/$(snap_instance)"
elif [ -n "${IDIOT_LAUNCHER:-}" ]; then
	IDIOT_BIN="${IDIOT_LAUNCHER}"
else
	IDIOT_BIN="$(cd "$(dirname "${0}")/.." && pwd)/idiot"
fi

bin_quoted="$(shell_quote "${IDIOT_BIN}")"

# Under the snap the eval file must be somewhere the confined command can
# write: the snap's per-user runtime directory. The host side gets the
# snap's location and state directories from these exports; PATH and
# LD_LIBRARY_PATH are never exported (bundled tools get them per process).
if [ -n "${SNAP:-}" ]; then
	snap_dir_word="snap.$(snap_instance)"
	sh_dir="\"\${XDG_RUNTIME_DIR:-/run/user/\$(id -u)}/${snap_dir_word}\""
	sh_mkdir="[ -d \"\$_idiot_d\" ] || mkdir -p -m 700 \"\$_idiot_d\" || return 1"
	fish_dir="set -l _dir /run/user/(id -u)/${snap_dir_word}
    set -q XDG_RUNTIME_DIR; and set _dir \$XDG_RUNTIME_DIR/${snap_dir_word}
    test -d \$_dir; or mkdir -p -m 700 \$_dir; or return 1"
	exports="IDIOT_SNAP=$(shell_quote "$(snap_current)")
IDIOT_DATA_HOME=$(shell_quote "${SNAP_USER_COMMON}")
IDIOT_CACHE_DIR=$(shell_quote "${SNAP_USER_COMMON}/cache")"
else
	sh_dir="\"\${XDG_RUNTIME_DIR:-\${TMPDIR:-/tmp}}\""
	sh_mkdir=":"
	fish_dir="set -l _dir /tmp
    set -q TMPDIR; and set _dir \$TMPDIR
    set -q XDG_RUNTIME_DIR; and set _dir \$XDG_RUNTIME_DIR"
	exports=""
fi

main() {
	shell="${1:-}"

	case "${shell}" in
	"" | -h | --help | help)
		help_heading "Usage:" "idiot init <shell>"
		echo >&2
		help_heading "Shells:"
		help_command "bash" "Bash shell integration"
		help_command "zsh" "Zsh shell integration"
		help_command "fish" "Fish shell integration"
		exit 0
		;;

	bash | zsh)
		cat <<EOF
# idiot shell integration for ${shell}
# Generated by: idiot init ${shell}
export IDIOT_SHELL=${shell}
EOF
		printf '%s\n' "${exports}" | while IFS= read -r _line; do
			[ -z "${_line}" ] || printf 'export %s\n' "${_line}"
		done
		cat <<EOF
idiot() {
    local _idiot_rc=0 _idiot_d _idiot_c
    [ -z "\${_idiot_ef:-}" ] || rm -f "\$_idiot_ef"
    _idiot_d=${sh_dir}
    ${sh_mkdir}
    _idiot_ef="\$(mktemp -p "\$_idiot_d" idiot.XXXXXX)" || return 1
    IDIOT_EVAL_FILE="\$_idiot_ef" ${bin_quoted} "\$@" || _idiot_rc=\$?
    _idiot_c="\$(cat "\$_idiot_ef")"
    rm -f "\$_idiot_ef"
    _idiot_ef=
    if [ "\$_idiot_rc" -ne 0 ]; then
        eval "\$_idiot_c"
        return \$_idiot_rc
    fi
    eval "\$_idiot_c"
}
iot() { idiot "\$@"; }
EOF
		;;

	fish)
		cat <<EOF
# idiot shell integration for fish
# Generated by: idiot init fish
set -gx IDIOT_SHELL fish
EOF
		printf '%s\n' "${exports}" | while IFS= read -r _line; do
			[ -z "${_line}" ] || printf 'set -gx %s %s\n' "${_line%%=*}" "${_line#*=}"
		done
		cat <<EOF
function idiot
    set -q _idiot_ef; and rm -f \$_idiot_ef
    ${fish_dir}
    set -g _idiot_ef (mktemp -p \$_dir idiot.XXXXXX); or return 1
    IDIOT_EVAL_FILE=\$_idiot_ef ${bin_quoted} \$argv
    set -l _idiot_rc \$status
    set -l _idiot_c (cat \$_idiot_ef | string collect)
    rm -f \$_idiot_ef
    set -e _idiot_ef
    if test \$_idiot_rc -ne 0
        eval \$_idiot_c
        return \$_idiot_rc
    end
    eval \$_idiot_c
end
function iot; idiot \$argv; end
EOF
		;;

	*)
		die "unsupported shell: ${shell} (supported: bash, zsh, fish)"
		;;
	esac
}
main "$@"
