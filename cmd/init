#!/usr/bin/env sh
# cmd/init - print shell integration code for the given shell
# Usage: idiot init <bash|zsh|fish>
#
# Installs a shell function named 'idiot' that wraps the binary and
# evals its output, so env changes take effect in the current shell.

IDIOT_BIN="$(cd "$(dirname "$0")/.." && pwd)/idiot"

shell="${1:-}"

case "$shell" in
    bash|zsh)
        cat <<EOF
# idiot shell integration for $shell
# Generated by: idiot init $shell
export IDIOT_SHELL=$shell
idiot() {
    local _idiot_out _idiot_rc
    _idiot_out="\$($IDIOT_BIN "\$@")" || _idiot_rc=\$?
    eval "\$_idiot_out"
    return \${_idiot_rc:-0}
}
EOF
        ;;

    fish)
        cat <<EOF
# idiot shell integration for fish
# Generated by: idiot init fish
set -gx IDIOT_SHELL fish
function idiot
    set -l _out ($IDIOT_BIN \$argv)
    set -l _rc \$status
    eval (string join \n -- \$_out)
    return \$_rc
end
EOF
        ;;

    "")
        printf 'printf "usage: idiot init <bash|zsh|fish>\\n" >&2\n'
        exit 1
        ;;

    *)
        printf 'printf "idiot: unsupported shell: %s\\n" >&2\n' "$shell"
        exit 1
        ;;
esac
