#!/usr/bin/env sh
# cmd/init - print shell integration code for the given shell
# Usage: idiot init <bash|zsh|fish>
#
# Installs a shell function named 'idiot' that runs the binary with
# IDIOT_EVAL_FILE pointing at a private temp file, then sources that file,
# so env changes take effect in the current shell. stdout and stderr pass
# through untouched.

. "$(dirname "${0}")/../share/common.sh"

# The command path baked into the user's shell must outlive upgrades: the
# snap's /snap/bin entry (never a path inside one revision, which goes away
# on refresh), else the installed launcher, else this checkout's script.
if [ -n "${SNAP:-}" ]; then
	IDIOT_BIN="/snap/bin/${SNAP_INSTANCE_NAME:-${SNAP_NAME:-idiot}}"
elif [ -n "${IDIOT_LAUNCHER:-}" ]; then
	IDIOT_BIN="${IDIOT_LAUNCHER}"
else
	IDIOT_BIN="$(cd "$(dirname "${0}")/.." && pwd)/idiot"
fi

bin_quoted="$(shell_quote "${IDIOT_BIN}")"

main() {
	shell="${1:-}"

	case "${shell}" in
	"" | -h | --help | help)
		help_heading "Usage:" "idiot init <shell>"
		echo >&2
		help_heading "Shells:"
		help_command "bash" "Bash shell integration"
		help_command "zsh" "Zsh shell integration"
		help_command "fish" "Fish shell integration"
		exit 0
		;;

	bash | zsh)
		cat <<EOF
# idiot shell integration for ${shell}
# Generated by: idiot init ${shell}
export IDIOT_SHELL=${shell}
idiot() {
    local _idiot_rc=0
    [ -z "\${_idiot_ef:-}" ] || rm -f "\$_idiot_ef"
    _idiot_ef="\$(mktemp -p "\${XDG_RUNTIME_DIR:-\${TMPDIR:-/tmp}}" idiot.XXXXXX)" ||
        return 1
    IDIOT_EVAL_FILE="\$_idiot_ef" ${bin_quoted} "\$@" || _idiot_rc=\$?
    . "\$_idiot_ef"
    rm -f "\$_idiot_ef"
    _idiot_ef=
    return \$_idiot_rc
}
iot() { idiot "\$@"; }
EOF
		;;

	fish)
		cat <<EOF
# idiot shell integration for fish
# Generated by: idiot init fish
set -gx IDIOT_SHELL fish
function idiot
    set -q _idiot_ef; and rm -f \$_idiot_ef
    set -l _dir /tmp
    set -q TMPDIR; and set _dir \$TMPDIR
    set -q XDG_RUNTIME_DIR; and set _dir \$XDG_RUNTIME_DIR
    set -g _idiot_ef (mktemp -p \$_dir idiot.XXXXXX); or return 1
    IDIOT_EVAL_FILE=\$_idiot_ef ${bin_quoted} \$argv
    set -l _rc \$status
    source \$_idiot_ef
    rm -f \$_idiot_ef
    set -e _idiot_ef
    return \$_rc
end
function iot; idiot \$argv; end
EOF
		;;

	*)
		die "unsupported shell: ${shell} (supported: bash, zsh, fish)"
		;;
	esac
}
main "$@"
