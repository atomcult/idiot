#!/usr/bin/env sh
# cmd/set - set an environment variable in the calling shell
# Usage: idiot set <VAR> <value>
# Outputs: eval-able shell code

. "$(dirname "$0")/../lib/common.sh"

var="${1:-}"
val="${2:-}"  # default to empty string; explicit empty is valid

if [ -z "$var" ]; then
    die "usage: idiot set <VAR> <value>"
fi

# Validate: VAR must be a legal identifier
case "$var" in
    [0-9]*|*[!A-Za-z0-9_]*)
        die "invalid variable name: $var"
        ;;
esac

state_track "$var"

# Output eval-able export statement
printf 'export %s=%s\n' "$var" "$(shell_quote "$val")"
