#!/usr/bin/env sh
# cmd/env/arch/unset - unset the target architecture
# Usage: idiot env arch unset
# Outputs: eval-able unset statement

. "$(dirname "${0}")/../../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot env arch unset"; exit 0 ;;
    esac
    printf 'unset UBUNTU_STORE_ARCH\n'
}
main "$@"
