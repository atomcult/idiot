#!/usr/bin/env sh
# cmd/env/arch/help - usage for the arch subcommand group

. "$(dirname "${0}")/../../../lib/common.sh"

main() {
    say "${BOLD}${BLUE}Usage:${RESET} idiot env arch <subcommand>"
    echo >&2
    say "${BOLD}${BLUE}Subcommands:${RESET}"
    say "  ${CYAN}set${RESET}       Set the target architecture"
    say "  ${CYAN}unset${RESET}     Clear the target architecture"
    say "  ${CYAN}status${RESET}    Show the active architecture"
    echo >&2
    say "${BOLD}${BLUE}Environment:${RESET}"
    say "  ${BOLD}UBUNTU_STORE_ARCH${RESET}    Target architecture override"
}
main "$@"
