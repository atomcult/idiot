#!/usr/bin/env sh
# cmd/env/arch/set - set the target architecture for store operations
# Usage: idiot env arch set [<architecture>]
# Outputs: eval-able export statement

. "$(dirname "${0}")/../../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot env arch set [<arch>]"; exit 0 ;;
    esac
    arch="${1:-}"

    [ -n "${arch}" ] || {
        command -v fzf > /dev/null 2>&1 || die "an architecture is required (fzf not found for interactive selection)"
        arch=$(printf 'amd64\narm64\narmhf\ni386\nppc64el\nriscv64\ns390x\n' | fzf --prompt="arch> ") || exit 0
    }

    case "${arch}" in
        amd64|arm64|armhf|i386|ppc64el|riscv64|s390x)
            printf 'export UBUNTU_STORE_ARCH=%s\n' "$(shell_quote "${arch}")"
            ;;
        *) die "invalid architecture: '${arch}' (valid: amd64, arm64, armhf, i386, ppc64el, riscv64, s390x)" ;;
    esac
}
main "$@"
