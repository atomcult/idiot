#!/usr/bin/env sh
# cmd/env/help - usage for the env subcommand group

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    help_heading "Usage:" "idiot env <subcommand> [args...]"
    echo >&2
    help_heading "Subcommands:"
    help_command "auth"  "Manage credentials"
    help_command "store" "Manage Dedicated Snap Stores"
    help_command "arch"  "Manage target architecture"
    echo >&2
    say "Run ${DIM}idiot env <subcommand> help${RESET} for subcommand details."
}
main "$@"
