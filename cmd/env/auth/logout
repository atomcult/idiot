#!/usr/bin/env sh
# cmd/env/auth/logout - unset store credential environment variables
# Usage: idiot env auth logout
# Outputs: eval-able unset statements

. "$(dirname "${0}")/../../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot env auth logout"; exit 0 ;;
    esac
    printf 'unset SNAPCRAFT_STORE_CREDENTIALS\n'
    printf 'unset UBUNTU_STORE_AUTH\n'
    printf 'unset IDIOT_ACTIVE_CRED\n'
}
main "$@"
