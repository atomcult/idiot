#!/usr/bin/env sh
# cmd/env/auth/add - create new credentials using snapcraft export-login
# Usage: idiot env auth add <name>

. "$(dirname "${0}")/../../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot env auth add <name>"; exit 0 ;;
    esac
    name="${1:-}"

    [ -n "${name}" ] || die "usage: idiot env auth add <name>"

    mkdir -p "${IDIOT_AUTH_DIR}"
    dest="${IDIOT_AUTH_DIR}/${name}"

    ! [ -f "${dest}" ] ||
        die "credentials '${name}' already exist (remove it first)"

    tmpfile="$(mktemp)"
    trap 'rm -f "${tmpfile}"' EXIT INT TERM

    snapcraft export-login "${tmpfile}" >&2 ||
        die "snapcraft export-login failed"

    mv "${tmpfile}" "${dest}"
    say "Added credentials '${BOLD}${name}${RESET}'"
}
main "$@"
