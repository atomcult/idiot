#!/usr/bin/env sh
# cmd/dev/help - usage for the dev subcommand group

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    say "${BOLD}${BLUE}Usage:${RESET} idiot dev <subcommand>"
    echo >&2
    say "${BOLD}${BLUE}Subcommands:${RESET}"
    say "  ${CYAN}purge${RESET}     Remove all LXD containers in the snapcraft project"
    say "  ${CYAN}clean${RESET}     Remove all dangerously-installed snaps"
    say "  ${CYAN}yaml${RESET}      Print the snapcraft.yaml or snap.yaml from a snap file"
}
main "$@"
