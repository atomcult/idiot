#!/usr/bin/env sh
# cmd/docs/list - list available reference docs
# Usage: idiot docs list

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot docs list"; exit 0 ;;
    esac

    docs_dir="${IDIOT_DATA_DIR}/docs"
    [ -d "${docs_dir}" ] || die "docs directory not found at ${docs_dir}"

    found=0
    for f in "${docs_dir}"/*; do
        [ -f "${f}" ] || continue
        found=1
        name="$(basename "${f}")"
        title="$(sed -n 's/^# //p' "${f}" | head -1)"
        gap=$(( 28 - ${#name} ))
        [ "${gap}" -lt 2 ] && gap=2
        say "  ${CYAN}${name}${RESET}$(printf '%*s' "${gap}" '')${title}"
    done

    [ "${found}" -eq 1 ] || say "${DIM}No docs found.${RESET}"
}
main "$@"
