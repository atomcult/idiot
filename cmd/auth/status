#!/usr/bin/env sh
# cmd/auth/status - show login status (account details from idiot-store)
# idiot: host
# Usage: idiot auth status [--refresh]

. "$(dirname "${0}")/../../share/common.sh"
include creds.sh

# Ask the store about the active credential: sets raw to idiot-store's
# `key: value` report, or exits with its status (2: rejected or expired),
# its error already on stderr. Nothing is cached on failure.
fetch_status() {
	helper="$(store_helper)" || exit 1
	rc=0
	raw="$(UBUNTU_STORE_AUTH="${SNAPCRAFT_STORE_CREDENTIALS}" "${helper}" whoami)" || rc=$?
	[ "${rc}" -eq 0 ] || exit "${rc}"
}

main() {
	refresh=0
	cached=0
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth status [--refresh | --cached]"
		echo >&2
		help_option "--refresh" "Bypass cache and fetch fresh status"
		help_option "--cached" "Show only cached status; never contact the store"
		exit 0
		;;
	--refresh) refresh=1 ;;
	--cached) cached=1 ;;
	esac
	[ -n "${SNAPCRAFT_STORE_CREDENTIALS:-}" ] || {
		say "${DIM}Not logged in${RESET}"
		exit 0
	}

	if [ -n "${IDIOT_ACTIVE_CRED:-}" ]; then
		whoami_cache="$(whoami_cache_path "${IDIOT_ACTIVE_CRED}")"

		[ "${refresh}" -eq 1 ] && rm -f "${whoami_cache}"

		if [ -f "${whoami_cache}" ]; then
			raw="$(cat "${whoami_cache}")"
		elif [ "${cached}" -eq 1 ]; then
			say "${DIM}Status not fetched yet — run: idiot auth status${RESET}"
			exit 0
		else
			fetch_status
			mkdir -p "$(dirname "${whoami_cache}")"
			printf '%s\n' "${raw}" >"${whoami_cache}"
		fi
	elif [ "${cached}" -eq 1 ]; then
		say "${DIM}Status not cached for an unnamed credential${RESET}"
		exit 0
	else
		fetch_status
	fi

	printf '%s\n' "${raw}" | while IFS= read -r line; do
		case "${line}" in
		'permissions: '*)
			val="${line#*: }"
			printf '%s\n' "${CYAN}permissions${RESET}:" >&2
			IFS=','
			for perm in ${val}; do
				perm="${perm# }"
				perm="${perm% }"
				printf '%s\n' "  ${DIM}-${RESET} $(map_permission "${perm}")" >&2
			done
			;;
		*:' '*)
			key="${line%%:*}"
			val="${line#*: }"
			printf '%s\n' "${CYAN}${key}${RESET}: ${val}" >&2
			;;
		*)
			printf '%s\n' "${line}" >&2
			;;
		esac
	done
}
main "$@"
