#!/usr/bin/env sh
# cmd/auth/remove - remove a credential file from IDIOT_AUTH_DIR
# Usage: idiot auth remove [<name>]

. "$(dirname "${0}")/../../lib/common.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth remove [<name>]"
		exit 0
		;;
	esac
	name="${1:-}"

	[ -n "${name}" ] || {
		require fzf "install fzf for interactive selection"

		mkdir -p "${IDIOT_AUTH_DIR}"

		files=$(find "${IDIOT_AUTH_DIR}" -maxdepth 1 -type f ! -name '.*' |
			sort | sed "s|${IDIOT_AUTH_DIR}/||")

		[ -n "${files}" ] || die "no credentials found"

		status_cmd="$(dirname "${0}")/status"
		export IDIOT_AUTH_DIR
		# shellcheck disable=SC2016
		preview_cmd='export FORCE_COLOR=1; export SNAPCRAFT_STORE_CREDENTIALS="$(cat "$IDIOT_AUTH_DIR/{}")"; export IDIOT_ACTIVE_CRED="{}"; '"${status_cmd}"' 2>&1'

		name=$(printf '%s\n' "${files}" |
			fzf \
				--prompt="remove auth> " \
				--preview="sh -c '${preview_cmd}'") || exit 0
	}

	cred_file="${IDIOT_AUTH_DIR}/${name}"

	[ -f "${cred_file}" ] || die "credentials '${name}' not found"

	rm "${cred_file}"
	rm -f "${IDIOT_CACHE_DIR}/whoami/${name}"
	say "Removed credentials '${BOLD}${name}${RESET}'"
}
main "$@"
