#!/usr/bin/env sh
# cmd/env/auth/remove - remove a credential file from IDIOT_AUTH_DIR
# Usage: idiot auth remove [<name>]

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot auth remove [<name>]"; exit 0 ;;
    esac
    name="${1:-}"

    [ -n "${name}" ] || {
        command -v fzf > /dev/null 2>&1 || die "a credential name is required (fzf not found for interactive selection)"

        mkdir -p "${IDIOT_AUTH_DIR}"

        files=$(find "${IDIOT_AUTH_DIR}" -maxdepth 1 -type f ! -name '.*' | sort | sed "s|${IDIOT_AUTH_DIR}/||")

        [ -n "${files}" ] || die "no credentials found"

        export IDIOT_AUTH_DIR
        preview_cmd="$(file_preview_cmd IDIOT_AUTH_DIR)"

        name=$(printf '%s\n' "${files}" | fzf --prompt="remove auth> " --preview="${preview_cmd}") || exit 0
    }

    cred_file="${IDIOT_AUTH_DIR}/${name}"

    [ -f "${cred_file}" ] || die "credentials '${name}' not found"

    rm "${cred_file}"
    rm -f "${IDIOT_CACHE_DIR}/whoami/${name}"
    say "Removed credentials '${BOLD}${name}${RESET}'"
}
main "$@"
