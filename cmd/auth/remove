#!/usr/bin/env sh
# cmd/auth/remove - remove a credential file from IDIOT_AUTH_DIR
# Usage: idiot auth remove [<name>]

. "$(dirname "${0}")/../../share/common.sh"
# shellcheck source=share/creds.sh
. "$(dirname "${0}")/../../share/creds.sh"
# shellcheck source=share/fzf.sh
. "$(dirname "${0}")/../../share/fzf.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth remove [<name>]"
		exit 0
		;;
	esac
	name="${1:-}"

	[ -n "${name}" ] || {
		status_cmd="$(dirname "${0}")/status"
		export IDIOT_AUTH_DIR
		# shellcheck disable=SC2016
		preview_cmd='export FORCE_COLOR=1; export SNAPCRAFT_STORE_CREDENTIALS="$(cat "$IDIOT_AUTH_DIR/{}")"; export IDIOT_ACTIVE_CRED="{}"; '"${status_cmd}"' 2>&1'
		name=$(fzf_pick_from_dir \
			"${IDIOT_AUTH_DIR}" \
			"remove auth> " \
			"no credentials found" \
			"sh -c '${preview_cmd}'") || exit 0
	}

	require_cred "${name}"
	cred_file="${IDIOT_AUTH_DIR}/${name}"

	rm "${cred_file}"
	rm -f "$(whoami_cache_path "${name}")"
	say "Removed credentials '${BOLD}${name}${RESET}'"
}
main "$@"
