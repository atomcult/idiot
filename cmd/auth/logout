#!/usr/bin/env sh
# cmd/auth/logout - unset store credential environment variables
# Usage: idiot auth logout
# Outputs: eval-able unset statements

. "$(dirname "${0}")/../../lib/common.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth logout"
		exit 0
		;;
	esac
	emit_unset SNAPCRAFT_STORE_CREDENTIALS
	emit_unset UBUNTU_STORE_AUTH
	emit_unset IDIOT_ACTIVE_CRED
}
main "$@"
