#!/usr/bin/env sh
# cmd/auth/logout - unset store credential environment variables
# Usage: idiot auth logout
# Outputs: eval-able unset statements (via the eval file)

. "$(dirname "${0}")/../../share/common.sh"
include creds.sh

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth logout"
		exit 0
		;;
	esac
	require_wrapper
	emit_cred_logout
}
main "$@"
