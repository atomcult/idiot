#!/usr/bin/env sh
# cmd/auth/help - usage for the creds subcommand group

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    say "${BOLD}${BLUE}Usage:${RESET} idiot auth <subcommand>"
    echo >&2
    say "${BOLD}${BLUE}Subcommands:${RESET}"
    say "  ${CYAN}login${RESET}     Activate a credential"
    say "  ${CYAN}logout${RESET}    Log out"
    say "  ${CYAN}status${RESET}    Show login status"
    echo >&2
    say "  ${CYAN}add${RESET}       Create a new credential"
    say "  ${CYAN}remove${RESET}    Remove a saved credential"
    say "  ${CYAN}list${RESET}      List saved credentials"
    say "  ${CYAN}import${RESET}    Import a credential from a file"
    say "  ${CYAN}export${RESET}    Output a credential"
    echo >&2
    say "${BOLD}${BLUE}Environment:${RESET}"
    say "  ${BOLD}IDIOT_AUTH_DIR${RESET}    Credentials directory"
}
main "$@"
