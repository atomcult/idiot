#!/usr/bin/env sh
# cmd/auth/help - usage for the auth subcommand group

. "$(dirname "${0}")/../../share/common.sh"

main() {
	help_heading "Usage:" "idiot auth <subcommand>"
	echo >&2
	help_heading "Subcommands:"
	help_command "use" "Activate a saved credential"
	help_command "unset" "Clear the active credential"
	help_command "status" "Show the active credential and its account"
	echo >&2
	help_command "add" "Log in to the Snap Store and save a credential"
	help_command "remove" "Remove a saved credential"
	help_command "list" "List saved credentials"
	help_command "import" "Import a credential from a file"
	help_command "bind" "Pair a credential with the active store (or any)"
	help_command "export" "Output a credential"
	echo >&2
	help_heading "Environment:"
	help_env "IDIOT_AUTH_DIR" "Credentials directory"
	help_env "IDIOT_CRED_WARN_DAYS" "Warn this many days before expiry (default 7)"
}
main "$@"
