#!/usr/bin/env sh
# cmd/auth/add - create new credentials using snapcraft export-login
# Usage: idiot auth add <name>

. "$(dirname "${0}")/../../lib/common.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth add <name>"
		exit 0
		;;
	esac
	name="${1:-}"

	[ -n "${name}" ] || die "usage: idiot auth add <name>"

	mkdir -p "${IDIOT_AUTH_DIR}"
	require_no_cred "${name}"
	dest="${IDIOT_AUTH_DIR}/${name}"

	tmpfile="$(mktemp)"
	trap 'rm -f "${tmpfile}"' EXIT INT TERM

	snapcraft export-login "${tmpfile}" >&2 ||
		die "snapcraft export-login failed"

	mv "${tmpfile}" "${dest}"
	say "Added credentials '${BOLD}${name}${RESET}'"
}
main "$@"
