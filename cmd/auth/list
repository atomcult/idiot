#!/usr/bin/env sh
# cmd/auth/list - list credential files in IDIOT_AUTH_DIR
# Usage: idiot auth list

. "$(dirname "${0}")/../../share/common.sh"
include creds.sh

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth list"
		exit 0
		;;
	esac
	[ -d "${IDIOT_AUTH_DIR}" ] ||
		exit 0

	now="$(date -u +%s)"
	width=0
	for f in "${IDIOT_AUTH_DIR}"/*; do
		[ -f "${f}" ] || continue
		n="${f##*/}"
		[ "${#n}" -le "${width}" ] || width="${#n}"
	done
	for f in "${IDIOT_AUTH_DIR}"/*; do
		[ -f "${f}" ] || continue
		n="${f##*/}"
		if exp="$(read_expiry "${n}")"; then
			ann="$(expiry_colour "${exp}" "${now}")$(expiry_phrase "${exp}" "${now}")${RESET}"
		else
			ann="${DIM}expiry unknown${RESET}"
		fi
		say "$(printf "%-${width}s" "${n}")  ${ann}"
	done
}
main "$@"
