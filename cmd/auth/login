#!/usr/bin/env sh
# cmd/auth/login - activate a saved credential (and say when it expires soon)
# Usage: idiot auth login [<name>]
# Outputs: eval-able export statements (via the eval file)

. "$(dirname "${0}")/../../share/common.sh"
include creds.sh
include stores.sh
include fzf.sh

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth login [<name>]"
		exit 0
		;;
	esac
	require_wrapper
	name="${1:-}"

	[ -n "${name}" ] || {
		status_cmd="$(dirname "${0}")/status"
		# confined in the snap, the preview can't reach the store
		[ -z "${SNAP:-}" ] || status_cmd="${status_cmd} --cached"
		export IDIOT_AUTH_DIR
		# shellcheck disable=SC2016
		preview_cmd='export FORCE_COLOR=1; export SNAPCRAFT_STORE_CREDENTIALS="$(cat "$IDIOT_AUTH_DIR/{}")"; export IDIOT_ACTIVE_CRED="{}"; '"${status_cmd}"' 2>&1'
		name=$(fzf_pick_from_dir \
			"${IDIOT_AUTH_DIR}" \
			"auth> " \
			"no credentials found" \
			"sh -c '${preview_cmd}'") || exit 0
	}

	require_cred "${name}"
	# a credential saved before idiot recorded expiries: read it now where
	# the helper can run (not confined in the snap: auth status does it)
	if ! exp="$(read_expiry "${name}")"; then
		exp=''
		if [ -z "${SNAP:-}" ]; then
			record_expiry "${name}" && exp="$(read_expiry "${name}")" || exp=''
		else
			say "${DIM}expiry unknown — run: idiot auth status${RESET}"
		fi
	fi

	emit_cred_login "${name}"
	warn_store_mismatch "${name}" "${UBUNTU_STORE_ID:-}"
	if [ -n "${exp}" ]; then
		now="$(date -u '+%s %Y-%m-%d')"
		! cred_expiry_notice "${name}" "${exp}" "${now%% *}" ||
			expiry_stamp "${now#* }" "${name}"
	fi
}
main "$@"
