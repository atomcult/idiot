#!/usr/bin/env sh
# cmd/auth/login - set store credential environment variables from a credential file
# Usage: idiot auth login [<name>]
# Outputs: eval-able export statements (via the eval file)

. "$(dirname "${0}")/../../share/common.sh"
include creds.sh
include fzf.sh

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot auth login [<name>]"
		exit 0
		;;
	esac
	require_wrapper
	name="${1:-}"

	[ -n "${name}" ] || {
		status_cmd="$(dirname "${0}")/status"
		# confined in the snap, the preview can't reach the store
		[ -z "${SNAP:-}" ] || status_cmd="${status_cmd} --cached"
		export IDIOT_AUTH_DIR
		# shellcheck disable=SC2016
		preview_cmd='export FORCE_COLOR=1; export SNAPCRAFT_STORE_CREDENTIALS="$(cat "$IDIOT_AUTH_DIR/{}")"; export IDIOT_ACTIVE_CRED="{}"; '"${status_cmd}"' 2>&1'
		name=$(fzf_pick_from_dir \
			"${IDIOT_AUTH_DIR}" \
			"auth> " \
			"no credentials found" \
			"sh -c '${preview_cmd}'") || exit 0
	}

	require_cred "${name}"
	cred_file="${IDIOT_AUTH_DIR}/${name}"
	contents="$(cat "${cred_file}")"
	emit_export UBUNTU_STORE_AUTH "${contents}"
	emit_export SNAPCRAFT_STORE_CREDENTIALS "${contents}"
	emit_export IDIOT_ACTIVE_CRED "${name}"
}
main "$@"
