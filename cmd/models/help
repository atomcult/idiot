#!/usr/bin/env sh
# cmd/models/help - usage for the models subcommand group

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    say "${BOLD}${CYAN}Usage:${RESET} idiot models <subcommand>"
    echo >&2
    say "${BOLD}${CYAN}Subcommands:${RESET}"
    say "  ${BOLD}pick${RESET}      Interactively select a model assertion"
    say "  ${BOLD}update${RESET}    Fetch the latest model assertions"
    echo >&2
    say "${BOLD}${CYAN}Environment:${RESET}"
    say "  ${BOLD}IDIOT_MODELS_DIR${RESET}    Models repository"
}
main "$@"
