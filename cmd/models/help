#!/usr/bin/env sh
# cmd/models/help - usage for the models subcommand group

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    say "${BOLD}${BLUE}Usage:${RESET} idiot models <subcommand>"
    echo >&2
    say "${BOLD}${BLUE}Subcommands:${RESET}"
    say "  ${CYAN}pick${RESET}      Interactively select a model assertion"
    say "  ${CYAN}update${RESET}    Fetch the latest model assertions"
    echo >&2
    say "${BOLD}${BLUE}Environment:${RESET}"
    say "  ${BOLD}IDIOT_MODELS_DIR${RESET}    Models repository"
}
main "$@"
