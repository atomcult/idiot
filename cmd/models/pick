#!/usr/bin/env sh
# cmd/models/pick - interactively select a model assertion and copy it
# Usage: idiot models pick [--signed|--unsigned] [-o <file>|-o -] [<dir>]
#
# Signed model assertions:   *.model
# Unsigned model assertions: *.json

. "$(dirname "$0")/../../lib/common.sh"

# ── argument parsing ───────────────────────────────────────────────────────────

filter=""
dest="."
output=""

while [ $# -gt 0 ]; do
    case "$1" in
        --signed)    filter="signed" ;;
        --unsigned)  filter="unsigned" ;;
        -o|--output)
            [ -z "${2:-}" ] && die "option '$1' requires an argument"
            output="$2"
            shift
            ;;
        -*)          die "unknown option: $1" ;;
        *)
            [ -n "$output" ] && die "cannot combine -o/--output with a destination directory"
            dest="$1"
            ;;
    esac
    shift
done

# ── preflight checks ───────────────────────────────────────────────────────────

if ! command -v fzf > /dev/null 2>&1; then
    die "fzf is required but not found (https://github.com/junegunn/fzf)"
fi

if [ ! -d "$IDIOT_MODELS_DIR/.git" ]; then
    die "models repository not found — run 'idiot models update' first"
fi

if [ -z "$output" ] && [ ! -d "$dest" ]; then
    die "destination directory does not exist: $dest"
fi

# ── find model files ───────────────────────────────────────────────────────────

files=$(
    find "$IDIOT_MODELS_DIR" -type f ! -path '*/.git/*' ! -name '.*' \
    | sort \
    | sed "s|$IDIOT_MODELS_DIR/||" \
    | case "$filter" in
        signed)   grep '\.model$' ;;
        unsigned) grep '\.json$' ;;
        *)        grep '\.\(model\|json\)$';;
      esac
)

if [ -z "$files" ]; then
    case "$filter" in
        signed)   die "no signed model assertions (*.model) found in $IDIOT_MODELS_DIR" ;;
        unsigned) die "no unsigned model assertions (*.json) found in $IDIOT_MODELS_DIR" ;;
        *)        die "no model assertions found in $IDIOT_MODELS_DIR" ;;
    esac
fi

# ── interactive selection ──────────────────────────────────────────────────────

case "$filter" in
    signed)   prompt="signed model> " ;;
    unsigned) prompt="unsigned model> " ;;
    *)        prompt="model> " ;;
esac

export IDIOT_MODELS_DIR
if command -v batcat > /dev/null 2>&1; then
    preview_cmd='batcat --style=plain --color=always "$IDIOT_MODELS_DIR/"{}'
else
    preview_cmd='command cat "$IDIOT_MODELS_DIR/"{}'
fi

selection=$(
    printf '%s\n' "$files" \
    | fzf --prompt="$prompt" \
          --preview="$preview_cmd"
) || exit 0  # fzf exits non-zero on cancel; treat as a no-op

# ── output ─────────────────────────────────────────────────────────────────────

src="$IDIOT_MODELS_DIR/$selection"

if [ "$output" = "-" ]; then
    cat "$src"
elif [ -n "$output" ]; then
    cp "$src" "$output"
    say "Saved '$selection' → '$output'"
else
    dest_file="$dest/$(basename "$selection")"
    cp "$src" "$dest_file"
    say "Copied '$selection' → '$dest_file'"
fi
