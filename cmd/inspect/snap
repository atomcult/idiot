#!/usr/bin/env sh
# cmd/inspect/snap - print snap/snapcraft.yaml or meta/snap.yaml from a snap file

. "$(dirname "${0}")/../../share/common.sh"

_show_yaml() {
	if command -v bat >/dev/null 2>&1; then
		bat --language yaml --paging=never "${1}" >&2
	else
		cat "${1}" >&2
	fi
}

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot inspect snap <snap-file>"
		exit 0
		;;
	esac

	[ $# -ge 1 ] || die "usage: idiot inspect snap <snap-file>"

	snap_file="${1}"
	[ -f "${snap_file}" ] || die "file not found: ${snap_file}"

	require unsquashfs

	_tmp=$(mktemp)
	trap 'rm -f "${_tmp}"' EXIT INT TERM

	if unsquashfs -q -cat "${snap_file}" snap/snapcraft.yaml >"${_tmp}" 2>/dev/null; then
		_show_yaml "${_tmp}"
		exit 0
	fi
	unsquashfs -q -cat "${snap_file}" meta/snap.yaml >"${_tmp}" 2>/dev/null ||
		die "neither snap/snapcraft.yaml nor meta/snap.yaml found in ${snap_file}"
	_show_yaml "${_tmp}"
}
main "$@"
