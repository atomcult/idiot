#!/usr/bin/env sh
# cmd/inspect/image - inspect an Ubuntu Core disk image

. "$(dirname "${0}")/../../share/common.sh"

# Outputs: start_sector size_sectors sector_size for a named GPT partition
partition_sectors() {
	sfdisk --json "${1}" 2>/dev/null | python3 -c "
import json, sys
pt = json.load(sys.stdin)['partitiontable']
ss = pt.get('sectorsize', 512)
for p in pt['partitions']:
    if p.get('name') == sys.argv[1]:
        print(p['start'], p['size'], ss)
        sys.exit(0)
sys.exit(1)
" "${2}"
}

# Checks whether the bytes at the given offset in a file are a LUKS header
is_luks() {
	python3 -c "
import sys
with open(sys.argv[1], 'rb') as f:
    f.seek(int(sys.argv[2]))
    sys.exit(0 if f.read(6) == b'LUKS\xba\xbe' else 1)
" "${1}" "${2}" 2>/dev/null
}

# Extracts brand-id/model from a model assertion
parse_model() {
	brand=$(printf '%s\n' "${1}" | awk '/^brand-id:/{print $2; exit}')
	name=$(printf '%s\n' "${1}" | awk '/^model:/{print $2; exit}')
	[ -n "${brand}" ] && [ -n "${name}" ] && printf '%s/%s' "${brand}" "${name}"
}

# Sets global: seed_offset
find_seed_offset() {
	pinfo=$(partition_sectors "${image}" ubuntu-seed) ||
		die "ubuntu-seed partition not found — is this an Ubuntu Core image?"
	seed_start=$(printf '%s\n' "${pinfo}" | awk '{print $1}')
	seed_ss=$(printf '%s\n' "${pinfo}" | awk '{print $3}')
	seed_offset=$((seed_start * seed_ss))
}

# Sets globals: assertion, model
read_model_assertion() {
	label=$(mdir -b -i "${image}@@${seed_offset}" '::/systems' 2>/dev/null |
		head -1 | sed 's|.*/\(.*\)/$|\1|; s|\r||')
	assertion=$(mcopy -i "${image}@@${seed_offset}" \
		"::/systems/${label}/model" - 2>/dev/null)
	model=$(parse_model "${assertion}")
}

# Sets globals: first_boot, preseeded; extracts state.json to tmpdir
inspect_ubuntu_data() {
	first_boot="not yet complete"
	preseeded="no"

	data_pinfo=$(partition_sectors "${image}" ubuntu-data) || return 0
	data_start=$(printf '%s\n' "${data_pinfo}" | awk '{print $1}')
	data_ss=$(printf '%s\n' "${data_pinfo}" | awk '{print $3}')
	data_offset=$((data_start * data_ss))

	if is_luks "${image}" "${data_offset}"; then
		first_boot="${GREEN}encrypted${RESET}"
		return 0
	fi

	modeenv=$(debugfs -R 'cat /system-data/var/lib/snapd/modeenv' \
		"${image}?offset=${data_offset}" 2>/dev/null)
	mode=$(printf '%s\n' "${modeenv}" | awk -F= '/^mode=/{print $2; exit}')

	if [ "${mode}" = "run" ]; then
		first_boot="${GREEN}complete${RESET}"
	elif [ -n "${mode}" ]; then
		first_boot="not yet complete ${DIM}(mode: ${mode})${RESET}"
	fi

	debugfs -R "dump /system-data/var/lib/snapd/state.json ${tmpdir}/state.json" \
		"${image}?offset=${data_offset}" 2>/dev/null
	[ -s "${tmpdir}/state.json" ] &&
		preseeded=$(python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f).get('data', {})
print('yes' if data.get('preseed') else 'no')
" "${tmpdir}/state.json" 2>/dev/null)
}

# Writes tmpdir/seeded: one "name revision" per line
collect_seeded_snaps() {
	mdir -b -i "${image}@@${seed_offset}" '::/snaps' 2>/dev/null |
		sed 's|.*/||; s|\r||' | tr '[:upper:]' '[:lower:]' |
		while IFS= read -r f; do
			case "${f}" in
			*.snap)
				b="${f%.snap}"
				printf '%s %s\n' "${b%_*}" "${b##*_}"
				;;
			esac
		done >"${tmpdir}/seeded"
}

# Writes tmpdir/channels and tmpdir/absent_optional from model assertion
parse_assertion_snaps() {
	printf '%s\n' "${assertion}" | awk -v d="${tmpdir}" '
        /^snaps:/           { in_snaps=1; next }
        in_snaps && /^[^ ]/ { in_snaps=0 }
        in_snaps && /^  -/  {
            if (name) {
                print name " " channel > (d "/channels")
                if (presence == "optional") print name > (d "/optional_names")
            }
            name=""; channel=""; presence=""
        }
        in_snaps && /name:/            { name=$2 }
        in_snaps && /default-channel:/ { channel=$2 }
        in_snaps && /presence:/        { presence=$2 }
        END {
            if (name) {
                print name " " channel > (d "/channels")
                if (presence == "optional") print name > (d "/optional_names")
            }
        }
    '
	[ -f "${tmpdir}/optional_names" ] &&
		while IFS= read -r name; do
			grep -q "^${name} " "${tmpdir}/seeded" ||
				printf '%s\n' "${name}" >>"${tmpdir}/absent_optional"
		done <"${tmpdir}/optional_names"
}

# Prints the seeded snaps listing with aligned name/revision/channel columns
print_seeded_snaps() {
	max_len=$(cat "${tmpdir}/seeded" "${tmpdir}/absent_optional" 2>/dev/null |
		awk '{if (length($1) > m) m=length($1)} END {print m+0}')
	max_rev=$(awk '{if (length($2) > m) m=length($2)} END {print m+0}' \
		"${tmpdir}/seeded" 2>/dev/null)
	max_rev="${max_rev:-0}"
	[ -f "${tmpdir}/absent_optional" ] && [ "${max_rev}" -lt 10 ] && max_rev=10

	say "${BOLD}Seeded snaps:${RESET}"
	while IFS=' ' read -r name rev; do
		name_pad=$((max_len - ${#name}))
		rev_pad=$((max_rev - ${#rev}))
		chan=$(awk -v n="${name}" '$1==n{print $2; exit}' "${tmpdir}/channels" 2>/dev/null)
		say "  ${CYAN}${name}${RESET}$(printf '%*s' "${name_pad}" '')  ${DIM}${rev}$(printf '%*s' "${rev_pad}" '')${chan:+  ${chan}}${RESET}"
	done <"${tmpdir}/seeded"
	[ -f "${tmpdir}/absent_optional" ] &&
		while IFS= read -r name; do
			name_pad=$((max_len - ${#name}))
			not_seeded_pad=$((max_rev - 10))
			chan=$(awk -v n="${name}" '$1==n{print $2; exit}' "${tmpdir}/channels" 2>/dev/null)
			say "  ${CYAN}${name}${RESET}$(printf '%*s' "${name_pad}" '')  ${YELLOW}not seeded${RESET}$(printf '%*s' "${not_seeded_pad}" '')${chan:+  ${DIM}${chan}${RESET}}"
		done <"${tmpdir}/absent_optional"
}

# Prints installed snaps from state.json
print_installed_snaps() {
	say "${BOLD}Installed snaps:${RESET}"
	CYAN="${CYAN}" DIM="${DIM}" RESET="${RESET}" python3 - "${tmpdir}/state.json" >&2 <<'PYEOF'
import json, os, sys
C = os.environ.get("CYAN", "")
D = os.environ.get("DIM", "")
R = os.environ.get("RESET", "")
with open(sys.argv[1]) as f:
    snaps = json.load(f).get("data", {}).get("snaps", {})
if not snaps:
    print("  (none)")
    sys.exit(0)
max_name = max(len(n) for n in snaps)
max_rev  = max(len(str(v.get("current", ""))) for v in snaps.values())
for name in sorted(snaps):
    s    = snaps[name]
    rev  = str(s.get("current", "?"))
    chan = s.get("tracking-channel") or s.get("channel", "")
    suffix = f"  {chan}" if chan else ""
    print(f"  {C}{name:<{max_name}}{R}  {D}{rev:>{max_rev}}{suffix}{R}")
PYEOF
}

# Prints interface connections from state.json
print_connections() {
	say "${BOLD}Connections:${RESET}"
	CYAN="${CYAN}" DIM="${DIM}" RESET="${RESET}" python3 - "${tmpdir}/state.json" >&2 <<'PYEOF'
import json, os, sys
C = os.environ.get("CYAN", "")
D = os.environ.get("DIM", "")
R = os.environ.get("RESET", "")
with open(sys.argv[1]) as f:
    conns = json.load(f).get("data", {}).get("conns", {})
if not conns:
    print("  (none)")
    sys.exit(0)
def fmt_side(side):
    snap, _, iface = side.partition(":")
    return f"{C}{snap}{R}{D}:{iface}{R}"
pairs = [(k.split(" ", 1)[0], k.split(" ", 1)[1]) for k in sorted(conns)]
max_plug = max(len(plug) for plug, _ in pairs)
for plug_side, slot_side in pairs:
    pad = max_plug - len(plug_side)
    print(f"  {fmt_side(plug_side)}{' ' * pad}  {D}→{R}  {fmt_side(slot_side)}")
PYEOF
}

# Prints snap changes from state.json
print_changes() {
	say "${BOLD}Changes:${RESET}"
	DIM="${DIM}" RESET="${RESET}" GREEN="${GREEN}" YELLOW="${YELLOW}" RED="${RED}" \
		python3 - "${tmpdir}/state.json" >&2 <<'PYEOF'
import json, os, sys
D  = os.environ.get("DIM", "")
R  = os.environ.get("RESET", "")
GR = os.environ.get("GREEN", "")
YE = os.environ.get("YELLOW", "")
RE = os.environ.get("RED", "")
STATUS = {0: "Hold", 1: "Do", 2: "Doing", 3: "Done", 4: "Abort",
          5: "Undo", 6: "Undoing", 7: "Undone", 8: "Wait", 9: "Error"}
STATUS_COLOR = {3: GR, 9: RE}
with open(sys.argv[1]) as f:
    state   = json.load(f)
changes = state.get("changes", {})
tasks   = state.get("tasks", {})
if not changes:
    print("  (none)")
    sys.exit(0)
rows = []
for cid in sorted(changes, key=lambda x: int(x)):
    c      = changes[cid]
    code   = c.get("status", -1)
    status = STATUS.get(code, str(code))
    sc     = STATUS_COLOR.get(code, YE)
    ts     = c.get("ready-time") or c.get("spawn-time") or ""
    ts     = ts[:19].replace("T", " ") if ts else ""
    rows.append((cid, status, sc, ts, c.get("summary", ""), code, c.get("task-ids", [])))
max_id = max(len(r[0]) for r in rows)
max_st = max(len(r[1]) for r in rows)
max_ts = max(len(r[3]) for r in rows)
for cid, status, sc, ts, summary, code, task_ids in rows:
    print(f"  {D}{cid:>{max_id}}{R}  {sc}{status:<{max_st}}{R}  {D}{ts:<{max_ts}}{R}  {summary}")
    if code == 9:
        for tid in task_ids:
            task = tasks.get(str(tid), {})
            for line in task.get("log", []):
                parts = line.split(" ", 2)
                if len(parts) >= 3 and parts[1] == "ERROR":
                    print(f"       {' ' * max_id}  {' ' * max_st}  {' ' * max_ts}  {RE}↳ {parts[2]}{R}")
PYEOF
}

main() {
	extract_state=''

	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot inspect image [options] <disk.img>"
			echo >&2
			help_heading "Options:"
			help_option "--extract-state [<file>]" "Save state.json (default: ./state.json)"
			exit 0
			;;
		--extract-state)
			if [ -n "${2:-}" ] && [ "${2#-}" = "${2}" ]; then
				extract_state="${2}"
				shift
			else
				extract_state="state.json"
			fi
			shift
			;;
		--extract-state=*)
			extract_state="${1#--extract-state=}"
			shift
			;;
		--*)
			die "unknown option: ${1}"
			;;
		*)
			break
			;;
		esac
	done

	[ $# -eq 1 ] || die "usage: idiot inspect image [options] <disk.img>"
	image="${1}"
	[ -f "${image}" ] || die "image not found: ${image}"

	require sfdisk
	require python3
	require debugfs "install e2fsprogs"
	require mcopy "install mtools"

	tmpdir=$(mktemp -d)
	trap 'rm -rf "${tmpdir}"' EXIT INT TERM HUP

	find_seed_offset
	read_model_assertion
	inspect_ubuntu_data
	collect_seeded_snaps
	parse_assertion_snaps

	say "${BOLD}Model:${RESET}       ${model:-${YELLOW}unknown${RESET}}"
	say "${BOLD}Pre-seeded:${RESET}  ${preseeded}"
	say "${BOLD}First boot:${RESET}  ${first_boot}"
	echo >&2
	print_seeded_snaps

	[ -s "${tmpdir}/state.json" ] || return 0

	echo >&2
	print_installed_snaps
	echo >&2
	print_connections
	echo >&2
	print_changes

	if [ -n "${extract_state}" ]; then
		cp "${tmpdir}/state.json" "${extract_state}"
		say ""
		say "State saved to ${BOLD}${extract_state}${RESET}"
	fi
}
main "$@"
