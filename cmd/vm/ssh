#!/usr/bin/env sh
# cmd/vm/ssh - SSH into the running VM

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    port=8022

    while [ $# -gt 0 ]; do
        case "${1}" in
            -h|--help|help)
                help_heading "Usage:" "idiot vm ssh [--port <port>] [ssh-args...]"
                echo >&2
                help_heading "Options:"
                help_option "--port <port>" "SSH port on the host (default: 8022)"
                exit 0 ;;
            --) shift; break ;;
            --port)
                [ -n "${2:-}" ] || die "--port requires an argument"
                port="${2}"; shift ;;
            -*) die "unknown option: ${1}" ;;
            *) break ;;
        esac
        shift
    done

    exec ssh \
        -p "${port}" \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        localhost "$@" >&2
}
main "$@"
