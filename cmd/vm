#!/usr/bin/env sh
# cmd/vm - launch and connect to a QEMU VM
# idiot: host

. "$(dirname "${0}")/../share/common.sh"
include aliases.sh
include arch.sh
include creds.sh
include lp.sh
include stores.sh
include vm-firmware.sh
include vm.sh

# Return the first path from the argument list that exists as a regular file
find_first() {
	for p in "$@"; do
		[ -f "${p}" ] && {
			printf '%s' "${p}"
			return 0
		}
	done
	return 1
}

# Sets fw_code and fw_vars_template for arch $1, with secure boot when $2 is
# 1, from share/vm-firmware.sh's table. The host's qemu boots the host's
# firmware, or the vm component's when the host has none; the component's
# qemu boots only the component's.
setup_firmware() {
	_sf_pkg="$(vm_firmware_package "${1}")" ||
		die "UEFI firmware is not supported for architecture: ${1}"
	[ "${2}" -eq 0 ] || vm_firmware_secboot "${1}" ||
		say "${DIM}No secure boot firmware exists for ${1}: booting without secure boot.${RESET}"
	fw_code="$(vm_find_firmware "${1}" "${2}" code)" ||
		_no_firmware "${1}" "${2}" "${_sf_pkg}"
	fw_vars_template="$(vm_find_firmware "${1}" "${2}" vars)" ||
		_no_firmware "${1}" "${2}" "${_sf_pkg}"
}

# Die because arch $1's firmware (secure boot $2, package $3) is missing.
_no_firmware() {
	_nf_what='UEFI firmware'
	[ "${2}" -eq 0 ] || ! vm_firmware_secboot "${1}" || _nf_what='UEFI secure boot firmware'
	if [ -n "${qemu_comp}" ]; then
		die "${_nf_what} for ${1} is missing from the vm component — reinstall it: snap install $(snap_instance)+vm"
	elif [ -n "$(snap_root)" ]; then
		die "${_nf_what} not found — install the ${3} package, or: snap install $(snap_instance)+vm"
	else
		die "${_nf_what} not found — install the ${3} package"
	fi
}

# TPM passthrough device type differs between x86 (ISA bus) and everything else
tpm_device_for_arch() {
	case "${1}" in
	amd64 | i386) printf 'tpm-tis' ;;
	*) printf 'tpm-tis-device' ;;
	esac
}

# Sets port for ssh/scp: --port as given, else the recorded ssh port of
# VM $name (or of the only running VM).
_vm_port() {
	[ -z "${port}" ] || return 0
	name="$(vm_resolve "${name}")" || exit 1
	vm_running "${name}" || die "VM '${name}' is not running — boot it: idiot vm boot --name ${name}"
	port="$(vm_conf_get "${name}" ssh_port)"
}

do_ssh() {
	port=''
	name=''

	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm ssh [--name <name> | --port <port>] [ssh-args...]"
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM to connect to (default: the running one)"
			help_option "--port <port>" "Connect to this host port instead"
			echo >&2
			say "The Launchpad username is used as the SSH user."
			say "Set it with: ${CYAN}eval \"\$(idiot lp set <username>)\"${RESET}"
			exit 0
			;;
		--)
			shift
			break
			;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		--port)
			[ -n "${2:-}" ] || die "--port requires an argument"
			port="${2}"
			shift
			;;
		-*) die "unknown option: ${1}" ;;
		*) break ;;
		esac
		shift
	done

	lp_user="$(require_lp_user)" || exit 1
	_vm_port

	vm_ssh_raw "${port}" "${lp_user}" "$@" >&2
}

do_scp() {
	port=''
	name=''

	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm scp [--name <name> | --port <port>] <src> <dst>"
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM to copy to/from (default: the running one)"
			help_option "--port <port>" "Connect to this host port instead"
			echo >&2
			say "Use ${BOLD}vm:${RESET} as an alias for the guest host. The Launchpad username"
			say "is used as the SSH user (set with ${CYAN}idiot lp set${RESET})."
			echo >&2
			help_heading "Examples:"
			say "  ${CYAN}idiot vm scp${RESET} ./gadget.snap ${BOLD}vm${RESET}:/home/user/"
			say "  ${CYAN}idiot vm scp${RESET} ${BOLD}vm${RESET}:/var/log/syslog ."
			exit 0
			;;
		--)
			shift
			break
			;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		--port)
			[ -n "${2:-}" ] || die "--port requires an argument"
			port="${2}"
			shift
			;;
		-*) die "unknown option: ${1}" ;;
		*) break ;;
		esac
		shift
	done

	[ $# -ge 2 ] || die "usage: idiot vm scp [--name <name> | --port <port>] <src> <dst>"

	lp_user="$(require_lp_user)" || exit 1
	_vm_port

	# Rewrite vm: → localhost: in all path arguments
	_orig=$#
	for _arg in "$@"; do
		case "${_arg}" in
		vm:*) set -- "$@" "localhost:${_arg#vm:}" ;;
		*) set -- "$@" "${_arg}" ;;
		esac
	done
	shift "${_orig}"

	vm_scp "${port}" "${lp_user}" "$@" >&2
}

# Sets state_dir and vm_name from vars/tpm arguments $1 $2: --name <name>
# or a state directory; with $3 = any, none means the only running VM.
# $4: the subcommand, for the usage message.
_state_dir_arg() {
	state_dir=''
	_sda_name=''
	case "${1:-}" in
	--name)
		[ -n "${2:-}" ] || die "--name requires an argument"
		_sda_name="$(vm_resolve "${2}")" || exit 1
		;;
	--name=*)
		_sda_name="$(vm_resolve "${1#--name=}")" || exit 1
		;;
	-*) die "unknown option: ${1}" ;;
	'') ;;
	*) state_dir="${1}" ;;
	esac
	if [ -z "${state_dir}" ] && [ -z "${_sda_name}" ]; then
		[ "${3:-}" = any ] || die "usage: idiot vm ${4} --name <name> | <state-dir>"
		_sda_name="$(vm_resolve)" || exit 1
	fi
	[ -z "${_sda_name}" ] || state_dir="$(vm_dir "${_sda_name}")"
	vm_name="${_sda_name}"
}

do_vars() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot vm vars [--name <name> | <state-dir>]"
		echo >&2
		say "Lists the UEFI variables saved in a VM's state (fw_vars.fd), with the"
		say "certificates and hashes enrolled in PK, KEK, db and dbx. Without a"
		say "name or directory: the running VM's."
		exit 0
		;;
	esac

	_state_dir_arg "${1:-}" "${2:-}" any vars
	[ -d "${state_dir}" ] || die "state directory not found: ${state_dir}"

	vars_file="${state_dir}/fw_vars.fd"
	[ -f "${vars_file}" ] || die "no fw_vars.fd in ${state_dir} — was the VM booted with UEFI firmware?"

	# efi-readvar can't read a file (only the running machine's variables),
	# so idiot reads the store itself; the listing is data, on stdout
	helper="$(helper idiot-helper)" || exit 1
	"${helper}" uefi-vars "${vars_file}"
}

do_tpm() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot vm tpm --name <name> | <state-dir>"
		echo >&2
		say "Starts an swtpm instance against a stopped VM's TPM state for offline"
		say "inspection with tpm2-tools. Runs until interrupted."
		echo >&2
		say "Example:"
		say "  ${DIM}# in one terminal:${RESET}"
		say "  ${CYAN}idiot vm tpm${RESET} --name gadget"
		say "  ${DIM}# in another:${RESET}"
		say "  ${CYAN}tpm2_pcrread${RESET} --tcti=swtpm:path=${IDIOT_VM_DIR}/gadget/inspect.sock"
		exit 0
		;;
	esac

	_state_dir_arg "${1:-}" "${2:-}" '' tpm
	[ -d "${state_dir}" ] || die "state directory not found: ${state_dir}"
	# a running VM's swtpm holds the state
	[ -z "${vm_name}" ] || ! vm_running "${vm_name}" ||
		die "VM '${vm_name}' is running, and its swtpm holds the TPM state — stop it first: idiot vm stop ${vm_name}"

	# Check for existing TPM state files
	found=0
	for f in "${state_dir}"/tpm2-*.permall "${state_dir}"/tpm2-*.volatile; do
		[ -f "${f}" ] && {
			found=1
			break
		}
	done
	[ "${found}" -eq 1 ] || die "no TPM state found in ${state_dir} — was the VM booted with --tpm?"

	require swtpm "install the swtpm package"

	# tpm2-tools' swtpm TCTI talks to a data socket at path= and a control
	# socket next to it, path.ctrl
	sock="${state_dir}/inspect.sock"
	[ "${#sock}" -le 102 ] ||
		die "the state directory is too long a path for swtpm's sockets: ${state_dir}"
	rm -f "${sock}" "${sock}.ctrl"

	say "Starting swtpm on ${BOLD}${sock}${RESET} ${DIM}(Ctrl-C to stop)${RESET}"
	say "Connect with: ${CYAN}--tcti=swtpm:path=${sock}${RESET}"
	echo >&2

	swtpm socket \
		--tpmstate "dir=${state_dir}" \
		--server "type=unixio,path=${sock}" \
		--ctrl "type=unixio,path=${sock}.ctrl" \
		--tpm2 \
		--flags not-need-init,startup-clear
}

# Sets machine_flags and kvm_flags for the active arch.
_build_machine_flags() {
	case "${arch}" in
	amd64 | i386)
		machine_flags='-machine q35 -global ICH9-LPC.disable_s3=1'
		;;
	arm64 | armhf | riscv64)
		machine_flags='-machine virt'
		;;
	*)
		machine_flags=''
		;;
	esac

	# Without KVM, emulate the most capable CPU: QEMU's default for arm64
	# virt is the 32-bit cortex-a15, which cannot boot a 64-bit guest.
	if [ "${arch}" = "$(uname_to_snap_arch)" ] && [ -e /dev/kvm ]; then
		kvm_flags='-enable-kvm -cpu host'
	else
		kvm_flags='-cpu max'
	fi
}

# Stops the VM's swtpm (if started), unless a detached qemu runs on with
# it (swtpm's --terminate ends it with qemu).
_cleanup() {
	[ "${detached:-0}" -eq 0 ] || return 0
	[ -z "${tpm_pidfile:-}" ] || vm_swtpm_stop "${tpm_pidfile%/*}"
}

# Uses the VM's state directory for its firmware, TPM and disk state.
# Sets workdir and installs the cleanup trap.
_setup_workdir() {
	workdir="$(vm_dir "${name}")"
	trap _cleanup EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	trap 'exit 129' HUP
}

# Makes the VM's name refer to --state-dir $state_dir: a symlink from its
# place under IDIOT_VM_DIR. Dies when the name already refers elsewhere.
_link_state_dir() {
	mkdir -p "${state_dir}" || die "cannot create state directory: ${state_dir}"
	_lsd_abs="$(cd "${state_dir}" && pwd)"
	_lsd_link="$(vm_dir "${name}")"
	if [ -L "${_lsd_link}" ]; then
		[ "$(readlink "${_lsd_link}")" = "${_lsd_abs}" ] ||
			die "VM '${name}' keeps its state in $(readlink "${_lsd_link}") — use that --state-dir, or start over: idiot vm delete ${name}"
	elif [ -e "${_lsd_link}" ]; then
		die "VM '${name}' keeps its state in ${_lsd_link} — use another --name, or start over: idiot vm delete ${name}"
	else
		mkdir -p "${IDIOT_VM_DIR}"
		ln -s "${_lsd_abs}" "${_lsd_link}"
	fi
}

# Dies when a setting fixed at creation ($1 in vm.conf, given as $2 on the
# command line, if at all) differs from the recorded one; $3 describes the
# recorded setting for the message.
_check_fixed() {
	[ -n "${2}" ] || return 0
	[ "$(vm_conf_get "${name}" "${1}")" = "${2}" ] ||
		die "VM '${name}' ${3} — use another --name, or start over: idiot vm delete ${name}"
}

# Dies when a socket in the state directory would be longer than a UNIX
# socket path may be (107 bytes).
_check_socket_paths() {
	for _csp in swtpm.sock qmp.sock; do
		_csp="${workdir}/${_csp}"
		[ "${#_csp}" -le 107 ] ||
			die "the VM's state directory is too long a path for its sockets (${#_csp} > 107 bytes): ${workdir} — use a shorter --state-dir"
	done
}

# Sets disk_flags: the image itself with --in-place, else a qcow2 overlay
# backed by it, created on first boot (and after a reset). Dies when the
# image changed under an existing overlay.
_build_disk_flags() {
	if [ "${in_place}" -eq 1 ]; then
		disk_flags="file=${image},if=none,format=raw,id=disk1"
		return 0
	fi
	_bdf_overlay="${workdir}/disk.qcow2"
	_bdf_stat="$(stat -L -c '%s %Y' "${image}")"
	if [ -f "${_bdf_overlay}" ]; then
		[ "$(vm_conf_get "${name}" image_stat)" = "${_bdf_stat}" ] ||
			die "${image} changed since VM '${name}' was booted from it — start over from the new image with: idiot vm reset ${name}"
	else
		tool_path qemu-img >/dev/null ||
			missing_tool qemu-img "install the qemu-utils package"
		tool qemu-img create -q -f qcow2 -b "${image}" -F raw "${_bdf_overlay}" >&2 ||
			die "could not create the disk overlay ${_bdf_overlay}"
		vm_conf_set "${name}" image_stat "${_bdf_stat}"
	fi
	disk_flags="file=${_bdf_overlay},if=none,format=qcow2,id=disk1"
}

# Whether the VM boots from UEFI firmware we provide: always with secure
# boot, and without it on every arch but i386 (which keeps QEMU's BIOS).
_needs_firmware() {
	[ "${sb}" -eq 1 ] || [ "${arch}" != "i386" ]
}

# Sets fw_flags for UEFI (secure boot or not). No-ops when the VM uses the
# BIOS.
_build_fw_flags() {
	fw_flags=''
	_needs_firmware || return 0
	setup_firmware "${arch}" "${sb}"
	fw_vars="${workdir}/fw_vars.fd"
	# Reuse existing vars if present (allows persistent SB state across runs)
	[ -f "${fw_vars}" ] || cp "${fw_vars_template}" "${fw_vars}"
	fw_flags="-drive if=pflash,format=raw,unit=0,readonly=on,file=${fw_code}"
	fw_flags="${fw_flags} -drive if=pflash,format=raw,unit=1,file=${fw_vars}"
}

# Prints a hint (with a leading " — ") when the host's swtpm may have been
# refused by its AppArmor profile, which lets it create sockets only under
# the home directory and /tmp; nothing otherwise.
_swtpm_hint() {
	_sh_path="$(tool_path swtpm 2>/dev/null)" || return 0
	[ "$(readlink -f "${_sh_path}")" = /usr/bin/swtpm ] || return 0
	[ -e /sys/kernel/security/apparmor ] || return 0
	case "${1}/" in
	"${HOME}"/* | /tmp/*) return 0 ;;
	esac
	printf ' — AppArmor lets the host'"'"'s swtpm create sockets only under ~ and /tmp, not in %s: use a --state-dir there' "${1}"
}

# Sets tpm_flags and starts a background swtpm daemon. No-ops when tpm=0.
_build_tpm_flags() {
	tpm_flags=''
	[ "${tpm}" -eq 1 ] || return
	require swtpm "install the swtpm package"
	tpm_sock="${workdir}/swtpm.sock"
	# _cleanup kills it by this pid when the VM exits
	tpm_pidfile="${workdir}/swtpm.pid"
	# _check_socket_paths ruled out a too-long path: say what swtpm said
	_btf_err="${workdir}/swtpm.err"
	if ! swtpm socket \
		--tpmstate "dir=${workdir}" \
		--ctrl "type=unixio,path=${tpm_sock}" \
		--tpm2 \
		--pid "file=${tpm_pidfile}" \
		--terminate \
		--daemon 2>"${_btf_err}"; then
		_btf_msg="$(sed 's/^swtpm: //' "${_btf_err}" | tr '\n' ' ')"
		rm -f "${_btf_err}"
		die "swtpm failed to start${_btf_msg:+: ${_btf_msg% }}$(_swtpm_hint "${workdir}")"
	fi
	rm -f "${_btf_err}"
	tpm_dev="$(tpm_device_for_arch "${arch}")"
	tpm_flags="-chardev socket,id=chrtpm,path=${tpm_sock}"
	tpm_flags="${tpm_flags} -tpmdev emulator,id=tpm0,chardev=chrtpm"
	tpm_flags="${tpm_flags} -device ${tpm_dev},tpmdev=tpm0"
}

# Sets ports to the forwards VM $name boots with: $1, the ones given with
# --port, each refused when it is taken (naming the running VM that has
# it), else the recorded ones, each moved to the first free port above it
# when taken. Never takes the ssh port; writes nothing.
_pick_forwards() {
	_pf_given="${1}"
	_pf_list="${_pf_given:-$(vm_conf_get "${name}" ports)}"
	_pf_out=''
	_pf_seen=" ${ssh_port} "
	for _pf in ${_pf_list}; do
		_pf_h="${_pf%%:*}"
		_pf_g="${_pf##*:}"
		if [ -n "${_pf_given}" ]; then
			[ "${_pf_h}" != "${ssh_port}" ] ||
				die "--port ${_pf}: ${_pf_h} is the VM's ssh port — pick another host port, or another --ssh-port"
			case "${_pf_seen}" in
			*" ${_pf_h} "*) die "--port: host port ${_pf_h} is given twice" ;;
			esac
			! _pf_vm="$(vm_port_holder "${_pf_h}" "${name}")" ||
				die "--port ${_pf}: port ${_pf_h} is forwarded by VM '${_pf_vm}' — pick another host port"
			vm_port_free "${_pf_h}" "${name}" ||
				die "--port ${_pf}: port ${_pf_h} is in use — pick another host port"
		else
			_pf_n="${_pf_h}"
			until case "${_pf_seen}" in
				*" ${_pf_n} "*) false ;;
				*) vm_port_free "${_pf_n}" "${name}" ;;
				esac do
				_pf_n=$((_pf_n + 1))
				[ "${_pf_n}" -le $((_pf_h + 100)) ] && [ "${_pf_n}" -le 65535 ] ||
					die "no free host port in ${_pf_h}-$((_pf_h + 100)) for guest port ${_pf_g} — give one with --port <host>:${_pf_g}"
			done
			[ "${_pf_n}" = "${_pf_h}" ] ||
				say "VM ${BOLD}${name}${RESET}: guest port ${_pf_g} forwarded from ${BOLD}${_pf_n}${RESET} ${DIM}(was ${_pf_h}, now taken)${RESET}"
			_pf_h="${_pf_n}"
		fi
		_pf_seen="${_pf_seen}${_pf_h} "
		_pf_out="${_pf_out:+${_pf_out} }${_pf_h}:${_pf_g}"
	done
	ports="${_pf_out}"
}

# Dies when another running VM writes $image in place, or when this one
# would write it in place ($in_place) while another runs from it.
_check_shared_image() {
	_csi="$(readlink -f "${image}")"
	for _csi_vm in $(vm_running_names); do
		[ "${_csi_vm}" != "${name}" ] || continue
		[ "$(readlink -f "$(vm_conf_get "${_csi_vm}" image)")" = "${_csi}" ] || continue
		[ "$(vm_conf_get "${_csi_vm}" in_place)" != 1 ] ||
			die "VM '${_csi_vm}' is running and writes ${image} in place — stop it first: idiot vm stop ${_csi_vm}"
		[ "${in_place:-0}" != 1 ] ||
			die "VM '${_csi_vm}' is running from ${image}, which --in-place would write under it — stop it first: idiot vm stop ${_csi_vm}"
	done
}

do_run() {
	name=''
	image=''
	state_dir=''
	# empty: not given (fixed ones come from vm.conf, others too if recorded)
	arch=''
	sb=''
	in_place=''
	tpm=''
	gfx=''
	ssh_port=''
	ports=''
	detach=0

	# Parse arguments
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm boot [options] [<image>] [-- <qemu-args>]"
			say "       idiot vm [options] <image>   (the same, shorter)"
			say "       idiot vm <subcommand> [args...]"
			echo >&2
			help_heading "Subcommands:"
			help_command "boot" "Boot a VM from an image, or again by --name"
			help_command "list" "List VMs"
			help_command "stop" "Shut a running VM down"
			help_command "reset" "Make a VM a freshly flashed device again"
			help_command "delete" "Remove a VM and its state"
			help_command "snapshot" "Save and restore a stopped VM's state"
			help_command "install" "Install snaps (files or from the store) into a running VM"
			help_command "logs" "Print a VM's journal, a snap's logs or the console log"
			help_command "ssh" "SSH into a running VM"
			help_command "scp" "Copy files to/from a running VM"
			help_command "vars" "Inspect a VM's UEFI SB variables"
			help_command "tpm" "Inspect a VM's TPM state with tpm2-tools"
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM name (default: from the image file name)"
			help_option "--arch <arch>" "Target architecture (default: host)"
			help_option "--sb / --no-sb" "Enable/disable UEFI secure boot (default: sb)"
			help_option "--in-place" "Write the image itself (default: an overlay)"
			help_option "--tpm / --no-tpm" "Enable/disable TPM emulation"
			help_option "--gfx / --no-gfx" "Enable/disable display window (default: no-gfx)"
			help_option "--ssh-port <port>" "Host port for guest port 22 (default: 8022 or free)"
			help_option "--port <host:guest>" "Additional port mapping (repeatable)"
			help_option "--state-dir <dir>" "Keep the VM's state here"
			help_option "--detach" "Run in the background (the console goes to its log)"
			echo >&2
			say "Each VM keeps its disk overlay, UEFI variables and TPM state between runs,"
			say "in ${DIM}${IDIOT_VM_DIR}/<name>${RESET}; the image is never written unless"
			say "--in-place. Boot it again with ${CYAN}idiot vm boot --name <name>${RESET}. The image,"
			say "--arch, --sb and --in-place are fixed when a VM is created. With --detach"
			say "it returns once the VM has started: follow the console with"
			say "${CYAN}idiot vm logs --console -f${RESET}, stop it with ${CYAN}idiot vm stop${RESET}."
			say "A second VM gets a free ssh port, and its recorded --port forwards move"
			say "up to free ones when another VM has them."
			exit 0
			;;
		--)
			shift
			break
			;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		--arch)
			[ -n "${2:-}" ] || die "--arch requires an argument"
			arch="${2}"
			shift
			;;
		--sb) sb=1 ;;
		--no-sb) sb=0 ;;
		--in-place) in_place=1 ;;
		--tpm) tpm=1 ;;
		--no-tpm) tpm=0 ;;
		--gfx) gfx=1 ;;
		--no-gfx) gfx=0 ;;
		--detach) detach=1 ;;
		--ssh-port)
			[ -n "${2:-}" ] || die "--ssh-port requires an argument"
			case "${2}" in
			*[!0-9]*) die "--ssh-port: expected a port number, got '${2}'" ;;
			esac
			ssh_port="${2}"
			shift
			;;
		--port)
			[ -n "${2:-}" ] || die "--port requires a host:guest mapping"
			case "${2}" in
			*[!0-9:]* | :* | *: | *:*:*) die "--port: expected host:guest, got '${2}'" ;;
			*:*) ;;
			*) die "--port: expected host:guest, got '${2}'" ;;
			esac
			ports="${ports:+${ports} }${2}"
			shift
			;;
		--state-dir)
			[ -n "${2:-}" ] || die "--state-dir requires a directory argument"
			state_dir="${2}"
			shift
			;;
		--state-dir=*)
			state_dir="${1#--state-dir=}"
			;;
		-*)
			die "unknown option: ${1}"
			;;
		*)
			[ -z "${image}" ] || die "unexpected argument: ${1}"
			image="${1}"
			;;
		esac
		shift
	done

	[ -n "${name}${image}" ] || die \
		"usage: idiot vm [--name <name>] [--arch <arch>] [--sb] [--in-place] [--tpm] [--no-gfx] \
[--ssh-port <port>] [--port <host:guest>] [--state-dir <dir>] [--detach] [<image>] [-- <qemu-args>]"
	if [ -n "${image}" ]; then
		[ -f "${image}" ] || die "image not found: ${image}"
		image="$(cd "$(dirname "${image}")" && pwd)/${image##*/}"
	fi
	[ -n "${name}" ] || name="$(vm_name_from_image "${image}")"
	vm_validate_name "${name}"

	# the state directory and everything qemu, swtpm and idiot write there
	umask 077
	# before anything is written: a port that isn't free creates nothing
	! vm_running "${name}" ||
		die "VM '${name}' is running (ssh port $(vm_conf_get "${name}" ssh_port)) — connect with: idiot vm ssh --name ${name}"
	prev_port="$(vm_conf_get "${name}" ssh_port)"
	_given_hosts=''
	for _p in ${ports}; do
		_given_hosts="${_given_hosts} ${_p%%:*}"
	done
	ssh_port="$(vm_pick_ssh_port "${name}" "${ssh_port}" "${_given_hosts}")" || exit 1
	_pick_forwards "${ports}"
	[ -z "${state_dir}" ] || _link_state_dir
	if vm_exists "${name}"; then
		_check_fixed image "${image}" "was created from $(vm_conf_get "${name}" image)"
		_check_fixed arch "${arch}" "is $(vm_conf_get "${name}" arch)"
		[ "$(vm_conf_get "${name}" sb)" -eq 1 ] && _sb_was='with' || _sb_was='without'
		_check_fixed sb "${sb}" "was created ${_sb_was} secure boot"
		[ "$(vm_conf_get "${name}" in_place)" -eq 1 ] && _ip_was='writes its image in place' ||
			_ip_was='boots from an overlay'
		_check_fixed in_place "${in_place:-0}" "${_ip_was}"
		image="$(vm_conf_get "${name}" image)"
		arch="$(vm_conf_get "${name}" arch)"
		sb="$(vm_conf_get "${name}" sb)"
		in_place="$(vm_conf_get "${name}" in_place)"
		[ -n "${tpm}" ] || tpm="$(vm_conf_get "${name}" tpm)"
		[ -n "${gfx}" ] || gfx="$(vm_conf_get "${name}" gfx)"
		_check_shared_image
		new_vm=0
	else
		[ -n "${image}" ] ||
			die "no VM named '${name}' — create it from an image: idiot vm boot --name ${name} <image>"
		_check_shared_image
		mkdir -p "$(vm_dir "${name}")"
		[ -n "${arch}" ] || arch="$(uname_to_snap_arch)"
		vm_conf_set "${name}" image "${image}"
		vm_conf_set "${name}" arch "${arch}"
		vm_conf_set "${name}" sb "${sb:-1}"
		vm_conf_set "${name}" in_place "${in_place:-0}"
		new_vm=1
	fi
	sb="${sb:-1}"
	in_place="${in_place:-0}"
	tpm="${tpm:-0}"
	gfx="${gfx:-0}"
	vm_conf_set "${name}" tpm "${tpm}"
	vm_conf_set "${name}" gfx "${gfx}"
	vm_conf_set "${name}" ports "${ports}"
	[ -f "${image}" ] || die "image not found: ${image} (VM '${name}' was created from it)"

	vm_find_qemu "${arch}" ||
		missing_tool "qemu-system-$(snap_arch_to_qemu "${arch}")" \
			"install the $(vm_qemu_package "$(snap_arch_to_qemu "${arch}")") package"
	_build_machine_flags
	_setup_workdir
	_check_socket_paths

	vm_conf_set "${name}" ssh_port "${ssh_port}"
	fwds="hostfwd=tcp::${ssh_port}-:22"
	for _p in ${ports}; do
		fwds="${fwds},hostfwd=tcp::${_p%%:*}-:${_p##*:}"
	done

	_build_disk_flags
	_build_fw_flags
	_build_tpm_flags

	[ "${gfx}" -eq 0 ] || [ -z "${qemu_comp}" ] ||
		say "${DIM}The bundled qemu has no display window: the console is here (serial).${RESET}"
	[ "${gfx}" -eq 1 ] && display_flags='' || display_flags='-display none'
	# the serial console stays on the terminal (Ctrl-a c: monitor, Ctrl-a x:
	# quit) and is logged; the previous boot's log is kept. Detached (qemu
	# refuses stdio when it daemonizes) it goes only to the log, and QMP is
	# the only monitor.
	if [ "${detach}" -eq 1 ]; then
		con_chardev="file,id=con0,path=${workdir}/serial.log"
		mon_flags=''
		detach_flags='-daemonize'
	else
		con_chardev="stdio,id=con0,mux=on,logfile=${workdir}/serial.log"
		mon_flags='-mon chardev=con0,mode=readline'
		detach_flags=''
	fi
	[ ! -f "${workdir}/serial.log" ] || mv -f "${workdir}/serial.log" "${workdir}/serial.log.1"
	rm -f "${workdir}/qmp.sock"

	if [ "${new_vm}" -eq 1 ]; then
		say "New VM ${BOLD}${name}${RESET}: its disk, UEFI variables and TPM state are kept in ${BOLD}$(cd "${workdir}" && pwd -P)${RESET}"
		if [ "${in_place}" -eq 1 ]; then
			say "${DIM}--in-place: the guest writes ${image}${RESET}"
		else
			say "${DIM}${image} is left as it is (the guest writes an overlay); start over with: idiot vm reset ${name}${RESET}"
		fi
	fi
	if [ -n "${prev_port}" ] && [ "${prev_port}" != "${ssh_port}" ]; then
		say "VM ${BOLD}${name}${RESET}: ssh port ${BOLD}${ssh_port}${RESET} ${DIM}(was ${prev_port})${RESET}"
	else
		say "VM ${BOLD}${name}${RESET}: ssh port ${BOLD}${ssh_port}${RESET}"
	fi

	# shellcheck disable=SC2086,SC2154 # qemu_* from vm_find_qemu
	${qemu_env} "${qemu_path}" \
		${qemu_data_flags} \
		-smp "$(nproc)" \
		-m 2048 \
		${machine_flags} \
		${kvm_flags} \
		-net nic,model=virtio \
		-net "user,${fwds}" \
		${fw_flags} \
		-drive "${disk_flags}" \
		-device virtio-blk-pci,drive=disk1,bootindex=1 \
		${tpm_flags} \
		-chardev "${con_chardev}" \
		-serial chardev:con0 \
		${mon_flags} \
		${display_flags} \
		${detach_flags} \
		-pidfile "${workdir}/qemu.pid" \
		-qmp "unix:${workdir}/qmp.sock,server=on,wait=off" \
		"$@" >&2
	qemu_rc=$?

	if [ "${detach}" -eq 1 ]; then
		[ "${qemu_rc}" -eq 0 ] || {
			say "${DIM}VM ${name} did not start; its state is kept${RESET}"
			exit "${qemu_rc}"
		}
		# qemu runs on with the swtpm: leave it to --terminate
		detached=1
		say "VM ${BOLD}${name}${RESET} runs in the background"
		say "${DIM}console: idiot vm logs --console -f --name ${name}; stop: idiot vm stop ${name}${RESET}"
		exit 0
	fi
	say "${DIM}VM ${name} stopped; its state is kept (boot again: idiot vm boot --name ${name})${RESET}"
	exit "${qemu_rc}"
}

do_list() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot vm list"
		echo >&2
		say "Prints each VM's name, architecture, state, ssh port, --port forwards"
		say "and image."
		exit 0
		;;
	esac
	[ $# -eq 0 ] || die "usage: idiot vm list"
	_names="$(vm_names)"
	[ -n "${_names}" ] || {
		say "No VMs yet (boot one with: idiot vm boot <image>)"
		exit 0
	}
	printf '%s\n' "${_names}" | {
		printf '%-20s %-8s %-8s %-6s %-16s %s\n' NAME ARCH STATE PORT FORWARDS IMAGE
		while IFS= read -r _n; do
			vm_running "${_n}" && _state=running || _state=stopped
			_fw="$(vm_conf_get "${_n}" ports | tr ' ' ',')"
			printf '%-20s %-8s %-8s %-6s %-16s %s\n' "${_n}" "$(vm_conf_get "${_n}" arch)" \
				"${_state}" "$(vm_conf_get "${_n}" ssh_port)" "${_fw:--}" "$(vm_conf_get "${_n}" image)"
		done
	}
}

# Waits up to $2 seconds for process $1 to exit; fails if it's still there.
_wait_exit() {
	_we=0
	while kill -0 "${1}" 2>/dev/null; do
		[ "${_we}" -lt "${2}" ] || return 1
		sleep 1
		_we=$((_we + 1))
	done
}

# Sends QMP command $2 to VM $1; fails without idiot-helper or when qemu
# won't.
_qmp() {
	_qmp_h="$(helper_path idiot-helper)" || return 1
	"${_qmp_h}" qmp "$(vm_dir "${1}")/qmp.sock" "${2}" >/dev/null
}

do_stop() {
	timeout=60
	force=0
	name=''
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm stop [--timeout <seconds>] [--force] [<name>]"
			echo >&2
			help_heading "Options:"
			help_option "--timeout <seconds>" "Wait this long for the guest (default: 60)"
			help_option "--force" "Quit qemu without asking the guest"
			echo >&2
			say "Presses the VM's power button and waits for the guest to shut down;"
			say "then makes qemu quit. Without a name: the only running VM."
			exit 0
			;;
		--timeout)
			case "${2:-}" in
			'' | *[!0-9]*) die "--timeout requires a number of seconds" ;;
			esac
			timeout="${2}"
			shift
			;;
		--force) force=1 ;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ -z "${name}" ] || die "usage: idiot vm stop [--timeout <seconds>] [--force] [<name>]"
			name="${1}"
			;;
		esac
		shift
	done
	name="$(vm_resolve "${name}")" || exit 1
	pid="$(vm_pid "${name}")" || {
		say "VM ${BOLD}${name}${RESET} is not running"
		exit 0
	}

	if [ "${force}" -eq 0 ]; then
		if _qmp "${name}" system_powerdown; then
			say "Shutting VM ${BOLD}${name}${RESET} down ${DIM}(up to ${timeout}s)${RESET}"
			_wait_exit "${pid}" "${timeout}" ||
				say "${YELLOW}warning:${RESET} the guest did not shut down within ${timeout}s — quitting qemu"
		else
			helper_path idiot-helper >/dev/null ||
				say "${DIM}a graceful shutdown needs idiot-helper (make install): quitting qemu${RESET}"
		fi
	fi
	if kill -0 "${pid}" 2>/dev/null; then
		{ _qmp "${name}" quit && _wait_exit "${pid}" 2; } ||
			{ kill -TERM "${pid}" 2>/dev/null && _wait_exit "${pid}" 2; } ||
			{ kill -KILL "${pid}" 2>/dev/null && _wait_exit "${pid}" 2; } ||
			die "qemu (pid ${pid}) did not exit"
	fi
	# normally gone with qemu (--terminate) or the launching idiot vm
	vm_swtpm_stop "$(vm_dir "${name}")"
	say "Stopped VM ${BOLD}${name}${RESET}"
}

# Dies unless VM $1 is stopped.
_require_stopped() {
	! vm_running "${1}" ||
		die "VM '${1}' is running — stop it first: idiot vm stop ${1}"
}

# Asks question $2 on the terminal and succeeds on yes; with yes=1 (--yes)
# succeeds without asking. Without a terminal, dies saying that $1 (what
# is being done) needs confirmation.
_confirm() {
	[ "${yes:-0}" -eq 0 ] || return 0
	[ -t 0 ] || die "${1} needs confirmation — run it on a terminal, or pass --yes"
	printf '%s' "${2} [y/N] " >&2
	read -r _c_answer || _c_answer=''
	case "${_c_answer}" in
	y | Y | yes) return 0 ;;
	esac
	return 1
}

do_reset() {
	yes=0
	name=''
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm reset [--yes] <name>"
			echo >&2
			say "Discards a stopped VM's disk overlay, UEFI variables, TPM state, serial"
			say "logs and snapshots, so that it next boots as a freshly flashed device."
			say "When it has snapshots, asks first (--yes skips the question)."
			exit 0
			;;
		--yes | -y) yes=1 ;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ -z "${name}" ] || die "usage: idiot vm reset [--yes] <name>"
			name="${1}"
			;;
		esac
		shift
	done
	[ -n "${name}" ] || die "usage: idiot vm reset [--yes] <name>"
	name="$(vm_resolve "${name}")" || exit 1
	_require_stopped "${name}"
	_d="$(vm_dir "${name}")"
	_n="$(vm_snapshot_names "${name}" | wc -l)"
	if [ "${_n}" -gt 0 ]; then
		[ "${_n}" -eq 1 ] && _what='its snapshot' || _what="its ${_n} snapshots"
		say "Resetting VM ${BOLD}${name}${RESET} also discards ${_what}"
		_confirm "resetting VM '${name}'" "Reset VM ${BOLD}${name}${RESET}?" || {
			say "Nothing reset"
			exit 0
		}
	fi
	rm -f "${_d}/disk.qcow2" "${_d}/fw_vars.fd" "${_d}"/tpm2-* "${_d}"/*.restore \
		"${_d}/serial.log" "${_d}/serial.log.1" "${_d}/swtpm.pid" "${_d}/swtpm.sock" \
		"${_d}/qemu.pid" "${_d}/qmp.sock" "${_d}/inspect.sock" "${_d}/inspect.sock.ctrl"
	rm -rf "${_d:?}/snapshots"
	say "Reset VM ${BOLD}${name}${RESET}: it boots as a freshly flashed device"
	[ "$(vm_conf_get "${name}" in_place)" -ne 1 ] ||
		say "${YELLOW}warning:${RESET} VM '${name}' writes $(vm_conf_get "${name}" image) in place: the image itself can't be reset"
}

do_delete() {
	yes=0
	name=''
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm delete [--yes] <name>"
			echo >&2
			say "Removes a stopped VM and its state. The image is not touched."
			exit 0
			;;
		--yes | -y) yes=1 ;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ -z "${name}" ] || die "usage: idiot vm delete [--yes] <name>"
			name="${1}"
			;;
		esac
		shift
	done
	[ -n "${name}" ] || die "usage: idiot vm delete [--yes] <name>"
	name="$(vm_resolve "${name}")" || exit 1
	_require_stopped "${name}"
	_d="$(vm_dir "${name}")"
	_real="$(cd "${_d}" && pwd -P)"

	_confirm "deleting VM '${name}'" "Delete VM ${BOLD}${name}${RESET} and its state in ${_real}?" || {
		say "Nothing deleted"
		exit 0
	}
	if [ -L "${_d}" ]; then
		# a --state-dir: only what idiot put there, and the dir if now empty
		rm -f "${_d}/vm.conf" "${_d}/disk.qcow2" "${_d}/fw_vars.fd" "${_d}"/tpm2-* \
			"${_d}/serial.log" "${_d}/serial.log.1" "${_d}/swtpm.pid" "${_d}/swtpm.sock" \
			"${_d}/qemu.pid" "${_d}/qmp.sock" "${_d}/inspect.sock" "${_d}/inspect.sock.ctrl" \
			"${_d}"/*.restore
		rm -rf "${_d:?}/snapshots"
		rmdir "${_real}" 2>/dev/null || say "${DIM}Kept ${_real}: it holds other files${RESET}"
		rm -f "${_d}"
	else
		rm -rf "${_d}"
	fi
	say "Deleted VM ${BOLD}${name}${RESET}"
}

# Sets name (the VM: --name $1, else the only VM) for the snapshot
# subcommands; never "the only running VM", which they would refuse.
_snapshot_vm() {
	if [ -n "${1}" ]; then
		name="$(vm_resolve "${1}")" || exit 1
		return 0
	fi
	_sv="$(vm_names)"
	[ -n "${_sv}" ] || die "no VMs — boot one with: idiot vm boot <image>"
	[ "$(printf '%s\n' "${_sv}" | wc -l)" -eq 1 ] ||
		die "there are several VMs ($(printf '%s' "${_sv}" | paste -sd, - | sed 's/,/, /g')) — pick one with --name <vm>"
	name="${_sv}"
}

# Parses the snapshot subcommands' arguments: sets vm (--name), yes
# (--yes, when $1 allows it) and snap (the positional snapshot name, when
# $2 is "snap"). $3 is the usage line; the rest are the arguments.
_snapshot_args() {
	_sa_yes="${1}"
	_sa_snap="${2}"
	_sa_usage="${3}"
	shift 3
	vm=''
	yes=0
	snap=''
	while [ $# -gt 0 ]; do
		case "${1}" in
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			vm="${2}"
			shift
			;;
		--name=*) vm="${1#--name=}" ;;
		--yes | -y)
			[ "${_sa_yes}" = yes ] || die "unknown option: ${1}"
			yes=1
			;;
		--)
			shift
			[ $# -le 1 ] && [ "${_sa_snap}" = snap ] && [ -z "${snap}" ] || die "usage: ${_sa_usage}"
			snap="${1:-}"
			break
			;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ "${_sa_snap}" = snap ] && [ -z "${snap}" ] || die "usage: ${_sa_usage}"
			snap="${1}"
			;;
		esac
		shift
	done
	[ "${_sa_snap}" != snap ] || [ -n "${snap}" ] || die "usage: ${_sa_usage}"
	[ -z "${snap}" ] || vm_validate_snapshot_name "${snap}"
	_snapshot_vm "${vm}"
	_sd="$(vm_dir "${name}")"
	umask 077
}

# Dies unless VM $name has a disk overlay to snapshot (it is not
# --in-place).
_snapshot_need_overlay() {
	[ "$(vm_conf_get "${name}" in_place)" != 1 ] ||
		die "VM '${name}' writes its image in place: snapshots need a disk overlay (a VM created without --in-place)"
}

# Makes sure there is a qemu-img to run.
_snapshot_need_qemu_img() {
	tool_path qemu-img >/dev/null ||
		missing_tool qemu-img "install the qemu-utils package"
}

_snapshot_create() {
	_u="idiot vm snapshot create [--name <vm>] <snapshot>"
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "${_u}"
		echo >&2
		help_heading "Options:"
		help_option "--name <vm>" "VM to snapshot (default: the only VM)"
		echo >&2
		say "Saves a stopped VM's disk, UEFI variables and TPM state under a name,"
		say "to restore later. The disk snapshot lives inside the VM's overlay and"
		say "costs only what the guest changes afterwards; the image is not touched."
		say "A VM stopped with ${CYAN}idiot vm stop --force${RESET} gives a crash-consistent"
		say "snapshot, as its next boot would be."
		exit 0
		;;
	esac
	_snapshot_args no snap "${_u}" "$@"
	_require_stopped "${name}"
	_snapshot_need_overlay
	[ -f "${_sd}/disk.qcow2" ] ||
		die "VM '${name}' has no disk overlay yet — boot it first: idiot vm boot --name ${name}"
	_snapshot_need_qemu_img
	_tags="$(vm_snapshot_tags "${name}")" || die "could not read the snapshots in ${_sd}/disk.qcow2"
	[ ! -d "$(vm_snapshot_dir "${name}" "${snap}")" ] ||
		die "VM '${name}' already has a snapshot '${snap}' — delete it first: idiot vm snapshot delete --name ${name} ${snap}"
	! printf '%s\n' "${_tags}" | grep -qxF -- "${snap}" ||
		die "the disk of VM '${name}' already has an internal snapshot '${snap}' that idiot didn't take — pick another name, or delete it: idiot vm snapshot delete --name ${name} ${snap}"

	# the copies first, then the disk snapshot, then the name: a failure
	# at any step leaves no part of it
	_new="$(vm_snapshot_dir "${name}")/.new.${snap}"
	rm -rf "${_new:?}"
	mkdir -p "${_new}" || die "could not create ${_new}"
	_vars=0
	_tpm=0
	if [ -f "${_sd}/fw_vars.fd" ]; then
		cp "${_sd}/fw_vars.fd" "${_new}/" || {
			rm -rf "${_new:?}"
			die "could not copy ${_sd}/fw_vars.fd"
		}
		_vars=1
	fi
	for _f in "${_sd}"/tpm2-*; do
		[ -f "${_f}" ] || continue
		cp "${_f}" "${_new}/" || {
			rm -rf "${_new:?}"
			die "could not copy ${_f}"
		}
		_tpm=1
	done
	printf 'created=%s\nvars=%s\ntpm=%s\n' "$(date +%s)" "${_vars}" "${_tpm}" >"${_new}/snapshot.conf" || {
		rm -rf "${_new:?}"
		die "could not write ${_new}/snapshot.conf"
	}
	tool qemu-img snapshot -c "${snap}" "${_sd}/disk.qcow2" >&2 || {
		rm -rf "${_new:?}"
		die "could not take a disk snapshot of ${_sd}/disk.qcow2"
	}
	mv "${_new}" "$(vm_snapshot_dir "${name}" "${snap}")" || {
		tool qemu-img snapshot -d "${snap}" "${_sd}/disk.qcow2" >&2
		rm -rf "${_new:?}"
		die "could not save the snapshot in $(vm_snapshot_dir "${name}")"
	}

	_parts='disk'
	if [ "${_vars}" -eq 1 ] && [ "${_tpm}" -eq 1 ]; then
		_parts='disk, UEFI variables and TPM state'
	elif [ "${_vars}" -eq 1 ]; then
		_parts='disk and UEFI variables (no TPM state)'
	elif [ "${_tpm}" -eq 1 ]; then
		_parts='disk and TPM state (no UEFI variables)'
	else
		_parts='disk (no UEFI variables or TPM state)'
	fi
	say "Took snapshot ${BOLD}${snap}${RESET} of VM ${BOLD}${name}${RESET}: ${_parts}"
}

_snapshot_list() {
	_u="idiot vm snapshot list [--name <vm>]"
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "${_u}"
		echo >&2
		help_heading "Options:"
		help_option "--name <vm>" "VM whose snapshots to list (default: the only VM)"
		echo >&2
		say "Prints a VM's snapshots, oldest first: name, when it was taken, whether"
		say "it holds UEFI variables and TPM state, and ${BOLD}broken${RESET} when a part of"
		say "it is missing. Works on a running VM too."
		exit 0
		;;
	esac
	_snapshot_args no no "${_u}" "$@"
	_tags=''
	if [ -f "${_sd}/disk.qcow2" ]; then
		_snapshot_need_qemu_img
		_tags="$(vm_snapshot_tags "${name}")" || die "could not read the snapshots in ${_sd}/disk.qcow2"
	fi
	_names="$(vm_snapshot_names "${name}")"
	if [ -z "${_names}" ]; then
		say "No snapshots of VM ${name} (take one with: idiot vm snapshot create --name ${name} <snapshot>)"
	else
		printf '%s\n' "${_names}" | {
			printf '%-20s %-16s %-4s %-4s %s\n' NAME CREATED UEFI TPM STATE
			while IFS= read -r _n; do
				_t="$(vm_snapshot_conf_get "${name}" "${_n}" created)"
				_c="$(date -d "@${_t:-0}" '+%Y-%m-%d %H:%M' 2>/dev/null)" || _c='-'
				[ -n "${_t}" ] || _c='-'
				[ "$(vm_snapshot_conf_get "${name}" "${_n}" vars)" = 1 ] && _v=yes || _v=no
				[ "$(vm_snapshot_conf_get "${name}" "${_n}" tpm)" = 1 ] && _p=yes || _p=no
				[ -z "$(vm_snapshot_problem "${name}" "${_n}" "${_tags}")" ] && _s=ok || _s=broken
				printf '%-20s %-16s %-4s %-4s %s\n' "${_n}" "${_c}" "${_v}" "${_p}" "${_s}"
			done
		}
	fi
	_foreign="$(printf '%s\n' "${_tags}" | while IFS= read -r _t; do
		[ -n "${_t}" ] && ! printf '%s\n' "${_names}" | grep -qxF -- "${_t}" && printf '%s\n' "${_t}"
	done | paste -sd, - | sed 's/,/, /g')"
	[ -z "${_foreign}" ] ||
		say "${DIM}The disk also has internal snapshots idiot didn't take (not listed): ${_foreign}${RESET}"
	_half="$(vm_snapshot_dir "${name}")/.restoring"
	[ ! -f "${_half}" ] ||
		say "${YELLOW}warning:${RESET} VM '${name}' is half-restored from '$(cat "${_half}")' — finish it: idiot vm snapshot restore --name ${name} $(cat "${_half}")"
}

_snapshot_restore() {
	_u="idiot vm snapshot restore [--yes] [--name <vm>] <snapshot>"
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "${_u}"
		echo >&2
		help_heading "Options:"
		help_option "--name <vm>" "VM to restore (default: the only VM)"
		help_option "--yes" "Don't ask for confirmation"
		echo >&2
		say "Puts a stopped VM's disk, UEFI variables and TPM state back to what"
		say "they were when the snapshot was taken, discarding what changed since;"
		say "a part the VM didn't have then is removed. The snapshot is kept, and"
		say "the VM's settings, ssh port and serial logs stay as they are. A"
		say "snapshot of a VM stopped with ${CYAN}idiot vm stop --force${RESET} is crash-consistent."
		exit 0
		;;
	esac
	_snapshot_args yes snap "${_u}" "$@"
	_require_stopped "${name}"
	_snapshot_need_overlay
	_src="$(vm_snapshot_dir "${name}" "${snap}")"
	[ -d "${_src}" ] ||
		die "VM '${name}' has no snapshot '${snap}' — see: idiot vm snapshot list --name ${name}"
	_snapshot_need_qemu_img
	_tags="$(vm_snapshot_tags "${name}")" || die "could not read the snapshots in ${_sd}/disk.qcow2"
	_missing="$(vm_snapshot_problem "${name}" "${snap}" "${_tags}" | paste -sd, - | sed 's/,/, /g')"
	[ -z "${_missing}" ] ||
		die "snapshot '${snap}' of VM '${name}' is broken (missing: ${_missing}) — delete it: idiot vm snapshot delete --name ${name} ${snap}"
	_confirm "restoring VM '${name}'" \
		"Put VM ${BOLD}${name}${RESET} back to snapshot ${BOLD}${snap}${RESET}, discarding what changed since?" || {
		say "Nothing changed"
		exit 0
	}

	# the copies under temporary names, then the disk, then the copies in
	# place; .restoring marks the window between the disk and the moves
	_half="$(vm_snapshot_dir "${name}")/.restoring"
	_was=''
	[ ! -f "${_half}" ] || _was="$(cat "${_half}")"
	rm -f "${_sd}"/*.restore
	for _f in "${_src}"/fw_vars.fd "${_src}"/tpm2-*; do
		[ -f "${_f}" ] || continue
		cp "${_f}" "${_sd}/${_f##*/}.restore" || {
			rm -f "${_sd}"/*.restore
			die "could not copy ${_f}: VM '${name}' is unchanged"
		}
	done
	printf '%s\n' "${snap}" >"${_half}" || {
		rm -f "${_sd}"/*.restore
		die "could not write ${_half}: VM '${name}' is unchanged"
	}
	tool qemu-img snapshot -a "${snap}" "${_sd}/disk.qcow2" >&2 || {
		rm -f "${_sd}"/*.restore
		if [ -n "${_was}" ]; then
			printf '%s\n' "${_was}" >"${_half}"
		else
			rm -f "${_half}"
		fi
		die "could not restore the disk of VM '${name}' from snapshot '${snap}': the VM is unchanged"
	}
	for _f in "${_sd}"/*.restore; do
		[ -f "${_f}" ] || continue
		mv -f "${_f}" "${_f%.restore}" ||
			die "could not move ${_f} into place — finish the restore: idiot vm snapshot restore --name ${name} ${snap}"
	done
	[ -f "${_src}/fw_vars.fd" ] || rm -f "${_sd}/fw_vars.fd"
	for _f in "${_sd}"/tpm2-*; do
		[ ! -f "${_f}" ] || [ -f "${_src}/${_f##*/}" ] || rm -f "${_f}"
	done
	# a leftover swtpm pid or socket would confuse the next boot's swtpm
	rm -f "${_sd}/swtpm.pid" "${_sd}/swtpm.sock" "${_half}"
	say "Restored VM ${BOLD}${name}${RESET} to snapshot ${BOLD}${snap}${RESET}"
}

_snapshot_delete() {
	_u="idiot vm snapshot delete [--yes] [--name <vm>] <snapshot>"
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "${_u}"
		echo >&2
		help_heading "Options:"
		help_option "--name <vm>" "VM whose snapshot to delete (default: the only VM)"
		help_option "--yes" "Don't ask for confirmation"
		echo >&2
		say "Removes every part of a stopped VM's snapshot that exists, broken"
		say "snapshots included. The VM's current state is left as it is."
		exit 0
		;;
	esac
	_snapshot_args yes snap "${_u}" "$@"
	_require_stopped "${name}"
	_dir="$(vm_snapshot_dir "${name}" "${snap}")"
	_tags=''
	if [ -f "${_sd}/disk.qcow2" ]; then
		_snapshot_need_qemu_img
		_tags="$(vm_snapshot_tags "${name}")" || die "could not read the snapshots in ${_sd}/disk.qcow2"
	fi
	_tagged=0
	! printf '%s\n' "${_tags}" | grep -qxF -- "${snap}" || _tagged=1
	[ -d "${_dir}" ] || [ "${_tagged}" -eq 1 ] ||
		die "VM '${name}' has no snapshot '${snap}' — see: idiot vm snapshot list --name ${name}"
	_half="$(vm_snapshot_dir "${name}")/.restoring"
	[ ! -f "${_half}" ] || [ "$(cat "${_half}")" != "${snap}" ] ||
		die "VM '${name}' is half-restored from '${snap}' — finish it first: idiot vm snapshot restore --name ${name} ${snap}"
	_confirm "deleting snapshot '${snap}' of VM '${name}'" \
		"Delete snapshot ${BOLD}${snap}${RESET} of VM ${BOLD}${name}${RESET}?" || {
		say "Nothing deleted"
		exit 0
	}
	if [ "${_tagged}" -eq 1 ]; then
		tool qemu-img snapshot -d "${snap}" "${_sd}/disk.qcow2" >&2 ||
			die "could not delete the disk snapshot '${snap}' from ${_sd}/disk.qcow2"
	fi
	rm -rf "${_dir:?}"
	say "Deleted snapshot ${BOLD}${snap}${RESET} of VM ${BOLD}${name}${RESET}"
}

do_snapshot() {
	case "${1:-}" in
	'' | -h | --help | help)
		help_heading "Usage:" "idiot vm snapshot <subcommand> [--name <vm>] [<snapshot>]"
		echo >&2
		help_heading "Subcommands:"
		help_command "create" "Save a stopped VM's state under a name"
		help_command "list" "List a VM's snapshots"
		help_command "restore" "Put a stopped VM back to a snapshot"
		help_command "delete" "Remove a snapshot"
		echo >&2
		say "A snapshot is a stopped VM's disk, UEFI variables and TPM state, taken"
		say "together. Without --name: the only VM."
		exit 0
		;;
	create)
		shift
		_snapshot_create "$@"
		;;
	list)
		shift
		_snapshot_list "$@"
		;;
	restore)
		shift
		_snapshot_restore "$@"
		;;
	delete)
		shift
		_snapshot_delete "$@"
		;;
	*) die "unknown subcommand: idiot vm snapshot ${1} — see: idiot vm snapshot --help" ;;
	esac
}

# The old name of idiot vm logs --console: the VM is its argument there.
do_console_log() {
	alias_note "vm console-log" "vm logs --console"
	_cl_args=''
	_cl_name=''
	for _cl_a in "$@"; do
		case "${_cl_a}" in
		-h | --help | help | -f | --follow | --previous)
			_cl_args="${_cl_args} ${_cl_a}"
			;;
		-*) die "unknown option: ${_cl_a}" ;;
		*)
			[ -z "${_cl_name}" ] || die "usage: idiot vm logs --console [--name <name>] [-f] [--previous]"
			_cl_name="${_cl_a}"
			;;
		esac
	done
	# shellcheck disable=SC2086 # the flags split on purpose; none has spaces
	do_logs --console ${_cl_args} ${_cl_name:+--name "${_cl_name}"}
}

# Print VM $1's serial console log: $2 is the file (serial.log, or
# serial.log.1 for the previous boot), $3 1 to keep following it.
_console_log() {
	which="${2}"
	follow="${3}"
	name="$(vm_resolve "${1}" any)" || exit 1
	log="$(vm_dir "${name}")/${which}"
	[ -f "${log}" ] || {
		[ "${which}" = serial.log ] && die "VM '${name}' has no console log yet — boot it: idiot vm boot --name ${name}"
		die "VM '${name}' has no log of a previous boot"
	}
	if [ "${follow}" -eq 0 ]; then
		cat "${log}"
	elif _pid="$(vm_pid "${name}")"; then
		exec tail -n +1 -f --pid="${_pid}" "${log}"
	else
		exec tail -n +1 -f "${log}"
	fi
}

# Sets lp_user and port for install/logs: the VM $name (or the only
# running one) must be running and reachable as the Launchpad user.
_vm_target() {
	lp_user="$(require_lp_user)" || exit 1
	name="$(vm_resolve "${name}")" || exit 1
	vm_running "${name}" || die "VM '${name}' is not running — boot it: idiot vm boot --name ${name}"
	port="$(vm_conf_get "${name}" ssh_port)"
}

# Runs a command in the VM as the target (see _vm_target), never prompting.
_guest() {
	VM_SSH_EXTRA='-o BatchMode=yes -o ConnectTimeout=5' vm_ssh "${port}" "${lp_user}" "$@"
}

# Waits until the VM answers ssh again, up to $1 seconds; dies when it
# doesn't or qemu exits.
_await_guest() {
	_ag_t0="$(date +%s)"
	until _guest true 2>/dev/null; do
		vm_running "${name}" || die "VM '${name}' stopped while the change was in progress"
		[ "$(($(date +%s) - _ag_t0))" -lt "${1}" ] ||
			die "VM '${name}' didn't answer ssh within ${1}s — follow the change later: idiot vm ssh --name ${name} -- snap change ${change}"
		sleep 2
	done
}

# Removes the guest's copy of the snaps (when the guest still has it).
_install_cleanup() {
	[ -z "${gdir:-}" ] || _guest rm -rf "${gdir}" >/dev/null 2>&1 || :
}

# Succeeds if $1 is a snap name as snapd allows it: 2-40 of a-z, 0-9 and
# '-', at least one letter, no leading, trailing or doubled '-'.
_valid_snap_name() {
	case "${1}" in
	'' | *[!a-z0-9-]* | -* | *- | *--*) return 1 ;;
	*[a-z]*) ;;
	*) return 1 ;;
	esac
	[ "${#1}" -ge 2 ] && [ "${#1}" -le 40 ]
}

# Succeeds if $1 is a channel: 1-3 '/'-separated non-empty segments of
# a-z, 0-9, '.', '_' and '-'.
_valid_channel() {
	case "${1}" in
	'' | /* | */ | *//* | */*/*/* | *[!a-z0-9._/-]*) return 1 ;;
	esac
}

# Downloads store snap $1 from channel $2 for the VM's architecture into
# the cache (the helper verifies it and writes its assertions beside it),
# and adds it to files; dies, suggesting idiot store check, when the store
# doesn't show it, has no release for the arch or refuses the download.
_store_fetch() {
	_sf_check="idiot store check ${1} --arch ${arch} --channel ${2}${cred:+ --cred ${cred}}"
	set -- "${1}" "${2}" download --arch "${arch}" --channel "${2}" --dir "${IDIOT_CACHE_DIR}/snaps"
	[ -z "${UBUNTU_STORE_ID:-}" ] || set -- "$@" --store "${UBUNTU_STORE_ID}"
	# shellcheck disable=SC2154 # query_file from query_cred (creds.sh)
	[ -z "${query_file}" ] || set -- "$@" --file "${query_file}"
	[ "${dangerous}" -eq 0 ] || set -- "$@" --no-assertions
	[ ! -t 2 ] || set -- "$@" --progress
	_sf_name="${1}"
	_sf_ch="${2}"
	shift 2
	_sf_out="$("${store_helper}" "$@" "${_sf_name}")" ||
		die "could not download ${_sf_name} from ${store_lbl} — check it: ${_sf_check}"
	_sf_first="$(printf '%s\n' "${_sf_out}" | head -n 1)"
	case "${_sf_first}" in
	snap'	'*)
		_sf_path="$(printf '%s' "${_sf_first}" | cut -f 2)"
		_sf_rev="$(printf '%s' "${_sf_first}" | cut -f 4)"
		_sf_ver="$(printf '%s' "${_sf_first}" | cut -f 5)"
		if [ "$(printf '%s' "${_sf_first}" | cut -f 6)" = cached ]; then
			say "${BOLD}${_sf_name}${RESET} ${_sf_ver} (${_sf_rev}) for ${arch}: cached ${DIM}(${_sf_path})${RESET}"
		else
			say "Downloaded ${BOLD}${_sf_name}${RESET} ${_sf_ver} (${_sf_rev}) for ${arch} from ${store_lbl} ${DIM}(${_sf_path})${RESET}"
		fi
		files="${files}${_sf_path}
"
		store_snaps="${store_snaps:+${store_snaps}, }${_sf_name}"
		;;
	unknown)
		_sf_to=''
		[ -z "${query_cred}" ] || _sf_to=" to credential '${query_cred}'"
		die "${store_lbl} doesn't show ${_sf_name}${_sf_to} — check it: ${_sf_check}"
		;;
	unreleased'	'*)
		_sf_have="$(printf '%s\n' "${_sf_out}" | awk -F '\t' '$1 == "available" { print $2 " (" $3 ")" }' |
			paste -sd, - | sed 's/,/, /g')"
		die "${_sf_name} has no ${arch} release in $(printf '%s' "${_sf_first}" | cut -f 2)${_sf_have:+ (${arch} releases: ${_sf_have})}${_sf_have:- (no ${arch} release in any channel)} — check it: ${_sf_check}"
		;;
	refused'	'*)
		die "${store_lbl} refused to download ${_sf_name} (HTTP $(printf '%s' "${_sf_first}" | cut -f 2)) — check it: ${_sf_check}"
		;;
	*) die "unexpected answer from idiot-store download: ${_sf_first}" ;;
	esac
}

do_install() {
	name=''
	dangerous=0
	flags=''
	timeout=300
	files=''
	store_args=''
	channel=''
	cred=''
	_usage="usage: idiot vm install [--name <name>] [--channel <channel>] [--cred <name>] [options] <snap>..."
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm install [--name <name>] [options] <snap>..."
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM to install into (default: the running one)"
			help_option "--channel <channel>" "Channel for store snaps without =<channel> (default: stable)"
			help_option "--cred <name>" "Download with this saved credential instead of the active one"
			help_option "--dangerous" "Install without assertions even if there are some"
			help_option "--classic" "Classic confinement"
			help_option "--devmode" "Developer mode"
			help_option "--timeout <seconds>" "Wait this long for a reboot (default: 300)"
			echo >&2
			say "Each ${BOLD}<snap>${RESET} is a ${BOLD}<file>.snap${RESET} on this machine, or a snap in the"
			say "store: ${BOLD}<name>${RESET} or ${BOLD}<name>=<channel>${RESET}. Store snaps are downloaded here"
			say "for the VM's architecture, from the active store with the active"
			say "credential (or anonymously), verified, and cached in"
			say "${DIM}${IDIOT_CACHE_DIR}/snaps${RESET} with their assertions."
			echo >&2
			say "Copies the snaps into the VM, installs them with snapd in one change and"
			say "follows it, through the guest rebooting for a kernel, gadget or base."
			say "With a ${BOLD}<file>.assert${RESET} next to every snap (as snap download"
			say "leaves them, and store snaps always have) they install as asserted"
			say "revisions, else all with --dangerous."
			echo >&2
			help_heading "Examples:"
			say "  ${CYAN}idiot vm install${RESET} hello-world"
			say "  ${CYAN}idiot vm install${RESET} pc-kernel=24/edge ./pc_custom.snap"
			exit 0
			;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		--channel)
			[ -n "${2:-}" ] || die "--channel requires an argument"
			_valid_channel "${2}" ||
				die "invalid channel '${2}': use <risk>, <track>/<risk> or <track>/<risk>/<branch>"
			channel="${2}"
			shift
			;;
		--cred)
			[ -n "${2:-}" ] || die "--cred requires a credential name"
			cred="${2}"
			shift
			;;
		--dangerous) dangerous=1 ;;
		--classic | --devmode) flags="${flags} ${1}" ;;
		--timeout)
			case "${2:-}" in
			'' | *[!0-9]*) die "--timeout requires a number of seconds" ;;
			esac
			timeout="${2}"
			shift
			;;
		--) ;;
		-*) die "unknown option: ${1}" ;;
		*.snap)
			[ -f "${1}" ] || die "file not found: ${1}"
			case "${1}" in
			*'
'*) die "file names with newlines aren't supported: ${1}" ;;
			esac
			files="${files}${1}
"
			;;
		*=*)
			_n="${1%%=*}"
			_c="${1#*=}"
			_valid_snap_name "${_n}" || die "invalid snap name '${_n}' in ${1}"
			[ -n "${_c}" ] || die "empty channel in '${1}' — name one, e.g. ${_n}=edge"
			_valid_channel "${_c}" ||
				die "invalid channel '${_c}' in ${1}: use <risk>, <track>/<risk> or <track>/<risk>/<branch>"
			store_args="${store_args}${_n} ${_c}
"
			;;
		*/*) die "not a .snap file or a snap name: ${1}" ;;
		*)
			_valid_snap_name "${1}" ||
				die "invalid snap name '${1}' (2-40 of a-z, 0-9 and '-'; a file must end in .snap)"
			store_args="${store_args}${1} -
"
			;;
		esac
		shift
	done
	[ -n "${files}${store_args}" ] || die "${_usage}"
	if [ -z "${store_args}" ]; then
		[ -z "${channel}" ] || die "--channel is for store snaps, and only files were given"
		[ -z "${cred}" ] || die "--cred is for store snaps, and only files were given"
	fi
	if [ -n "${store_args}" ]; then
		# an unknown credential fails here, before any ssh or download
		has_cred=1
		query_cred "${cred}" || has_cred=0
		store_helper="$(store_helper)" || exit 1
	fi

	_vm_target
	_rc=0
	_guest sudo -n true 2>/dev/null || _rc=$?
	if [ "${_rc}" -eq 255 ]; then
		die "can't reach VM '${name}' over ssh as ${lp_user} (port ${port}) — is the guest up, with your key for ${lp_user}?"
	elif [ "${_rc}" -ne 0 ]; then
		die "sudo in VM '${name}' asks ${lp_user} for a password — idiot vm install needs passwordless sudo"
	fi

	# store snaps: downloaded here, for the VM's architecture
	store_snaps=''
	if [ -n "${store_args}" ]; then
		arch="$(vm_conf_get "${name}" arch)"
		[ -n "${arch}" ] || arch="$(uname_to_snap_arch)"
		store_lbl="$(store_label "${UBUNTU_STORE_ID:-}")"
		[ "${has_cred}" -eq 1 ] ||
			say "${DIM}No active credential: downloading anonymously (idiot auth use, or --cred <name>)${RESET}"
		_oifs="${IFS}"
		IFS='
'
		for _s in ${store_args}; do
			IFS="${_oifs}"
			_c="${_s#* }"
			[ "${_c}" != - ] || _c="${channel:-stable}"
			_store_fetch "${_s%% *}" "${_c}"
		done
		IFS="${_oifs}"
	fi

	# assertions next to every snap: an asserted install, else --dangerous
	unasserted=''
	_oifs="${IFS}"
	IFS='
'
	for _f in ${files}; do
		[ -f "${_f%.snap}.assert" ] || unasserted="${unasserted:+${unasserted}, }${_f##*/}"
	done
	IFS="${_oifs}"

	gdir="$(_guest mktemp -d)" || die "could not create a directory in VM '${name}'"
	trap _install_cleanup EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM

	# copy (scp takes the files one per word; names are kept)
	_oifs="${IFS}"
	IFS='
'
	set --
	for _f in ${files}; do
		set -- "$@" "${_f}"
		[ ! -f "${_f%.snap}.assert" ] || set -- "$@" "${_f%.snap}.assert"
	done
	IFS="${_oifs}"
	say "Copying $(printf '%s' "${files}" | wc -l) snap(s) into VM ${BOLD}${name}${RESET}"
	VM_SSH_EXTRA='-o BatchMode=yes -q' vm_scp "${port}" "${lp_user}" "$@" "localhost:${gdir}/" >&2 ||
		die "copying into VM '${name}' failed"

	# the guest's paths, the asserts acknowledged, and the snaps' names
	set --
	snap_names=''
	_oifs="${IFS}"
	IFS='
'
	for _f in ${files}; do
		_g="${gdir}/${_f##*/}"
		if [ -z "${unasserted}" ] && [ "${dangerous}" -eq 0 ]; then
			_guest sudo -n snap ack "${_g%.snap}.assert" >&2 ||
				die "the guest's snapd refused ${_f%.snap}.assert"
		fi
		_n="$(_guest snap info "${_g}" 2>/dev/null | sed -n 's/^name: *//p')"
		snap_names="${snap_names:+${snap_names} }${_n:-${_f##*/}}"
		set -- "$@" "${_g}"
	done
	IFS="${_oifs}"
	if [ -n "${unasserted}" ] && [ "${dangerous}" -eq 0 ]; then
		say "${DIM}No assertions for ${unasserted}: installing with --dangerous${RESET}"
		[ -z "${store_snaps}" ] ||
			say "${YELLOW}warning:${RESET} ${store_snaps} install without their store revision in this change — install them on their own to keep it"
		dangerous=1
	fi
	[ "${dangerous}" -eq 0 ] || flags="${flags} --dangerous"

	# shellcheck disable=SC2086 # flags are words
	change="$(_guest sudo -n snap install --no-wait ${flags} "$@")" ||
		die "snapd refused to install into VM '${name}'"
	change="$(printf '%s' "${change}" | tr -dc '0-9')"
	say "Installing ${BOLD}${snap_names}${RESET} into VM ${BOLD}${name}${RESET} ${DIM}(change ${change})${RESET}"

	# follow the change; a lost connection (255) is the guest rebooting
	while :; do
		_rc=0
		_t=''
		[ ! -t 2 ] || _t='-t'
		VM_SSH_EXTRA="-o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=5 ${_t}" \
			vm_ssh "${port}" "${lp_user}" snap watch "${change}" >&2 || _rc=$?
		if [ "${_rc}" -eq 255 ]; then
			say "Guest rebooting — waiting for ssh ${DIM}(up to ${timeout}s)${RESET}"
			_await_guest "${timeout}"
			continue
		fi
		status="$(_guest snap changes 2>/dev/null | awk -v id="${change}" '$1 == id { print $2 }')" || status=''
		case "${status}" in
		Done) break ;;
		Error | Undone | Hold)
			say "${RED}Change ${change} failed${RESET} (${status}):"
			_guest snap change "${change}" >&2 || :
			exit 1
			;;
		'')
			# the connection broke between watch and changes
			_await_guest "${timeout}"
			;;
		*) sleep 1 ;;
		esac
	done

	for _n in ${snap_names}; do
		_l="$(_guest snap list "${_n}" 2>/dev/null | awk 'NR == 2 { print $1 " " $2 " (" $3 ")" }')"
		say "Installed ${BOLD}${_l:-${_n}}${RESET}"
	done
}

do_logs() {
	name=''
	follow=0
	lines=''
	snap=''
	console=0
	previous=0
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm logs [--name <name>] [<snap>[.<app>]] [-f] [-n <lines>]"
			say "       idiot vm logs --console [--name <name>] [-f] [--previous]"
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM to read (default: the running one)"
			help_option "-f, --follow" "Keep printing new entries"
			help_option "-n <lines>" "Only the last <lines> (default: 10 for a snap)"
			help_option "--console" "The serial console log instead (running or stopped VM)"
			help_option "--previous" "With --console: the previous boot's"
			echo >&2
			say "A snap's service logs (snap logs), or without a snap the guest's whole"
			say "journal for the current boot, on stdout. --console prints what the"
			say "guest wrote to its serial console, from the firmware on; without a"
			say "name it reads the only running VM, or the only VM."
			exit 0
			;;
		--console) console=1 ;;
		--previous) previous=1 ;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		-f | --follow) follow=1 ;;
		-n)
			case "${2:-}" in
			'' | *[!0-9]*) die "-n requires a number of lines" ;;
			esac
			lines="${2}"
			shift
			;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ -z "${snap}" ] || die "usage: idiot vm logs [--name <name>] [<snap>[.<app>]] [-f] [-n <lines>]"
			snap="${1}"
			;;
		esac
		shift
	done
	if [ "${console}" -eq 1 ]; then
		[ -z "${snap}" ] || die "a snap can't be given with --console: the console log is the whole guest's"
		[ -z "${lines}" ] || die "-n can't be given with --console"
		_cl_which=serial.log
		[ "${previous}" -eq 0 ] || _cl_which=serial.log.1
		_console_log "${name}" "${_cl_which}" "${follow}"
		return
	fi
	[ "${previous}" -eq 0 ] || die "--previous goes with --console"
	_vm_target

	if [ -n "${snap}" ]; then
		set -- sudo -n snap logs "-n=${lines:-10}"
		[ "${follow}" -eq 0 ] || set -- "$@" -f
		set -- "$@" "${snap}"
	else
		set -- sudo -n journalctl -b --no-pager
		[ -z "${lines}" ] || set -- "$@" -n "${lines}"
		[ "${follow}" -eq 0 ] || set -- "$@" -f
	fi
	# the journal is the data asked for: stdout, unlike idiot vm ssh
	VM_SSH_EXTRA='-o BatchMode=yes -o ConnectTimeout=5' vm_ssh "${port}" "${lp_user}" "$@"
}

main() {
	case "${1:-}" in
	"") do_run --help ;;
	boot)
		shift
		do_run "$@"
		;;
	install)
		shift
		do_install "$@"
		;;
	logs)
		shift
		do_logs "$@"
		;;
	list)
		shift
		do_list "$@"
		;;
	stop)
		shift
		do_stop "$@"
		;;
	reset)
		shift
		do_reset "$@"
		;;
	delete)
		shift
		do_delete "$@"
		;;
	snapshot)
		shift
		do_snapshot "$@"
		;;
	console-log)
		shift
		do_console_log "$@"
		;;
	ssh)
		shift
		do_ssh "$@"
		;;
	scp)
		shift
		do_scp "$@"
		;;
	vars)
		shift
		do_vars "$@"
		;;
	tpm)
		shift
		do_tpm "$@"
		;;
	*) do_run "$@" ;;
	esac
}
main "$@"
