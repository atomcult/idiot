#!/usr/bin/env sh
# cmd/vm - launch and connect to a QEMU VM
# idiot: host

. "$(dirname "${0}")/../share/common.sh"
include arch.sh
include lp.sh
include vm-firmware.sh
include vm.sh

# Return the first path from the argument list that exists as a regular file
find_first() {
	for p in "$@"; do
		[ -f "${p}" ] && {
			printf '%s' "${p}"
			return 0
		}
	done
	return 1
}

# Sets fw_code and fw_vars_template for arch $1, with secure boot when $2 is
# 1, from share/vm-firmware.sh's table. The host's qemu boots the host's
# firmware, or the vm component's when the host has none; the component's
# qemu boots only the component's.
setup_firmware() {
	_sf_pkg="$(vm_firmware_package "${1}")" ||
		die "UEFI firmware is not supported for architecture: ${1}"
	[ "${2}" -eq 0 ] || vm_firmware_secboot "${1}" ||
		say "${DIM}No secure boot firmware exists for ${1}: booting without secure boot.${RESET}"
	fw_code="$(_find_firmware "${1}" "${2}" code)" ||
		_no_firmware "${1}" "${2}" "${_sf_pkg}"
	fw_vars_template="$(_find_firmware "${1}" "${2}" vars)" ||
		_no_firmware "${1}" "${2}" "${_sf_pkg}"
}

# The first firmware file for arch $1, secure boot $2, $3 code|vars.
_find_firmware() {
	if [ -z "${qemu_comp}" ]; then
		_ff_roots="/ ${vm_comp}"
	else
		_ff_roots="${qemu_comp}"
	fi
	for _ff_root in ${_ff_roots}; do
		for _ff_path in $(vm_firmware "${1}" "${2}" "${3}"); do
			_ff_file="${_ff_root%/}${_ff_path}"
			if [ -f "${_ff_file}" ]; then
				printf '%s' "${_ff_file}"
				return 0
			fi
		done
	done
	return 1
}

# Die because arch $1's firmware (secure boot $2, package $3) is missing.
_no_firmware() {
	_nf_what='UEFI firmware'
	[ "${2}" -eq 0 ] || ! vm_firmware_secboot "${1}" || _nf_what='UEFI secure boot firmware'
	if [ -n "${qemu_comp}" ]; then
		die "${_nf_what} for ${1} is missing from the vm component — reinstall it: snap install $(snap_instance)+vm"
	elif [ -n "$(snap_root)" ]; then
		die "${_nf_what} not found — install the ${3} package, or: snap install $(snap_instance)+vm"
	else
		die "${_nf_what} not found — install the ${3} package"
	fi
}

# The package providing qemu-system-$1.
_qemu_package() {
	case "${1}" in
	x86_64 | i386) printf 'qemu-system-x86' ;;
	aarch64 | arm) printf 'qemu-system-arm' ;;
	riscv64) printf 'qemu-system-misc' ;;
	*) printf 'qemu-system' ;;
	esac
}

# Finds qemu for arch $arch (the host's first, see tool_path). Sets
# qemu_path; vm_comp (the installed vm component, or empty); qemu_comp (that
# component when it's the one running, else empty); and qemu_env and
# qemu_data_flags, which point the component's qemu at its own modules and
# ROMs (it was built for /usr, which on the host is another qemu or none).
_find_qemu() {
	_fq_name="$(snap_arch_to_qemu "${arch}")"
	vm_comp="$(snap_component_dirs | sed -n '/\/vm$/p')"
	qemu_path="$(tool_path "qemu-system-${_fq_name}")" ||
		missing_tool "qemu-system-${_fq_name}" "install the $(_qemu_package "${_fq_name}") package"
	qemu_comp=''
	qemu_env=''
	qemu_data_flags=''
	[ -n "${vm_comp}" ] || return 0
	case "${qemu_path}" in
	"${vm_comp}"/*) ;;
	*) return 0 ;;
	esac
	qemu_comp="${vm_comp}"
	# Ubuntu's qemu searches these for ROMs (its --firmwarepath)
	for _fq_dir in usr/share/qemu usr/share/seabios usr/lib/ipxe/qemu; do
		[ ! -d "${qemu_comp}/${_fq_dir}" ] ||
			qemu_data_flags="${qemu_data_flags} -L ${qemu_comp}/${_fq_dir}"
	done
	# the modules dir (usr/lib/<triplet>/qemu), not usr/lib/ipxe/qemu's ROMs
	for _fq_mod in "${qemu_comp}"/usr/lib/*/qemu/accel-*.so; do
		[ -f "${_fq_mod}" ] || continue
		qemu_env="env QEMU_MODULE_DIR=${_fq_mod%/*}"
		break
	done
}

# TPM passthrough device type differs between x86 (ISA bus) and everything else
tpm_device_for_arch() {
	case "${1}" in
	amd64 | i386) printf 'tpm-tis' ;;
	*) printf 'tpm-tis-device' ;;
	esac
}

# Sets port for ssh/scp: --port as given, else the recorded ssh port of
# VM $name (or of the only running VM).
_vm_port() {
	[ -z "${port}" ] || return 0
	name="$(vm_resolve "${name}")" || exit 1
	vm_running "${name}" || die "VM '${name}' is not running — boot it: idiot vm --name ${name}"
	port="$(vm_conf_get "${name}" ssh_port)"
}

do_ssh() {
	port=''
	name=''

	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm ssh [--name <name> | --port <port>] [ssh-args...]"
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM to connect to (default: the running one)"
			help_option "--port <port>" "Connect to this host port instead"
			echo >&2
			say "The Launchpad username is used as the SSH user."
			say "Set it with: ${CYAN}eval \"\$(idiot lp set <username>)\"${RESET}"
			exit 0
			;;
		--)
			shift
			break
			;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		--port)
			[ -n "${2:-}" ] || die "--port requires an argument"
			port="${2}"
			shift
			;;
		-*) die "unknown option: ${1}" ;;
		*) break ;;
		esac
		shift
	done

	lp_user="$(require_lp_user)" || exit 1
	_vm_port

	exec ssh \
		-p "${port}" \
		-l "${lp_user}" \
		-o StrictHostKeyChecking=no \
		-o UserKnownHostsFile=/dev/null \
		-o LogLevel=ERROR \
		localhost "$@" >&2
}

do_scp() {
	port=''
	name=''

	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm scp [--name <name> | --port <port>] <src> <dst>"
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM to copy to/from (default: the running one)"
			help_option "--port <port>" "Connect to this host port instead"
			echo >&2
			say "Use ${BOLD}vm:${RESET} as an alias for the guest host. The Launchpad username"
			say "is used as the SSH user (set with ${CYAN}idiot lp set${RESET})."
			echo >&2
			help_heading "Examples:"
			say "  ${CYAN}idiot vm scp${RESET} ./gadget.snap ${BOLD}vm${RESET}:/home/user/"
			say "  ${CYAN}idiot vm scp${RESET} ${BOLD}vm${RESET}:/var/log/syslog ."
			exit 0
			;;
		--)
			shift
			break
			;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		--port)
			[ -n "${2:-}" ] || die "--port requires an argument"
			port="${2}"
			shift
			;;
		-*) die "unknown option: ${1}" ;;
		*) break ;;
		esac
		shift
	done

	[ $# -ge 2 ] || die "usage: idiot vm scp [--name <name> | --port <port>] <src> <dst>"

	lp_user="$(require_lp_user)" || exit 1
	_vm_port

	# Rewrite vm: → localhost: in all path arguments
	_orig=$#
	for _arg in "$@"; do
		case "${_arg}" in
		vm:*) set -- "$@" "localhost:${_arg#vm:}" ;;
		*) set -- "$@" "${_arg}" ;;
		esac
	done
	shift "${_orig}"

	exec scp \
		-P "${port}" \
		-o StrictHostKeyChecking=no \
		-o UserKnownHostsFile=/dev/null \
		-o LogLevel=ERROR \
		-o "User=${lp_user}" \
		"$@" >&2
}

# Sets state_dir and vm_name from vars/tpm arguments $1 $2: --name <name>
# or a state directory; with $3 = any, none means the only running VM.
# $4: the subcommand, for the usage message.
_state_dir_arg() {
	state_dir=''
	_sda_name=''
	case "${1:-}" in
	--name)
		[ -n "${2:-}" ] || die "--name requires an argument"
		_sda_name="$(vm_resolve "${2}")" || exit 1
		;;
	--name=*)
		_sda_name="$(vm_resolve "${1#--name=}")" || exit 1
		;;
	-*) die "unknown option: ${1}" ;;
	'') ;;
	*) state_dir="${1}" ;;
	esac
	if [ -z "${state_dir}" ] && [ -z "${_sda_name}" ]; then
		[ "${3:-}" = any ] || die "usage: idiot vm ${4} --name <name> | <state-dir>"
		_sda_name="$(vm_resolve)" || exit 1
	fi
	[ -z "${_sda_name}" ] || state_dir="$(vm_dir "${_sda_name}")"
	vm_name="${_sda_name}"
}

do_vars() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot vm vars [--name <name> | <state-dir>]"
		echo >&2
		say "Lists the UEFI variables saved in a VM's state (fw_vars.fd), with the"
		say "certificates and hashes enrolled in PK, KEK, db and dbx. Without a"
		say "name or directory: the running VM's."
		exit 0
		;;
	esac

	_state_dir_arg "${1:-}" "${2:-}" any vars
	[ -d "${state_dir}" ] || die "state directory not found: ${state_dir}"

	vars_file="${state_dir}/fw_vars.fd"
	[ -f "${vars_file}" ] || die "no fw_vars.fd in ${state_dir} — was the VM booted with UEFI firmware?"

	# efi-readvar can't read a file (only the running machine's variables),
	# so idiot reads the store itself; the listing is data, on stdout
	require python3
	python3 "${IDIOT_ROOT}/share/uefi-vars.py" "${vars_file}"
}

do_tpm() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot vm tpm --name <name> | <state-dir>"
		echo >&2
		say "Starts an swtpm instance against a stopped VM's TPM state for offline"
		say "inspection with tpm2-tools. Runs until interrupted."
		echo >&2
		say "Example:"
		say "  ${DIM}# in one terminal:${RESET}"
		say "  ${CYAN}idiot vm tpm${RESET} --name gadget"
		say "  ${DIM}# in another:${RESET}"
		say "  ${CYAN}tpm2_pcrread${RESET} --tcti=swtpm:path=${IDIOT_VM_DIR}/gadget/inspect.sock"
		exit 0
		;;
	esac

	_state_dir_arg "${1:-}" "${2:-}" '' tpm
	[ -d "${state_dir}" ] || die "state directory not found: ${state_dir}"
	# a running VM's swtpm holds the state
	[ -z "${vm_name}" ] || ! vm_running "${vm_name}" ||
		die "VM '${vm_name}' is running, and its swtpm holds the TPM state — stop it first: idiot vm stop ${vm_name}"

	# Check for existing TPM state files
	found=0
	for f in "${state_dir}"/tpm2-*.permall "${state_dir}"/tpm2-*.volatile; do
		[ -f "${f}" ] && {
			found=1
			break
		}
	done
	[ "${found}" -eq 1 ] || die "no TPM state found in ${state_dir} — was the VM booted with --tpm?"

	require swtpm "install the swtpm package"

	sock="${state_dir}/inspect.sock"
	rm -f "${sock}"

	say "Starting swtpm on ${BOLD}${sock}${RESET} ${DIM}(Ctrl-C to stop)${RESET}"
	say "Connect with: ${CYAN}--tcti=swtpm:path=${sock}${RESET}"
	echo >&2

	swtpm socket \
		--tpmstate "dir=${state_dir}" \
		--ctrl "type=unixio,path=${sock}" \
		--tpm2 \
		--flags not-need-init,startup-clear
}

# Sets machine_flags and kvm_flags for the active arch.
_build_machine_flags() {
	case "${arch}" in
	amd64 | i386)
		machine_flags='-machine q35 -global ICH9-LPC.disable_s3=1'
		;;
	arm64 | armhf | riscv64)
		machine_flags='-machine virt'
		;;
	*)
		machine_flags=''
		;;
	esac

	# Without KVM, emulate the most capable CPU: QEMU's default for arm64
	# virt is the 32-bit cortex-a15, which cannot boot a 64-bit guest.
	if [ "${arch}" = "$(uname_to_snap_arch)" ] && [ -e /dev/kvm ]; then
		kvm_flags='-enable-kvm -cpu host'
	else
		kvm_flags='-cpu max'
	fi
}

# Stops the VM's swtpm (if started).
_cleanup() {
	[ -z "${tpm_pidfile:-}" ] || vm_swtpm_stop "${tpm_pidfile%/*}"
}

# Uses the VM's state directory for its firmware, TPM and disk state.
# Sets workdir and installs the cleanup trap.
_setup_workdir() {
	workdir="$(vm_dir "${name}")"
	trap _cleanup EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	trap 'exit 129' HUP
}

# Makes the VM's name refer to --state-dir $state_dir: a symlink from its
# place under IDIOT_VM_DIR. Dies when the name already refers elsewhere.
_link_state_dir() {
	mkdir -p "${state_dir}" || die "cannot create state directory: ${state_dir}"
	_lsd_abs="$(cd "${state_dir}" && pwd)"
	_lsd_link="$(vm_dir "${name}")"
	if [ -L "${_lsd_link}" ]; then
		[ "$(readlink "${_lsd_link}")" = "${_lsd_abs}" ] ||
			die "VM '${name}' keeps its state in $(readlink "${_lsd_link}") — use that --state-dir, or start over: idiot vm delete ${name}"
	elif [ -e "${_lsd_link}" ]; then
		die "VM '${name}' keeps its state in ${_lsd_link} — use another --name, or start over: idiot vm delete ${name}"
	else
		mkdir -p "${IDIOT_VM_DIR}"
		ln -s "${_lsd_abs}" "${_lsd_link}"
	fi
}

# Dies when a setting fixed at creation ($1 in vm.conf, given as $2 on the
# command line, if at all) differs from the recorded one; $3 describes the
# recorded setting for the message.
_check_fixed() {
	[ -n "${2}" ] || return 0
	[ "$(vm_conf_get "${name}" "${1}")" = "${2}" ] ||
		die "VM '${name}' ${3} — use another --name, or start over: idiot vm delete ${name}"
}

# Dies when a socket in the state directory would be longer than a UNIX
# socket path may be (107 bytes).
_check_socket_paths() {
	for _csp in swtpm.sock qmp.sock; do
		_csp="${workdir}/${_csp}"
		[ "${#_csp}" -le 107 ] ||
			die "the VM's state directory is too long a path for its sockets (${#_csp} > 107 bytes): ${workdir} — use a shorter --state-dir"
	done
}

# Sets disk_flags: the image itself with --in-place, else a qcow2 overlay
# backed by it, created on first boot (and after a reset). Dies when the
# image changed under an existing overlay.
_build_disk_flags() {
	if [ "${in_place}" -eq 1 ]; then
		disk_flags="file=${image},if=none,format=raw,id=disk1"
		return 0
	fi
	_bdf_overlay="${workdir}/disk.qcow2"
	_bdf_stat="$(stat -L -c '%s %Y' "${image}")"
	if [ -f "${_bdf_overlay}" ]; then
		[ "$(vm_conf_get "${name}" image_stat)" = "${_bdf_stat}" ] ||
			die "${image} changed since VM '${name}' was booted from it — start over from the new image with: idiot vm reset ${name}"
	else
		tool_path qemu-img >/dev/null ||
			missing_tool qemu-img "install the qemu-utils package"
		tool qemu-img create -q -f qcow2 -b "${image}" -F raw "${_bdf_overlay}" >&2 ||
			die "could not create the disk overlay ${_bdf_overlay}"
		vm_conf_set "${name}" image_stat "${_bdf_stat}"
	fi
	disk_flags="file=${_bdf_overlay},if=none,format=qcow2,id=disk1"
}

# Whether the VM boots from UEFI firmware we provide: always with secure
# boot, and without it on every arch but i386 (which keeps QEMU's BIOS).
_needs_firmware() {
	[ "${sb}" -eq 1 ] || [ "${arch}" != "i386" ]
}

# Sets fw_flags for UEFI (secure boot or not). No-ops when the VM uses the
# BIOS.
_build_fw_flags() {
	fw_flags=''
	_needs_firmware || return 0
	setup_firmware "${arch}" "${sb}"
	fw_vars="${workdir}/fw_vars.fd"
	# Reuse existing vars if present (allows persistent SB state across runs)
	[ -f "${fw_vars}" ] || cp "${fw_vars_template}" "${fw_vars}"
	fw_flags="-drive if=pflash,format=raw,unit=0,readonly=on,file=${fw_code}"
	fw_flags="${fw_flags} -drive if=pflash,format=raw,unit=1,file=${fw_vars}"
}

# Sets tpm_flags and starts a background swtpm daemon. No-ops when tpm=0.
_build_tpm_flags() {
	tpm_flags=''
	[ "${tpm}" -eq 1 ] || return
	require swtpm "install the swtpm package"
	tpm_sock="${workdir}/swtpm.sock"
	# _cleanup kills it by this pid when the VM exits
	tpm_pidfile="${workdir}/swtpm.pid"
	swtpm socket \
		--tpmstate "dir=${workdir}" \
		--ctrl "type=unixio,path=${tpm_sock}" \
		--tpm2 \
		--pid "file=${tpm_pidfile}" \
		--terminate \
		--daemon ||
		die "swtpm failed to start (UNIX socket paths are limited to 107 bytes: ${tpm_sock})"
	tpm_dev="$(tpm_device_for_arch "${arch}")"
	tpm_flags="-chardev socket,id=chrtpm,path=${tpm_sock}"
	tpm_flags="${tpm_flags} -tpmdev emulator,id=tpm0,chardev=chrtpm"
	tpm_flags="${tpm_flags} -device ${tpm_dev},tpmdev=tpm0"
}

do_run() {
	name=''
	image=''
	state_dir=''
	# empty: not given (fixed ones come from vm.conf, others too if recorded)
	arch=''
	sb=''
	in_place=''
	tpm=''
	gfx=''
	ssh_port=''
	ports=''

	# Parse arguments
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm [options] [<image>] [-- <qemu-args>]"
			echo >&2
			help_heading "Subcommands:"
			help_command "list" "List VMs"
			help_command "stop" "Shut a running VM down"
			help_command "reset" "Make a VM a freshly flashed device again"
			help_command "delete" "Remove a VM and its state"
			help_command "console-log" "Print a VM's serial console log"
			help_command "ssh" "SSH into a running VM"
			help_command "scp" "Copy files to/from a running VM"
			help_command "vars" "Inspect a VM's UEFI SB variables"
			help_command "tpm" "Inspect a VM's TPM state with tpm2-tools"
			echo >&2
			help_heading "Options:"
			help_option "--name <name>" "VM name (default: from the image file name)"
			help_option "--arch <arch>" "Target architecture (default: host)"
			help_option "--sb / --no-sb" "Enable/disable UEFI secure boot (default: sb)"
			help_option "--in-place" "Write the image itself (default: an overlay)"
			help_option "--tpm / --no-tpm" "Enable/disable TPM emulation"
			help_option "--gfx / --no-gfx" "Enable/disable display window (default: no-gfx)"
			help_option "--ssh-port <port>" "Host port for guest port 22 (default: 8022 or free)"
			help_option "--port <host:guest>" "Additional port mapping (repeatable)"
			help_option "--state-dir <dir>" "Keep the VM's state here"
			echo >&2
			say "Each VM keeps its disk overlay, UEFI variables and TPM state between runs,"
			say "in ${DIM}${IDIOT_VM_DIR}/<name>${RESET}; the image is never written unless"
			say "--in-place. Boot it again with ${CYAN}idiot vm --name <name>${RESET}. The image,"
			say "--arch, --sb and --in-place are fixed when a VM is created."
			exit 0
			;;
		--)
			shift
			break
			;;
		--name)
			[ -n "${2:-}" ] || die "--name requires an argument"
			name="${2}"
			shift
			;;
		--arch)
			[ -n "${2:-}" ] || die "--arch requires an argument"
			arch="${2}"
			shift
			;;
		--sb) sb=1 ;;
		--no-sb) sb=0 ;;
		--in-place) in_place=1 ;;
		--tpm) tpm=1 ;;
		--no-tpm) tpm=0 ;;
		--gfx) gfx=1 ;;
		--no-gfx) gfx=0 ;;
		--ssh-port)
			[ -n "${2:-}" ] || die "--ssh-port requires an argument"
			case "${2}" in
			*[!0-9]*) die "--ssh-port: expected a port number, got '${2}'" ;;
			esac
			ssh_port="${2}"
			shift
			;;
		--port)
			[ -n "${2:-}" ] || die "--port requires a host:guest mapping"
			case "${2}" in
			*[!0-9:]* | :* | *: | *:*:*) die "--port: expected host:guest, got '${2}'" ;;
			*:*) ;;
			*) die "--port: expected host:guest, got '${2}'" ;;
			esac
			ports="${ports:+${ports} }${2}"
			shift
			;;
		--state-dir)
			[ -n "${2:-}" ] || die "--state-dir requires a directory argument"
			state_dir="${2}"
			shift
			;;
		--state-dir=*)
			state_dir="${1#--state-dir=}"
			;;
		-*)
			die "unknown option: ${1}"
			;;
		*)
			[ -z "${image}" ] || die "unexpected argument: ${1}"
			image="${1}"
			;;
		esac
		shift
	done

	[ -n "${name}${image}" ] || die \
		"usage: idiot vm [--name <name>] [--arch <arch>] [--sb] [--in-place] [--tpm] [--no-gfx] \
[--ssh-port <port>] [--port <host:guest>] [--state-dir <dir>] [<image>] [-- <qemu-args>]"
	if [ -n "${image}" ]; then
		[ -f "${image}" ] || die "image not found: ${image}"
		image="$(cd "$(dirname "${image}")" && pwd)/${image##*/}"
	fi
	[ -n "${name}" ] || name="$(vm_name_from_image "${image}")"
	vm_validate_name "${name}"

	# the state directory and everything qemu, swtpm and idiot write there
	umask 077
	# before anything is written: a port that isn't free creates nothing
	prev_port="$(vm_conf_get "${name}" ssh_port)"
	ssh_port="$(vm_pick_ssh_port "${name}" "${ssh_port}")" || exit 1
	[ -z "${state_dir}" ] || _link_state_dir
	if vm_exists "${name}"; then
		! vm_running "${name}" ||
			die "VM '${name}' is running (ssh port $(vm_conf_get "${name}" ssh_port)) — connect with: idiot vm ssh --name ${name}"
		_check_fixed image "${image}" "was created from $(vm_conf_get "${name}" image)"
		_check_fixed arch "${arch}" "is $(vm_conf_get "${name}" arch)"
		[ "$(vm_conf_get "${name}" sb)" -eq 1 ] && _sb_was='with' || _sb_was='without'
		_check_fixed sb "${sb}" "was created ${_sb_was} secure boot"
		[ "$(vm_conf_get "${name}" in_place)" -eq 1 ] && _ip_was='writes its image in place' ||
			_ip_was='boots from an overlay'
		_check_fixed in_place "${in_place:-0}" "${_ip_was}"
		image="$(vm_conf_get "${name}" image)"
		arch="$(vm_conf_get "${name}" arch)"
		sb="$(vm_conf_get "${name}" sb)"
		in_place="$(vm_conf_get "${name}" in_place)"
		[ -n "${tpm}" ] || tpm="$(vm_conf_get "${name}" tpm)"
		[ -n "${gfx}" ] || gfx="$(vm_conf_get "${name}" gfx)"
		[ -n "${ports}" ] || ports="$(vm_conf_get "${name}" ports)"
		new_vm=0
	else
		[ -n "${image}" ] ||
			die "no VM named '${name}' — create it from an image: idiot vm --name ${name} <image>"
		mkdir -p "$(vm_dir "${name}")"
		[ -n "${arch}" ] || arch="$(uname_to_snap_arch)"
		vm_conf_set "${name}" image "${image}"
		vm_conf_set "${name}" arch "${arch}"
		vm_conf_set "${name}" sb "${sb:-1}"
		vm_conf_set "${name}" in_place "${in_place:-0}"
		new_vm=1
	fi
	sb="${sb:-1}"
	in_place="${in_place:-0}"
	tpm="${tpm:-0}"
	gfx="${gfx:-0}"
	vm_conf_set "${name}" tpm "${tpm}"
	vm_conf_set "${name}" gfx "${gfx}"
	vm_conf_set "${name}" ports "${ports}"
	[ -f "${image}" ] || die "image not found: ${image} (VM '${name}' was created from it)"

	_find_qemu
	_build_machine_flags
	_setup_workdir
	_check_socket_paths

	vm_conf_set "${name}" ssh_port "${ssh_port}"
	fwds="hostfwd=tcp::${ssh_port}-:22"
	for _p in ${ports}; do
		fwds="${fwds},hostfwd=tcp::${_p%%:*}-:${_p##*:}"
	done

	_build_disk_flags
	_build_fw_flags
	_build_tpm_flags

	[ "${gfx}" -eq 0 ] || [ -z "${qemu_comp}" ] ||
		say "${DIM}The bundled qemu has no display window: the console is here (serial).${RESET}"
	[ "${gfx}" -eq 1 ] && display_flags='' || display_flags='-display none'
	# the serial console stays on the terminal (Ctrl-a c: monitor, Ctrl-a x:
	# quit) and is logged; the previous boot's log is kept
	[ ! -f "${workdir}/serial.log" ] || mv -f "${workdir}/serial.log" "${workdir}/serial.log.1"
	rm -f "${workdir}/qmp.sock"

	if [ "${new_vm}" -eq 1 ]; then
		say "New VM ${BOLD}${name}${RESET}: its disk, UEFI variables and TPM state are kept in ${BOLD}$(cd "${workdir}" && pwd -P)${RESET}"
		if [ "${in_place}" -eq 1 ]; then
			say "${DIM}--in-place: the guest writes ${image}${RESET}"
		else
			say "${DIM}${image} is left as it is (the guest writes an overlay); start over with: idiot vm reset ${name}${RESET}"
		fi
	fi
	if [ -n "${prev_port}" ] && [ "${prev_port}" != "${ssh_port}" ]; then
		say "VM ${BOLD}${name}${RESET}: ssh port ${BOLD}${ssh_port}${RESET} ${DIM}(was ${prev_port})${RESET}"
	else
		say "VM ${BOLD}${name}${RESET}: ssh port ${BOLD}${ssh_port}${RESET}"
	fi

	# shellcheck disable=SC2086
	${qemu_env} "${qemu_path}" \
		${qemu_data_flags} \
		-smp "$(nproc)" \
		-m 2048 \
		${machine_flags} \
		${kvm_flags} \
		-net nic,model=virtio \
		-net "user,${fwds}" \
		${fw_flags} \
		-drive "${disk_flags}" \
		-device virtio-blk-pci,drive=disk1,bootindex=1 \
		${tpm_flags} \
		-chardev "stdio,id=con0,mux=on,logfile=${workdir}/serial.log" \
		-serial chardev:con0 \
		-mon chardev=con0,mode=readline \
		${display_flags} \
		-pidfile "${workdir}/qemu.pid" \
		-qmp "unix:${workdir}/qmp.sock,server=on,wait=off" \
		"$@" >&2
	qemu_rc=$?

	say "${DIM}VM ${name} stopped; its state is kept (boot again: idiot vm --name ${name})${RESET}"
	exit "${qemu_rc}"
}

do_list() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot vm list"
		echo >&2
		say "Prints each VM's name, image, architecture, state and ssh port."
		exit 0
		;;
	esac
	[ $# -eq 0 ] || die "usage: idiot vm list"
	_names="$(vm_names)"
	[ -n "${_names}" ] || {
		say "No VMs yet (boot one with: idiot vm <image>)"
		exit 0
	}
	printf '%s\n' "${_names}" | {
		printf '%-20s %-8s %-8s %-6s %s\n' NAME ARCH STATE PORT IMAGE
		while IFS= read -r _n; do
			vm_running "${_n}" && _state=running || _state=stopped
			printf '%-20s %-8s %-8s %-6s %s\n' "${_n}" "$(vm_conf_get "${_n}" arch)" \
				"${_state}" "$(vm_conf_get "${_n}" ssh_port)" "$(vm_conf_get "${_n}" image)"
		done
	}
}

# Waits up to $2 seconds for process $1 to exit; fails if it's still there.
_wait_exit() {
	_we=0
	while kill -0 "${1}" 2>/dev/null; do
		[ "${_we}" -lt "${2}" ] || return 1
		sleep 1
		_we=$((_we + 1))
	done
}

# Sends QMP command $2 to VM $1; fails without python3 or when qemu won't.
_qmp() {
	command -v python3 >/dev/null 2>&1 || return 1
	python3 "${IDIOT_ROOT}/share/vm-qmp.py" "$(vm_dir "${1}")/qmp.sock" "${2}" >/dev/null
}

do_stop() {
	timeout=60
	force=0
	name=''
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm stop [--timeout <seconds>] [--force] [<name>]"
			echo >&2
			help_heading "Options:"
			help_option "--timeout <seconds>" "Wait this long for the guest (default: 60)"
			help_option "--force" "Quit qemu without asking the guest"
			echo >&2
			say "Presses the VM's power button and waits for the guest to shut down;"
			say "then makes qemu quit. Without a name: the only running VM."
			exit 0
			;;
		--timeout)
			case "${2:-}" in
			'' | *[!0-9]*) die "--timeout requires a number of seconds" ;;
			esac
			timeout="${2}"
			shift
			;;
		--force) force=1 ;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ -z "${name}" ] || die "usage: idiot vm stop [--timeout <seconds>] [--force] [<name>]"
			name="${1}"
			;;
		esac
		shift
	done
	name="$(vm_resolve "${name}")" || exit 1
	pid="$(vm_pid "${name}")" || {
		say "VM ${BOLD}${name}${RESET} is not running"
		exit 0
	}

	if [ "${force}" -eq 0 ]; then
		if _qmp "${name}" system_powerdown; then
			say "Shutting VM ${BOLD}${name}${RESET} down ${DIM}(up to ${timeout}s)${RESET}"
			_wait_exit "${pid}" "${timeout}" ||
				say "${YELLOW}warning:${RESET} the guest did not shut down within ${timeout}s — quitting qemu"
		else
			command -v python3 >/dev/null 2>&1 ||
				say "${DIM}a graceful shutdown needs python3: quitting qemu${RESET}"
		fi
	fi
	if kill -0 "${pid}" 2>/dev/null; then
		{ _qmp "${name}" quit && _wait_exit "${pid}" 2; } ||
			{ kill -TERM "${pid}" 2>/dev/null && _wait_exit "${pid}" 2; } ||
			{ kill -KILL "${pid}" 2>/dev/null && _wait_exit "${pid}" 2; } ||
			die "qemu (pid ${pid}) did not exit"
	fi
	# normally gone with qemu (--terminate) or the launching idiot vm
	vm_swtpm_stop "$(vm_dir "${name}")"
	say "Stopped VM ${BOLD}${name}${RESET}"
}

# Dies unless VM $1 is stopped.
_require_stopped() {
	! vm_running "${1}" ||
		die "VM '${1}' is running — stop it first: idiot vm stop ${1}"
}

do_reset() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot vm reset <name>"
		echo >&2
		say "Discards a stopped VM's disk overlay, UEFI variables, TPM state and"
		say "serial logs, so that it next boots as a freshly flashed device."
		exit 0
		;;
	esac
	[ $# -eq 1 ] || die "usage: idiot vm reset <name>"
	name="$(vm_resolve "${1}")" || exit 1
	_require_stopped "${name}"
	_d="$(vm_dir "${name}")"
	rm -f "${_d}/disk.qcow2" "${_d}/fw_vars.fd" "${_d}"/tpm2-* \
		"${_d}/serial.log" "${_d}/serial.log.1" "${_d}/swtpm.pid" "${_d}/swtpm.sock" \
		"${_d}/qemu.pid" "${_d}/qmp.sock"
	say "Reset VM ${BOLD}${name}${RESET}: it boots as a freshly flashed device"
	[ "$(vm_conf_get "${name}" in_place)" -ne 1 ] ||
		say "${YELLOW}warning:${RESET} VM '${name}' writes $(vm_conf_get "${name}" image) in place: the image itself can't be reset"
}

do_delete() {
	yes=0
	name=''
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm delete [--yes] <name>"
			echo >&2
			say "Removes a stopped VM and its state. The image is not touched."
			exit 0
			;;
		--yes | -y) yes=1 ;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ -z "${name}" ] || die "usage: idiot vm delete [--yes] <name>"
			name="${1}"
			;;
		esac
		shift
	done
	[ -n "${name}" ] || die "usage: idiot vm delete [--yes] <name>"
	name="$(vm_resolve "${name}")" || exit 1
	_require_stopped "${name}"
	_d="$(vm_dir "${name}")"
	_real="$(cd "${_d}" && pwd -P)"

	if [ "${yes}" -eq 0 ]; then
		[ -t 0 ] || die "deleting VM '${name}' needs confirmation — run it on a terminal, or pass --yes"
		printf '%s' "Delete VM ${BOLD}${name}${RESET} and its state in ${_real}? [y/N] " >&2
		read -r _answer || _answer=''
		case "${_answer}" in
		y | Y | yes) ;;
		*)
			say "Nothing deleted"
			exit 0
			;;
		esac
	fi
	if [ -L "${_d}" ]; then
		# a --state-dir: only what idiot put there, and the dir if now empty
		rm -f "${_d}/vm.conf" "${_d}/disk.qcow2" "${_d}/fw_vars.fd" "${_d}"/tpm2-* \
			"${_d}/serial.log" "${_d}/serial.log.1" "${_d}/swtpm.pid" "${_d}/swtpm.sock" \
			"${_d}/qemu.pid" "${_d}/qmp.sock" "${_d}/inspect.sock"
		rmdir "${_real}" 2>/dev/null || say "${DIM}Kept ${_real}: it holds other files${RESET}"
		rm -f "${_d}"
	else
		rm -rf "${_d}"
	fi
	say "Deleted VM ${BOLD}${name}${RESET}"
}

do_console_log() {
	follow=0
	which=serial.log
	name=''
	while [ $# -gt 0 ]; do
		case "${1}" in
		-h | --help | help)
			help_heading "Usage:" "idiot vm console-log [-f] [--previous] [<name>]"
			echo >&2
			help_heading "Options:"
			help_option "-f, --follow" "Keep printing what the guest writes"
			help_option "--previous" "The previous boot's log"
			echo >&2
			say "Without a name: the only running VM, or the only VM."
			exit 0
			;;
		-f | --follow) follow=1 ;;
		--previous) which=serial.log.1 ;;
		-*) die "unknown option: ${1}" ;;
		*)
			[ -z "${name}" ] || die "usage: idiot vm console-log [-f] [--previous] [<name>]"
			name="${1}"
			;;
		esac
		shift
	done
	name="$(vm_resolve "${name}" any)" || exit 1
	log="$(vm_dir "${name}")/${which}"
	[ -f "${log}" ] || {
		[ "${which}" = serial.log ] && die "VM '${name}' has no console log yet — boot it: idiot vm --name ${name}"
		die "VM '${name}' has no log of a previous boot"
	}
	if [ "${follow}" -eq 0 ]; then
		cat "${log}"
	elif _pid="$(vm_pid "${name}")"; then
		exec tail -n +1 -f --pid="${_pid}" "${log}"
	else
		exec tail -n +1 -f "${log}"
	fi
}

main() {
	case "${1:-}" in
	"") do_run --help ;;
	list)
		shift
		do_list "$@"
		;;
	stop)
		shift
		do_stop "$@"
		;;
	reset)
		shift
		do_reset "$@"
		;;
	delete)
		shift
		do_delete "$@"
		;;
	console-log)
		shift
		do_console_log "$@"
		;;
	ssh)
		shift
		do_ssh "$@"
		;;
	scp)
		shift
		do_scp "$@"
		;;
	vars)
		shift
		do_vars "$@"
		;;
	tpm)
		shift
		do_tpm "$@"
		;;
	*) do_run "$@" ;;
	esac
}
main "$@"
