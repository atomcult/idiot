#!/usr/bin/env sh
# cmd/process/show - display a process checklist
# Usage: idiot process show [<name>]

. "$(dirname "${0}")/../../lib/common.sh"

print_process() {
    while IFS= read -r line; do
        case "${line}" in
            '#'[!#]*)
                say "${BOLD}${BLUE}${line#\# }${RESET}" ;;
            '## '*)
                echo >&2
                say "${BOLD}${CYAN}${line#\#\# }${RESET}" ;;
            '')
                echo >&2 ;;
            *)
                say "  ${line}" ;;
        esac
    done < "${1}"
}

main() {
    case "${1:-}" in
        -h|--help|help)
            help_heading "Usage:" "idiot process show [<name>]"
            exit 0 ;;
    esac

    proc_dir="${IDIOT_DATA_DIR}/processes"
    [ -d "${proc_dir}" ] || die "process definitions not found at ${proc_dir}"

    name="${1:-}"

    [ -n "${name}" ] || {
        command -v fzf > /dev/null 2>&1 \
            || die "a process name is required (fzf not found for interactive selection)"

        files=$(find "${proc_dir}" -maxdepth 1 -type f | sort | sed "s|${proc_dir}/||")
        [ -n "${files}" ] || die "no process definitions found"

        export proc_dir
        # shellcheck disable=SC2016
        preview_cmd='sed -n "2p" "${proc_dir}/{}"'
        name=$(printf '%s\n' "${files}" | fzf --prompt="process> " --preview="${preview_cmd}") \
            || exit 0
    }

    proc_file="${proc_dir}/${name}"
    [ -f "${proc_file}" ] || die "process '${name}' not found"

    echo >&2
    print_process "${proc_file}"
    echo >&2
}
main "$@"
