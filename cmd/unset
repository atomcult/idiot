#!/usr/bin/env sh
# cmd/unset - unset an environment variable in the calling shell
# Usage: idiot unset <VAR> [VAR...]
# Outputs: eval-able shell code

. "$(dirname "$0")/../lib/common.sh"

if [ $# -eq 0 ]; then
    die "usage: idiot unset <VAR> [VAR...]"
fi

for var; do
    case "$var" in
        [0-9]*|*[!A-Za-z0-9_]*)
            die "invalid variable name: $var"
            ;;
    esac
    state_untrack "$var"
    printf 'unset %s\n' "$var"
done
