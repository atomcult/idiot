#!/usr/bin/env sh
# cmd/todo/remove - delete a to-do list
# Usage: idiot todo remove [<name>]

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot todo remove [<name>]"; exit 0 ;;
    esac

    name="${1:-}"

    [ -n "${name}" ] || {
        command -v fzf > /dev/null 2>&1 \
            || die "a list name is required (fzf not found for interactive selection)"

        [ -d "${IDIOT_TODO_DIR}" ] || die "no to-do lists found"
        files=$(find "${IDIOT_TODO_DIR}" -maxdepth 1 -type f ! -name '.*' | sort | sed "s|${IDIOT_TODO_DIR}/||")
        [ -n "${files}" ] || die "no to-do lists found"

        export IDIOT_TODO_DIR
        preview_cmd="$(file_preview_cmd IDIOT_TODO_DIR)"
        name=$(printf '%s\n' "${files}" | fzf --prompt="remove todo> " --preview="${preview_cmd}") || exit 0
    }

    list_file="${IDIOT_TODO_DIR}/${name}"
    [ -f "${list_file}" ] || die "list '${name}' not found"

    rm "${list_file}"
    say "Removed '${BOLD}${name}${RESET}'"
}
main "$@"
