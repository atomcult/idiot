#!/usr/bin/env sh
# cmd/todo/list - list saved to-do lists
# Usage: idiot todo list

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help) help_heading "Usage:" "idiot todo list"; exit 0 ;;
    esac

    [ -d "${IDIOT_TODO_DIR}" ] || { say "${DIM}No to-do lists yet.${RESET}"; exit 0; }

    found=0
    for f in "${IDIOT_TODO_DIR}"/*; do
        [ -f "${f}" ] || continue
        found=1
        name="$(basename "${f}")"
        total=$(grep -c '^\[.\] ' "${f}" 2>/dev/null || printf '0')
        done_count=$(grep -c '^\[x\] ' "${f}" 2>/dev/null || printf '0')
        gap=$(( 24 - ${#name} ))
        [ "${gap}" -lt 2 ] && gap=2
        say "  ${CYAN}${name}${RESET}$(printf '%*s' "${gap}" '')${DIM}${done_count}/${total} done${RESET}"
    done

    [ "${found}" -eq 1 ] || say "${DIM}No to-do lists yet.${RESET}"
}
main "$@"
