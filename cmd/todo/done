#!/usr/bin/env sh
# cmd/todo/done - mark an item as complete
# Usage: idiot todo done <name> [<item-number>]

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    case "${1:-}" in
        -h|--help|help)
            help_heading "Usage:" "idiot todo done <name> [<item-number>]"
            echo >&2
            say "Mark item N as done. Item numbers are shown by 'idiot todo show'."
            say "If no number is given and fzf is available, opens an interactive picker."
            exit 0 ;;
    esac

    name="${1:-}"
    item_num="${2:-}"

    [ -n "${name}" ] || die "usage: idiot todo done <name> [<item-number>]"

    list_file="${IDIOT_TODO_DIR}/${name}"
    [ -f "${list_file}" ] || die "list '${name}' not found"

    [ -n "${item_num}" ] || {
        command -v fzf > /dev/null 2>&1 \
            || die "an item number is required (fzf not found for interactive selection)"

        pending=$(grep -n '^\[ \] ' "${list_file}" | sed 's/^\([0-9]*\):.*\[ \] /\1: /')
        [ -n "${pending}" ] || die "no pending items in '${name}'"
        selected=$(printf '%s\n' "${pending}" | fzf --prompt="done> ") || exit 0
        item_num="${selected%%:*}"
    }

    case "${item_num}" in
        *[!0-9]*|'') die "invalid item number: '${item_num}'" ;;
    esac

    count=0
    found=0
    while IFS= read -r line; do
        case "${line}" in
            '[ ] '*) count=$(( count + 1 )); [ "${count}" -eq "${item_num}" ] && found=1 ;;
        esac
    done < "${list_file}"

    [ "${found}" -eq 1 ] || die "item ${item_num} not found (list has ${count} pending item(s))"

    count=0
    tmpfile="${list_file}.tmp"
    while IFS= read -r line; do
        case "${line}" in
            '[ ] '*)
                count=$(( count + 1 ))
                if [ "${count}" -eq "${item_num}" ]; then
                    printf '[x] %s\n' "${line#\[ \] }" >> "${tmpfile}"
                else
                    printf '%s\n' "${line}" >> "${tmpfile}"
                fi
                ;;
            *)
                printf '%s\n' "${line}" >> "${tmpfile}"
                ;;
        esac
    done < "${list_file}"
    mv "${tmpfile}" "${list_file}"

    say "Marked item ${item_num} done in '${BOLD}${name}${RESET}'"
}
main "$@"
