#!/usr/bin/env sh
# cmd/lp/unset - clear the saved Launchpad username
# Usage: idiot lp unset
# Outputs: eval-able unset statement

. "$(dirname "${0}")/../../share/common.sh"
# shellcheck source=share/lp.sh
. "$(dirname "${0}")/../../share/lp.sh"

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot lp unset"
		exit 0
		;;
	esac
	rm -f "${IDIOT_LP_USER_FILE}"
	emit_unset IDIOT_LP_USER
}
main "$@"
