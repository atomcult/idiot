#!/usr/bin/env sh
# cmd/creds/remove - remove a credential file from IDIOT_CREDS_DIR
# Usage: idiot creds remove [<name>]

. "$(dirname "${0}")/../../lib/common.sh"

main() {
    name="${1:-}"

    [ -n "${name}" ] || {
        command -v fzf > /dev/null 2>&1 || die "a credential name is required (fzf not found for interactive selection)"

        mkdir -p "${IDIOT_CREDS_DIR}"

        files=$(find "${IDIOT_CREDS_DIR}" -maxdepth 1 -type f ! -name '.*' | sort | sed "s|${IDIOT_CREDS_DIR}/||")

        [ -n "${files}" ] || die "no credentials found"

        export IDIOT_CREDS_DIR
        preview_cmd="$(file_preview_cmd IDIOT_CREDS_DIR)"

        name=$(printf '%s\n' "${files}" | fzf --prompt="remove credentials> " --preview="${preview_cmd}") || exit 0
    }

    cred_file="${IDIOT_CREDS_DIR}/${name}"

    [ -f "${cred_file}" ] || die "credentials '${name}' not found"

    rm "${cred_file}"
    rm -f "${IDIOT_CACHE_DIR}/whoami/${name}"
    say "Removed credentials '${BOLD}${name}${RESET}'"
}
main "$@"
