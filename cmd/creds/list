#!/usr/bin/env sh
# cmd/creds/list - list credential files in IDIOT_CREDS_DIR
# Usage: idiot creds list

. "$(dirname "${0}")/../../lib/common.sh"

[ -d "${IDIOT_CREDS_DIR}" ] || { say "No credentials directory found at: ${IDIOT_CREDS_DIR}"; exit 0; }

# Collect entries (files only, no dotfiles, sorted)
entries=""
for f in "${IDIOT_CREDS_DIR}"/*; do
    [ -f "${f}" ] || continue
    entries="${entries}$(basename "${f}")\n"
done

[ -n "${entries}" ] || { say "No credentials found in: ${IDIOT_CREDS_DIR}"; exit 0; }

say "Credentials in ${IDIOT_CREDS_DIR}:"
echo >&2
printf '%b' "${entries}" | sort | while IFS= read -r name; do
    [ -n "${name}" ] || continue
    say "  ${BOLD}${name}${RESET}"
done
