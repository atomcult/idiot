#!/usr/bin/env sh
# cmd/creds/help - usage for the creds subcommand group

. "$(dirname "$0")/../../lib/common.sh"

say "${BOLD}${CYAN}Usage:${RESET} idiot creds <subcommand>"
echo >&2
say "${BOLD}${CYAN}Subcommands:${RESET}"
say "  ${BOLD}login${RESET}     Activate a credential"
say "  ${BOLD}logout${RESET}    Log out"
say "  ${BOLD}status${RESET}    Show login status"
echo >&2
say "  ${BOLD}add${RESET}       Create a new credential"
say "  ${BOLD}import${RESET}    Import a credential from a file"
say "  ${BOLD}list${RESET}      List saved credentials"
say "  ${BOLD}remove${RESET}    Remove a saved credential"
say "  ${BOLD}export${RESET}    Output a credential"
echo >&2
say "${BOLD}${CYAN}Environment:${RESET}"
say "  ${BOLD}IDIOT_CREDS_DIR${RESET}    Credentials directory"
