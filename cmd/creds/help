#!/usr/bin/env sh
# cmd/creds/help - usage for the creds subcommand group

. "$(dirname "$0")/../../lib/common.sh"

say "Usage: idiot creds <subcommand>"
echo >&2
say "Subcommands:"
say "  login     Activate a credential"
say "  logout    Log out"
say "  status    Show login status"
echo >&2
say "  add       Create a new credential"
say "  import    Import a credential from a file"
say "  list      List saved credentials"
say "  remove    Remove a saved credential"
say "  export    Output a credential"
echo >&2
say "Environment:"
say "  IDIOT_CREDS_DIR    Credentials directory"
