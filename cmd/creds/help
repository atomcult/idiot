#!/usr/bin/env sh
# cmd/creds/help - usage for the creds subcommand group

. "$(dirname "$0")/../../lib/common.sh"

say "Usage: idiot creds <subcommand>"
echo >&2
say "Subcommands:"
say "  add       Create credentials via snapcraft export-login"
say "  list      List available credential files"
say "  import    Import a credential file"
say "  login     Set UBUNTU_STORE_AUTH and SNAPCRAFT_STORE_CREDENTIALS"
say "  remove    Remove a credential file"
say "  export    Print a credential file to stdout, or write to a file"
say "  status    Show login status"
say "  logout    Unset store credential environment variables"
echo >&2
say "Environment:"
say "  IDIOT_CREDS_DIR    Credentials directory (default: $IDIOT_CREDS_DIR)"
