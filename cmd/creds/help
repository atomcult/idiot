#!/usr/bin/env sh
# cmd/creds/help - usage for the creds subcommand group
# Outputs: eval-able printf statements

. "$(dirname "$0")/../../lib/common.sh"

say "Usage: idiot creds <subcommand>"
echo >&2
say "Subcommands:"
say "  list                    List available credential files"
say "  import <file> [<name>]  Import a credential file (name defaults to filename)"
say "  login [<name>]          Set UBUNTU_STORE_AUTH and SNAPCRAFT_STORE_CREDENTIALS"
say "                            (launches fzf selector if no name given)"
say "  logout                  Unset store credential environment variables"
echo >&2
say "Environment:"
say "  IDIOT_CREDS_DIR    Credentials directory (default: $IDIOT_CREDS_DIR)"
