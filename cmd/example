#!/usr/bin/env sh
# cmd/examples - clone an example repository
# Usage: idiot examples [list | add | remove | update | <repo> [options]]

. "$(dirname "${0}")/../lib/common.sh"

EXAMPLES_CACHE="${IDIOT_CACHE_DIR}/examples"

# --- cache helpers ---

_cache_path() { printf '%s/%s\n' "${EXAMPLES_CACHE}" "${1}"; }

ensure_cached() {
    name="${1}"; url="${2}"
    path="$(_cache_path "${name}")"
    if [ ! -d "${path}" ]; then
        say "Fetching ${BOLD}${name}${RESET} into cache..."
        git clone --mirror "${url}" "${path}" >&2 || die "fetch failed"
    fi
    printf '%s\n' "${path}"
}

# --- subcommand helpers ---

list_known() {
    found=0
    for ex_dir in "${IDIOT_DATA_DIR}/examples" "${IDIOT_EXAMPLES_DIR}"; do
        [ -d "${ex_dir}" ] || continue
        for f in "${ex_dir}"/*; do
            [ -f "${f}" ] || continue
            found=1
            alias_name="$(basename "${f}")"
            url="$(head -1 "${f}")"
            if [ -d "$(_cache_path "${alias_name}")" ]; then
                cached_prefix="${GREEN}✓${RESET} "
            else
                cached_prefix="  "
            fi
            gap=$(( 28 - ${#alias_name} ))
            [ "${gap}" -lt 2 ] && gap=2
            if [ "${ex_dir}" = "${IDIOT_EXAMPLES_DIR}" ]; then
                say "  ${CYAN}${alias_name}${RESET}$(printf '%*s' "${gap}" '')${cached_prefix}${DIM}${url}  (saved)${RESET}"
            else
                say "  ${CYAN}${alias_name}${RESET}$(printf '%*s' "${gap}" '')${cached_prefix}${DIM}${url}${RESET}"
            fi
        done
    done
    [ "${found}" -eq 1 ] || say "  ${DIM}(none)${RESET}"
}

resolve_url() {
    case "${1}" in
        */*)
            printf 'https://github.com/%s\n' "${1}" ;;
        *)
            for ex_dir in "${IDIOT_EXAMPLES_DIR}" "${IDIOT_DATA_DIR}/examples"; do
                ex_file="${ex_dir}/${1}"
                [ -f "${ex_file}" ] && { head -1 "${ex_file}"; return 0; }
            done
            die "unknown example '${1}' — use <user>/<repo> or run 'idiot examples list'" ;;
    esac
}

do_add() {
    name="${1:-}"; target="${2:-}"
    { [ -n "${name}" ] && [ -n "${target}" ]; } \
        || die "usage: idiot examples add <name> <user>/<repo>"
    case "${name}" in
        *[!A-Za-z0-9_-]*) die "invalid name '${name}': use only letters, digits, hyphens, underscores" ;;
    esac
    case "${target}" in
        *://*)  url="${target}" ;;
        */*)    url="https://github.com/${target}" ;;
        *)      die "target must be a <user>/<repo> slug or a full URL" ;;
    esac
    mkdir -p "${IDIOT_EXAMPLES_DIR}"
    dest="${IDIOT_EXAMPLES_DIR}/${name}"
    [ -f "${dest}" ] && die "'${name}' is already saved (use 'idiot examples remove ${name}' first)"
    [ -f "${IDIOT_DATA_DIR}/examples/${name}" ] && \
        say "${YELLOW}warning:${RESET} '${name}' shadows a built-in example"
    printf '%s\n' "${url}" > "${dest}"
    say "Saved ${BOLD}${name}${RESET} → ${DIM}${url}${RESET}"
}

do_remove() {
    name="${1:-}"
    [ -n "${name}" ] || {
        command -v fzf > /dev/null 2>&1 \
            || die "a name is required (fzf not found for interactive selection)"
        [ -d "${IDIOT_EXAMPLES_DIR}" ] || die "no saved examples found"
        files=$(find "${IDIOT_EXAMPLES_DIR}" -maxdepth 1 -type f ! -name '.*' | sort \
            | sed "s|${IDIOT_EXAMPLES_DIR}/||")
        [ -n "${files}" ] || die "no saved examples found"
        export IDIOT_EXAMPLES_DIR
        preview_cmd="$(file_preview_cmd IDIOT_EXAMPLES_DIR)"
        name=$(printf '%s\n' "${files}" | fzf --prompt="remove example> " \
            --preview="${preview_cmd}") || exit 0
    }
    alias_file="${IDIOT_EXAMPLES_DIR}/${name}"
    [ -f "${alias_file}" ] || {
        [ -f "${IDIOT_DATA_DIR}/examples/${name}" ] \
            && die "cannot remove built-in example '${name}'"
        die "saved example '${name}' not found"
    }
    rm "${alias_file}"
    say "Removed ${BOLD}${name}${RESET}"
}

do_drop() {
    name="${1:-}"
    [ -n "${name}" ] || {
        command -v fzf > /dev/null 2>&1 \
            || die "a name is required (fzf not found for interactive selection)"
        [ -d "${EXAMPLES_CACHE}" ] || die "no cached examples found"
        entries=$(find "${EXAMPLES_CACHE}" -maxdepth 1 -mindepth 1 -type d | sort \
            | sed "s|${EXAMPLES_CACHE}/||")
        [ -n "${entries}" ] || die "no cached examples found"
        name=$(printf '%s\n' "${entries}" | fzf --prompt="drop cache> ") || exit 0
    }
    path="$(_cache_path "${name}")"
    [ -d "${path}" ] || die "'${name}' is not cached"
    rm -rf "${path}"
    say "Dropped cache for ${BOLD}${name}${RESET}"
}

do_update() {
    name="${1:-}"
    if [ -n "${name}" ]; then
        url=$(resolve_url "${name}")
        path="$(_cache_path "${name}")"
        if [ -d "${path}" ]; then
            say "Updating ${BOLD}${name}${RESET}..."
            git -C "${path}" remote update --prune >&2 || die "update failed"
            say "Updated ${BOLD}${name}${RESET}"
        else
            say "Fetching ${BOLD}${name}${RESET} into cache..."
            git clone --mirror "${url}" "${path}" >&2 || die "fetch failed"
            say "Cached ${BOLD}${name}${RESET}"
        fi
    else
        found=0
        for ex_dir in "${IDIOT_DATA_DIR}/examples" "${IDIOT_EXAMPLES_DIR}"; do
            [ -d "${ex_dir}" ] || continue
            for f in "${ex_dir}"/*; do
                [ -f "${f}" ] || continue
                found=1
                alias_name="$(basename "${f}")"
                url="$(head -1 "${f}")"
                path="$(_cache_path "${alias_name}")"
                if [ -d "${path}" ]; then
                    say "Updating ${BOLD}${alias_name}${RESET}..."
                    git -C "${path}" remote update --prune >&2 \
                        || say "${YELLOW}warning:${RESET} failed to update '${alias_name}'"
                else
                    say "Fetching ${BOLD}${alias_name}${RESET} into cache..."
                    git clone --mirror "${url}" "${path}" >&2 \
                        || say "${YELLOW}warning:${RESET} failed to fetch '${alias_name}'"
                fi
            done
        done
        [ "${found}" -eq 1 ] || die "no examples found"
    fi
}

# --- main ---

main() {
    case "${1:-}" in
        ""|--help|-h|help)
            help_heading "Usage:" "idiot examples <repo> [options]"
            echo >&2
            say "<repo> is a GitHub ${BOLD}<user>/<repo>${RESET} slug, or a saved example name (see below)."
            say "Saved examples are kept as a local mirror; use ${BOLD}update${RESET} to refresh."
            echo >&2
            help_heading "Options:"
            help_option "--dest <dir>"    "Clone into <dir> (default: ./<repo-name>)"
            help_option "--branch [name]" "Branch to use; omit value for fzf picker"
            help_option "--tag [name]"    "Tag to use; omit value for fzf picker"
            help_option "--subdir [path]" "Extract a subdirectory; omit value for nnn picker"
            help_option "--bare"          "Extract files only — no .git directory"
            echo >&2
            help_heading "Subcommands:"
            help_command "list"   "List examples  (✓ before URL = locally cached)"
            help_command "add"    "Save a new example"
            help_command "remove" "Remove a saved example"
            help_command "drop"   "Delete a cached example mirror"
            help_command "update" "Refresh cached example(s) from remote"
            echo >&2
            help_heading "Examples:"
            say "  ${CYAN}idiot examples${RESET} iot-example-snaps"
            say "  ${CYAN}idiot examples${RESET} iot-example-snaps ${DIM}--subdir${RESET}          ${DIM}# nnn picker${RESET}"
            say "  ${CYAN}idiot examples${RESET} iot-example-snaps ${DIM}--branch${RESET}          ${DIM}# fzf picker${RESET}"
            say "  ${CYAN}idiot examples${RESET} canonical/my-snap ${DIM}--dest${RESET} ~/dev"
            say "  ${CYAN}idiot examples${RESET} canonical/my-snap ${DIM}--tag${RESET} v1.2 ${DIM}--bare${RESET}"
            say "  ${CYAN}idiot examples add${RESET} my-example canonical/my-snap"
            say "  ${CYAN}idiot examples update${RESET}"
            echo >&2
            help_heading "Saved examples:"
            list_known
            exit 0 ;;
        list)   list_known;            exit 0 ;;
        add)    shift; do_add "$@";    exit 0 ;;
        remove) shift; do_remove "$@"; exit 0 ;;
        drop)   shift; do_drop "$@";   exit 0 ;;
        update) shift; do_update "$@"; exit 0 ;;
    esac

    bare=0
    dest=""
    ref=""
    subdir=""
    pick_ref=""
    pick_subdir=0
    repo=""

    while [ $# -gt 0 ]; do
        case "${1}" in
            --bare)
                bare=1; shift ;;
            --dest)
                [ -n "${2:-}" ] || die "--dest requires a directory argument"
                dest="${2}"; shift 2 ;;
            --dest=*)
                dest="${1#--dest=}"; shift ;;
            --branch)
                [ -z "${ref}" ] && [ -z "${pick_ref}" ] || die "--branch and --tag are mutually exclusive"
                if [ -n "${2:-}" ] && [ "${2#-}" = "${2}" ]; then
                    ref="${2}"; shift 2
                else
                    pick_ref="branch"; shift
                fi ;;
            --tag)
                [ -z "${ref}" ] && [ -z "${pick_ref}" ] || die "--branch and --tag are mutually exclusive"
                if [ -n "${2:-}" ] && [ "${2#-}" = "${2}" ]; then
                    ref="${2}"; shift 2
                else
                    pick_ref="tag"; shift
                fi ;;
            --subdir)
                if [ -n "${2:-}" ] && [ "${2#-}" = "${2}" ]; then
                    subdir="${2}"; shift 2
                else
                    pick_subdir=1; shift
                fi ;;
            --*)
                die "unknown option: ${1}" ;;
            *)
                [ -z "${repo}" ] || die "unexpected argument: ${1}"
                repo="${1}"; shift ;;
        esac
    done

    [ -n "${repo}" ] || die "usage: idiot examples <repo> [options]"

    require git

    url=$(resolve_url "${repo}")
    repo_name="${repo##*/}"

    # --subdir always produces a file-only extraction
    [ -n "${subdir}" ] && bare=1

    case "${repo}" in
        */*) is_alias=0 ;;
        *)   is_alias=1 ;;
    esac

    if [ "${is_alias}" -eq 1 ]; then
        # ----------------------------------------------------------------
        # Saved example: use local mirror cache
        # ----------------------------------------------------------------
        cpath=$(ensure_cached "${repo}" "${url}")

        # Interactive ref picker (works offline from local mirror)
        if [ -n "${pick_ref}" ]; then
            require fzf "install fzf for interactive selection"
            if [ "${pick_ref}" = "branch" ]; then
                ref=$(git -C "${cpath}" branch | sed 's/^..//' | sort \
                    | fzf --prompt="branch> ") || exit 0
            else
                ref=$(git -C "${cpath}" tag | sort -V \
                    | fzf --prompt="tag> ") || exit 0
            fi
        fi

        # Interactive subdir picker (also offline)
        subdirs=""
        if [ "${pick_subdir}" -eq 1 ]; then
            require nnn "install nnn for interactive directory selection"
            _nnn_tmp=$(mktemp -d)
            _nnn_sel=$(mktemp)
            trap '[ -d "${_nnn_tmp}" ] && rm -rf "${_nnn_tmp}"; rm -f "${_nnn_sel}"' EXIT INT TERM
            git -C "${cpath}" ls-tree -r -d --name-only "${ref:-HEAD}" \
                | while IFS= read -r dir; do mkdir -p "${_nnn_tmp}/${dir}"; done
            nnn -p "${_nnn_sel}" "${_nnn_tmp}" >&2 || exit 0
            [ -f "${_nnn_sel}" ] || exit 0
            subdirs=$(while IFS= read -r _line; do
                _line="${_line#"${_nnn_tmp}"}"; _line="${_line#/}"
                [ -n "${_line}" ] && printf '%s\n' "${_line}"
            done < "${_nnn_sel}")
            rm -rf "${_nnn_tmp}"; rm -f "${_nnn_sel}"
            trap - EXIT INT TERM
            [ -n "${subdirs}" ] || exit 0
            # collapse to single subdir if only one was selected
            _nsel=$(printf '%s\n' "${subdirs}" | grep -c '.')
            if [ "${_nsel}" -eq 1 ]; then
                subdir="${subdirs}"; subdirs=""
            fi
            bare=1
        fi

        [ -n "${dest}" ] || dest="${subdir:+${subdir##*/}}"; [ -n "${dest}" ] || dest="${repo_name}"

        if [ "${bare}" -eq 1 ]; then
            [ -e "${dest}" ] && die "destination '${dest}' already exists"
            mkdir -p "${dest}"
            if [ -n "${subdirs}" ]; then
                printf '%s\n' "${subdirs}" | while IFS= read -r sd; do
                    [ -n "${sd}" ] || continue
                    sdbase="${sd##*/}"
                    git -C "${cpath}" ls-tree "${ref:-HEAD}" -- "${sd}" | grep -q '^' \
                        || die "subdirectory '${sd}' not found"
                    strip=$(printf '%s' "${sd}" | awk -F/ '{print NF}')
                    mkdir -p "${dest}/${sdbase}"
                    git -C "${cpath}" archive "${ref:-HEAD}" -- "${sd}" \
                        | tar -x --strip-components="${strip}" -C "${dest}/${sdbase}" \
                        || die "extraction failed"
                    say "Extracted ${DIM}${sd}${RESET} → ${BOLD}${dest}/${sdbase}${RESET} ${DIM}(no git history)${RESET}"
                done
            elif [ -n "${subdir}" ]; then
                git -C "${cpath}" ls-tree "${ref:-HEAD}" -- "${subdir}" | grep -q '^' \
                    || die "subdirectory '${subdir}' not found"
                strip=$(printf '%s' "${subdir}" | awk -F/ '{print NF}')
                git -C "${cpath}" archive "${ref:-HEAD}" -- "${subdir}" \
                    | tar -x --strip-components="${strip}" -C "${dest}" \
                    || die "extraction failed"
                say "Extracted ${DIM}${subdir}${RESET} → ${BOLD}${dest}${RESET} ${DIM}(no git history)${RESET}"
            else
                git -C "${cpath}" archive "${ref:-HEAD}" \
                    | tar -x -C "${dest}" \
                    || die "extraction failed"
                say "Extracted to ${BOLD}${dest}${RESET} ${DIM}(no git history)${RESET}"
            fi
        else
            # Local clone from mirror — fast, no network
            set -- git clone
            [ -n "${ref}" ] && set -- "$@" --branch "${ref}"
            set -- "$@" "${cpath}" "${dest}"
            say "Cloning ${BOLD}${repo}${RESET} from cache..."
            "$@" >&2 || die "clone failed"
            say "Cloned to ${BOLD}${dest}${RESET}"
        fi

    else
        # ----------------------------------------------------------------
        # Direct <user>/<repo> slug: one-time clone, no caching
        # ----------------------------------------------------------------
        [ "${pick_subdir}" -eq 1 ] && die "--subdir without a value requires a saved example name"

        # Branch/tag pickers fall back to ls-remote (needs network)
        if [ -n "${pick_ref}" ]; then
            require fzf "install fzf for interactive selection"
            say "Fetching refs from ${BOLD}${repo}${RESET}..."
            if [ "${pick_ref}" = "branch" ]; then
                ref=$(git ls-remote --heads "${url}" \
                    | sed 's|.*refs/heads/||' | sort \
                    | fzf --prompt="branch> ") || exit 0
            else
                ref=$(git ls-remote --tags "${url}" \
                    | sed 's|.*refs/tags/||' | grep -v '\^{}' | sort -V \
                    | fzf --prompt="tag> ") || exit 0
            fi
        fi

        [ -n "${dest}" ] || dest="${subdir:+${subdir##*/}}"; [ -n "${dest}" ] || dest="${repo_name}"

        if [ "${bare}" -eq 1 ]; then
            tmpdir=$(mktemp -d)
            trap '[ -d "${tmpdir}" ] && rm -rf "${tmpdir}"' EXIT INT TERM
            set -- git clone --depth 1
            [ -n "${ref}" ] && set -- "$@" --branch "${ref}"
            set -- "$@" "${url}" "${tmpdir}"
            say "Cloning ${BOLD}${repo}${RESET}..."
            "$@" >&2 || die "clone failed"
            rm -rf "${tmpdir}/.git"
            if [ -n "${subdir}" ]; then
                src="${tmpdir}/${subdir}"
                [ -d "${src}" ] || die "subdirectory '${subdir}' not found"
                [ -e "${dest}" ] && die "destination '${dest}' already exists"
                mv "${src}" "${dest}"
                say "Extracted ${DIM}${subdir}${RESET} → ${BOLD}${dest}${RESET} ${DIM}(no git history)${RESET}"
            else
                [ -e "${dest}" ] && die "destination '${dest}' already exists"
                mv "${tmpdir}" "${dest}"
                say "Extracted to ${BOLD}${dest}${RESET} ${DIM}(no git history)${RESET}"
            fi
        else
            set -- git clone
            [ -n "${ref}" ] && set -- "$@" --branch "${ref}"
            set -- "$@" "${url}" "${dest}"
            say "Cloning ${BOLD}${repo}${RESET}..."
            "$@" >&2 || die "clone failed"
            say "Cloned to ${BOLD}${dest}${RESET}"
        fi
    fi
}
main "$@"
