#!/usr/bin/env sh
# cmd/model/remove - remove a registered user model repo and its local clone
# Usage: idiot model remove [<name>]

. "$(dirname "${0}")/../../share/common.sh"
include models.sh
include fzf.sh

main() {
	case "${1:-}" in
	-h | --help | help)
		help_heading "Usage:" "idiot model remove [<name>]"
		exit 0
		;;
	esac

	if [ -n "${1:-}" ]; then
		name="${1}"
	else
		name="$(fzf_pick_from_dir "${IDIOT_MODEL_REPOS_DIR}" "remove model repo> " \
			"no user model repos configured")" || exit 0
	fi

	[ -f "${IDIOT_DATA_DIR}/models/${name}" ] && die "cannot remove built-in repo '${name}'"
	[ -f "${IDIOT_MODEL_REPOS_DIR}/${name}" ] || die "unknown user model repo '${name}'"

	rm "${IDIOT_MODEL_REPOS_DIR}/${name}"
	say "Removed model repo '${BOLD}${name}${RESET}'"

	clone="${IDIOT_MODELS_DIR}/${name}"
	if [ -d "${clone}" ]; then
		rm -rf "${clone}"
		say "Deleted clone at ${DIM}${clone}${RESET}"
	fi
}
main "$@"
