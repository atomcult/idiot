#!/bin/bash
# tests/bare-host.d/vm - boot an Ubuntu Core image from the components
#
# Usage: vm <image> [<seconds>]   (as root; needs idiot+vm and idiot+tpm)
# Boots the image with secure boot and an emulated TPM, with no qemu,
# firmware or swtpm packages on the host, until it reaches console-conf or
# <seconds> (default 600) pass, then stops it with vm stop (a graceful power
# down). A first boot runs install mode and reboots.
# The image is booted through an overlay, so it must come out unchanged.

# shellcheck disable=SC2015 # ok and fail always succeed: A && ok || fail is safe
. "$(dirname "$0")/lib"

image="${1:?usage: vm <image> [<seconds>]}"
secs="${2:-600}"
installed vm && installed tpm || {
	fail "vm: needs idiot+vm and idiot+tpm"
	exit 1
}
case "$(dpkg --print-architecture)" in
amd64) qemu='qemu-system-x86_64' ;;
arm64) qemu='qemu-system-aarch64' ;;
armhf) qemu='qemu-system-arm' ;;
*) qemu="qemu-system-$(dpkg --print-architecture)" ;;
esac
for t in "${qemu}" swtpm; do
	! command -v "${t}" >/dev/null || fail "vm: the host has its own ${t}; this isn't a bare host"
done

# the secure boot firmware idiot doctor reports, to find in qemu's arguments
fw="$(idiot doctor 2>&1 | awk '/✓ .* secure boot firmware/ && /'"$(dpkg --print-architecture)"'/ { print $(NF - 1); exit }')"

log="$(mktemp)"
state="$(mktemp -d)"
sum="$(sha256sum <"${image}")"
idiot vm --tpm --no-gfx --state-dir "${state}" "${image}" </dev/null >"${log}" 2>&1 &
pid=$!
for _ in $(seq "${secs}"); do
	grep -aq 'Press enter to configure' "${log}" && break
	kill -0 "${pid}" 2>/dev/null || break
	sleep 1
done
qargs="$(pgrep -a -x "$(printf '%s' "${qemu}" | cut -c1-15)")"
case "${qargs}" in
*"file=${fw},"* | *"file=${fw} "*) ok "vm: boots the firmware idiot doctor reports (${fw##*/})" ;;
*) fail "vm: doctor reported [${fw}], qemu runs: ${qargs}" ;;
esac
# a graceful stop: the ACPI power button over QMP, as vm stop sends it
name="$(basename "${image%.img}")"
out="$(idiot vm stop --timeout 120 "${name}" 2>&1)"
wait "${pid}"
printf '%s' "${out}" | grep -q "Stopped VM ${name}" &&
	! printf '%s' "${out}" | grep -q 'did not shut down' &&
	grep -aq 'reboot: Power down' "${log}" &&
	ok "vm: vm stop powers the guest down" ||
	fail "vm: vm stop: ${out} (see ${log})"

check() { # <label> <pattern>
	grep -aqE -- "${2}" "${log}" && ok "vm: ${1}" || fail "vm: ${1} (see ${log})"
}
check "secure boot enabled" 'Secure boot enabled'
check "TPM present" 'TPM2|tpm_tis'
check "reached console-conf" 'Press enter to configure'
pgrep -x swtpm >/dev/null && fail "vm: swtpm left running" || ok "vm: swtpm stopped with the VM"
[ -f "${state}/tpm2-00.permall" ] && ok "vm: TPM state saved" || fail "vm: no TPM state in ${state}"
[ "$(sha256sum <"${image}")" = "${sum}" ] && ok "vm: image left pristine (overlay)" ||
	fail "vm: the image was written"
[ -f "${state}/disk.qcow2" ] && ok "vm: disk overlay in the state dir" || fail "vm: no disk.qcow2 in ${state}"
grep -aq 'Press enter to configure' "${state}/serial.log" 2>/dev/null &&
	ok "vm: serial console logged" || fail "vm: no console-conf in ${state}/serial.log"

# the stopped VM's TPM, served by idiot vm tpm, read with the bundled tools
idiot vm tpm --name "${name}" >"${log}.tpm" 2>&1 &
for _ in $(seq 10); do
	[ -S "${state}/inspect.sock" ] && break
	sleep 1
done
out="$(idiot run tpm2_pcrread --tcti="swtpm:path=${state}/inspect.sock" sha256:7 2>&1)"
printf '%s' "${out}" | grep -qE '7 *: *0x[0-9A-F]{64}' &&
	ok "vm: tpm --name serves the saved TPM to tpm2_pcrread" ||
	fail "vm: tpm2_pcrread: $(printf '%s' "${out}" | head -n 3 | tr '\n' ' ')"
pkill -x swtpm 2>/dev/null
wait

idiot vm delete --yes "${name}" >/dev/null 2>&1
rm -rf "${state}"
