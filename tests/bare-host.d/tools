#!/bin/bash
# tests/bare-host.d/tools - every promised tool runs (bundled-tools spec)
#
# For each installed component, run each tool the spec promises with a
# harmless argument through `idiot run`; a tool passes if it executes,
# whatever its exit status (many tools return non-zero for --version).

# shellcheck disable=SC2015 # ok and fail always succeed: A && ok || fail is safe
. "$(dirname "$0")/lib"

arch="$(dpkg --print-architecture)"

# component, tool, arguments
while read -r comp tool args; do
	[ -n "${comp}" ] || continue
	installed "${comp}" || continue
	if [ "${tool}" = ltrace ] && [ "${arch}" = riscv64 ]; then
		continue # not built for riscv64
	fi
	# shellcheck disable=SC2086 # args are words
	out="$(idiot run "${tool}" ${args} </dev/null 2>&1)"
	rc=$?
	if broken "${rc}" "${out}"; then
		fail "${comp}/${tool}: rc=${rc} $(printf '%s' "${out}" | head -n 2 | tr '\n' ' ' | cut -c1-160)"
	else
		ok "${comp}/${tool}"
	fi
done <<'TOOLS'
core debugfs -V
core mke2fs -V
core mcopy --version
core mdir --version
core sfdisk --version
core lsblk --version
core mkfs.vfat --help
core fsck.vfat --help
core sgdisk --version
core parted --version
core dump.erofs --help
core fsck.erofs --help
core zstd --version
core lz4 --version
