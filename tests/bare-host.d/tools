core simg2img
vm qemu-system-x86_64 --version
vm qemu-system-aarch64 --version
vm qemu-system-arm --version
vm qemu-system-riscv64 --version
vm qemu-img --version
tpm swtpm --version
tpm swtpm_setup --version
