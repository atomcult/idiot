#!/usr/bin/env sh
# lib/mdview - Render a Markdown document with ANSI colour; follow numbered links.
# Usage: mdview <file>

. "$(dirname "${0}")/common.sh"

_MDVIEW_COLS=$(tput cols 2>/dev/null || printf '72')
export _MDVIEW_COLS

# ── Renderer ──────────────────────────────────────────────────────────────────
# Writes rendered text to stderr. Prints "N<TAB>URL" link pairs to stdout.
_mdview_render() {
    [ -f "${1}" ] || { say "${RED}mdview: not found: ${1}${RESET}"; return 1; }
    BOLD="${BOLD}" DIM="${DIM}" GREEN="${GREEN}" YELLOW="${YELLOW}" \
    BLUE="${BLUE}" CYAN="${CYAN}" RED="${RED}" RESET="${RESET}" \
    awk '
    BEGIN {
        B  = ENVIRON["BOLD"]
        D  = ENVIRON["DIM"]
        GR = ENVIRON["GREEN"]
        YE = ENVIRON["YELLOW"]
        BL = ENVIRON["BLUE"]
        CY = ENVIRON["CYAN"]
        RE = ENVIRON["RED"]
        R  = ENVIRON["RESET"]
        cols = ENVIRON["_MDVIEW_COLS"] + 0
        if (cols <= 0) cols = 72
        in_code = 0
        link_count = 0
    }

    function rep(c, n,    r, i) {
        r = ""; for (i = 0; i < n; i++) r = r c; return r
    }

    function emit(s) { printf "%s\n", s > "/dev/stderr" }

    function rule(c, n) {
        printf "%s%s%s\n", D, rep(c, n > 0 ? n : cols), R > "/dev/stderr"
    }

    function process_inline(s,    result, m, bc, text, url) {
        result = ""
        while (length(s) > 0) {
            # Image: ![alt](url) — before link so "!" is not swallowed
            if (match(s, /!\[[^]]*\]\([^)]*\)/)) {
                result = result substr(s, 1, RSTART - 1)
                m  = substr(s, RSTART, RLENGTH)
                bc = index(m, "]")
                text = substr(m, 3, bc - 3)
                result = result D "[" text "]" R
                s = substr(s, RSTART + RLENGTH)
            # Link: [text](url)
            } else if (match(s, /\[[^]]*\]\([^)]*\)/)) {
                result = result substr(s, 1, RSTART - 1)
                m  = substr(s, RSTART, RLENGTH)
                bc = index(m, "]")
                text = substr(m, 2, bc - 2)
                url  = substr(m, bc + 2, length(m) - bc - 2)
                link_count++
                links[link_count] = url
                result = result CY text R D "[" link_count "]" R
                s = substr(s, RSTART + RLENGTH)
            # Inline code
            } else if (match(s, /`[^`]+`/)) {
                result = result substr(s, 1, RSTART - 1)
                result = result GR substr(s, RSTART + 1, RLENGTH - 2) R
                s = substr(s, RSTART + RLENGTH)
            # Bold **...**
            } else if (match(s, /\*\*[^*]+\*\*/)) {
                result = result substr(s, 1, RSTART - 1)
                result = result B substr(s, RSTART + 2, RLENGTH - 4) R
                s = substr(s, RSTART + RLENGTH)
            # Bold __...__
            } else if (match(s, /__[^_]+__/)) {
                result = result substr(s, 1, RSTART - 1)
                result = result B substr(s, RSTART + 2, RLENGTH - 4) R
                s = substr(s, RSTART + RLENGTH)
            # Italic *...* (not ** and not space after opening *)
            } else if (match(s, /\*[^* ][^*]*\*/)) {
                result = result substr(s, 1, RSTART - 1)
                result = result D substr(s, RSTART + 1, RLENGTH - 2) R
                s = substr(s, RSTART + RLENGTH)
            # Italic _..._ (not __ and not space after opening _)
            } else if (match(s, /_[^_ ][^_]*_/)) {
                result = result substr(s, 1, RSTART - 1)
                result = result D substr(s, RSTART + 1, RLENGTH - 2) R
                s = substr(s, RSTART + RLENGTH)
            } else {
                result = result s; break
            }
        }
        return result
    }

    {
        # Fenced code block toggle (``` or ~~~)
        if ($0 ~ /^(```|~~~)/) {
            in_code = !in_code
            emit(D (in_code ? "┌─── code" : "└─────────") R)
            next
        }

        if (in_code) {
            emit(D "│" R "  " $0)
            next
        }

        # ATX headings (# through ######)
        if (match($0, /^#{1,6} /)) {
            hashes = RLENGTH - 1
            text = process_inline(substr($0, RLENGTH + 1))
            if (hashes == 1) {
                emit("")
                emit(B BL text R)
                rule("═", cols)
            } else if (hashes == 2) {
                emit("")
                emit(B CY text R)
                rule("─", cols < 60 ? cols : 60)
            } else if (hashes == 3) {
                emit("")
                emit(B text R)
            } else {
                emit(D text R)
            }
            next
        }

        # Setext H1: line followed by ===... (detect by next line — approximate: treat as paragraph)
        # Setext H2: line followed by ---... — overlaps with HR; handled below

        # Horizontal rule (---, ___, ***)
        if ($0 ~ /^(---+|___+|\*\*\*+)[[:space:]]*$/) {
            rule("─", cols)
            next
        }

        # Blockquote
        if (match($0, /^> ?/)) {
            emit(D "│" R " " process_inline(substr($0, RLENGTH + 1)))
            next
        }

        # Unordered list (-, *, + with optional leading spaces)
        if (match($0, /^[ \t]*[*+-] /)) {
            indent_w = RLENGTH - 2
            emit(rep(" ", indent_w) CY "•" R " " process_inline(substr($0, RLENGTH + 1)))
            next
        }

        # Ordered list
        if (match($0, /^[ \t]*[0-9]+\. /)) {
            emit(CY substr($0, 1, RLENGTH) R process_inline(substr($0, RLENGTH + 1)))
            next
        }

        # Blank line
        if ($0 ~ /^[[:space:]]*$/) {
            emit("")
            next
        }

        # Paragraph / continuation
        emit(process_inline($0))
    }

    END {
        for (i = 1; i <= link_count; i++) {
            printf "%d\t%s\n", i, links[i]
        }
    }
    ' "${1}"
}

# ── Navigation ────────────────────────────────────────────────────────────────
_mdview_view() {
    _mv_file="${1}"
    _mv_base="${2:-$(dirname "${_mv_file}")}"
    _TAB=$(printf '\t')

    while true; do
        printf '\033[2J\033[H' >&2

        # Render: display → stderr (terminal), link list → stdout (captured)
        _mv_links=$(_mdview_render "${_mv_file}")

        # Count links
        _mv_link_count=0
        [ -n "${_mv_links}" ] && \
            _mv_link_count=$(printf '%s\n' "${_mv_links}" | grep -c .)

        # Link footer
        if [ "${_mv_link_count}" -gt 0 ]; then
            _mv_rule=$(printf '%*s' "${_MDVIEW_COLS}" '' | tr ' ' '─')
            say "${DIM}${_mv_rule}${RESET}"
            printf '%s\n' "${_mv_links}" | while IFS="${_TAB}" read -r _ln _lu; do
                say "  ${DIM}[${RESET}${CYAN}${_ln}${RESET}${DIM}]${RESET} ${_lu}"
            done
            say ""
            printf '%sfollow [1-%d]%s, q to quit › ' \
                "${DIM}" "${_mv_link_count}" "${RESET}" >&2
        else
            printf '%sq to quit › %s' "${DIM}" "${RESET}" >&2
        fi

        read -r _mv_choice

        case "${_mv_choice}" in
            q|Q|'')
                return 0
                ;;
            [0-9]*)
                _mv_url=$(printf '%s\n' "${_mv_links}" | \
                    awk -F'\t' -v n="${_mv_choice}" '$1==n{print $2; exit}')
                if [ -z "${_mv_url}" ]; then
                    say "${RED}no such link: ${_mv_choice}${RESET}"
                    sleep 1
                    continue
                fi
                case "${_mv_url}" in
                    http://*|https://*)
                        xdg-open "${_mv_url}" 2>/dev/null &
                        say "${DIM}Opening: ${_mv_url}${RESET}"
                        sleep 1
                        ;;
                    *)
                        # Strip fragment, resolve relative to base dir
                        _mv_target="${_mv_url%%#*}"
                        case "${_mv_target}" in
                            /*) _mv_next="${_mv_target}" ;;
                            *)  _mv_next="${_mv_base}/${_mv_target}" ;;
                        esac
                        if [ -f "${_mv_next}" ]; then
                            _mdview_view "${_mv_next}" "$(dirname "${_mv_next}")"
                        else
                            say "${RED}not found: ${_mv_next}${RESET}"
                            sleep 1
                        fi
                        ;;
                esac
                ;;
            *)
                say "${DIM}press a link number or q${RESET}"
                sleep 1
                ;;
        esac
    done
}

main() {
    case "${1:-}" in
        -h|--help|help)
            help_heading "Usage:" "mdview <file.md>"
            echo >&2
            say "Renders Markdown with ANSI colour. After rendering, numbered"
            say "links are listed; enter a number to follow, q to quit."
            exit 0
            ;;
    esac

    _file="${1:-}"
    [ -n "${_file}" ] || die "usage: mdview <file>"
    [ -f "${_file}" ] || die "file not found: ${_file}"

    _mdview_view "${_file}" "$(dirname "${_file}")"
}
main "$@"
