#!/usr/bin/env sh
# idiot - shell environment manager
# Outputs eval-able shell code; use via the shell wrapper installed by:
#   eval "$(idiot init bash)"   # or zsh / fish

set -e

IDIOT_ROOT="${IDIOT_ROOT:-$(cd "$(dirname "${0}")" && pwd)}"
export IDIOT_ROOT
IDIOT_CMD_DIR="${IDIOT_ROOT}/cmd"
IDIOT_LIB_DIR="${IDIOT_ROOT}/lib"

# shellcheck source=lib/common.sh
. "${IDIOT_LIB_DIR}/common.sh"

idiot_help() {
    say "${BOLD}idiot${RESET} - shell environment manager"
    echo >&2
    help_heading "Usage:" "idiot <command> [args...]"
    echo >&2
    help_heading "Commands:"
    help_command "env"     "Manage shell environment (auth, store, arch)"
    help_command "inspect" "Inspect snap store objects and disk images"
    help_command "models"  "Manage model assertions"
    help_command "prune"   "Remove development leftovers"
    help_command "vm"      "Launch a QEMU VM"
    help_command "process" "Step-by-step process checklists"
    help_command "todo"    "Manage per-project to-do lists"
    help_command "docs"     "Browse and search IoT reference docs"
    help_command "examples" "Clone an example repository"
    help_command "run"      "Run a snap-bundled tool directly"
    help_command "init"     "Set up shell integration"
    echo >&2
    help_heading "Shell setup" "(run once, add to your shell rc):"
    # shellcheck disable=SC2016
    {
        say "  ${CYAN}eval${RESET} ${GREEN}"'"$(idiot init bash)"'"${RESET}    ${DIM}# bash${RESET}"
        say "  ${CYAN}eval${RESET} ${GREEN}"'"$(idiot init zsh)"'"${RESET}     ${DIM}# zsh${RESET}"
        say "  ${CYAN}idiot${RESET} init fish | ${CYAN}source${RESET}     ${DIM}# fish${RESET}"
    }
    echo >&2
    say "Run ${DIM}idiot <command> help${RESET} for subcommand details."
}

main() {
    cmd="${1:-}"
    [ $# -ge 1 ] && shift

    case "${cmd}" in
        ""|-h|--help|help)
            idiot_help
            exit 0
            ;;
        -V|--version|version)
            printf 'idiot v2.0.0\n' >&2
            exit 0
            ;;
        *)
            cmd_file="${IDIOT_CMD_DIR}/${cmd}"
            if [ -d "${cmd_file}" ]; then
                dispatch_subcmd "${cmd}" "${cmd_file}" "$@"
            elif [ -x "${cmd_file}" ]; then
                case "${cmd}" in
                    init) exec "${cmd_file}" "$@" ;;
                    *)
                        [ -n "${IDIOT_SHELL}" ] || die "shell not initialized — run: eval \"\$(idiot init bash)\"  or: idiot init fish | source"
                        exec "${cmd_file}" "$@"
                        ;;
                esac
            else
                die "unknown command: ${cmd}"
            fi
            ;;
    esac
}
main "$@"
