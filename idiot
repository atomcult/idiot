#!/usr/bin/env sh
# idiot - shell environment manager
# Outputs eval-able shell code; use via the shell wrapper installed by:
#   eval "$(idiot init bash)"   # or zsh / fish

set -e

IDIOT_ROOT="${IDIOT_ROOT:-$(cd "$(dirname "${0}")" && pwd)}"
export IDIOT_ROOT
IDIOT_CMD_DIR="${IDIOT_ROOT}/cmd"
IDIOT_LIB_DIR="${IDIOT_ROOT}/share"

# pre-scan for --color before sourcing common.sh so color vars are set correctly
for _arg in "$@"; do
	case "${_arg}" in
	--color) export FORCE_COLOR=1 ;;
	--) break ;;
	esac
done
unset _arg

# shellcheck source=share/common.sh
. "${IDIOT_LIB_DIR}/common.sh"

idiot_help() {
	say "${IDIOT_LOGO} ${BOLD}idiot${RESET} — Interactive Devtools for IoT"
	echo >&2
	help_heading "Usage:" "idiot <command> [args...]"
	echo >&2
	help_heading "Store & environment:"
	help_command "status" "Show current environment at a glance"
	help_command "profile" "Save and switch whole environments"
	help_command "auth" "Manage snap store credentials"
	help_command "store" "Pick a snap store; query and browse it, fetch assertions"
	help_command "arch" "Set the target build architecture"
	help_command "lp" "Manage Launchpad identity"
	echo >&2
	help_heading "Development:"
	help_command "kernel" "Clone an Ubuntu kernel from Launchpad"
	help_command "example" "Clone an example repository"
	help_command "inspect" "Inspect snaps, images, snapd state, changes, assertions"
	help_command "model" "Model assertion repositories"
	help_command "assertion" "Write, check and sign models, system-users, validation sets"
	echo >&2
	help_heading "VM & device:"
	help_command "vm" "Run a QEMU VM: snapshots, snap installs, ssh"
	echo >&2
	help_heading "Shell:"
	help_command "init" "Set up shell integration"
	help_command "prompt" "Active store, arch and credential for a prompt"
	help_command "run" "Run a snap-bundled tool directly"
	help_command "clean" "Remove development leftovers"
	help_command "doctor" "Check idiot's setup and say what to fix"
	echo >&2
	help_heading "Shell setup" "(run once, add to your shell rc):"
	# shellcheck disable=SC2016
	{
		say "  ${CYAN}eval${RESET} ${GREEN}"'"$(idiot init bash)"'"${RESET}    ${DIM}# bash${RESET}"
		say "  ${CYAN}eval${RESET} ${GREEN}"'"$(idiot init zsh)"'"${RESET}     ${DIM}# zsh${RESET}"
		say "  ${CYAN}idiot${RESET} init fish | ${CYAN}source${RESET}     ${DIM}# fish${RESET}"
	}
	echo >&2
	say "Run ${DIM}idiot <command> help${RESET} for subcommand details."
}

_increment_count() {
	mkdir -p "${IDIOT_CACHE_DIR}"
	_ic=0
	_ic_file="${IDIOT_CACHE_DIR}/invoke-count"
	if [ -f "${_ic_file}" ]; then
		_ic="$(cat "${_ic_file}" 2>/dev/null || :)"
		case "${_ic}" in
		'' | *[!0-9]*) _ic=0 ;;
		esac
	fi
	printf '%s\n' "$((_ic + 1))" >"${_ic_file}"
	unset _ic _ic_file
}

# Count the command and, once a day, warn about the active credential's
# expiry. creds.sh is only read when a credential with a known expiry is
# active, so other shells pay nothing. `auth login` gives its own notice.
_counted() {
	_increment_count
	[ -n "${IDIOT_CRED_EXPIRES:-}" ] || return 0
	[ "${1}" != "auth login" ] || return 0
	include creds.sh
	cred_expiry_warn
}

main() {
	while [ $# -gt 0 ]; do
		case "${1}" in
		--color) shift ;;
		*) break ;;
		esac
	done

	cmd="${1:-}"
	[ $# -ge 1 ] && shift

	case "${cmd}" in
	"" | -h | --help | help)
		idiot_help
		exit 0
		;;
	-V | --version | version)
		exec "${IDIOT_CMD_DIR}/version" "$@"
		;;
	status)
		exec "${IDIOT_CMD_DIR}/status" "$@"
		;;
	prompt)
		exec "${IDIOT_CMD_DIR}/prompt" "$@"
		;;
	doctor)
		# Runs without the integration too (a limited report, confined
		# under the snap); with a current one, as any host command.
		if [ -n "${IDIOT_SHELL:-}" ] && [ -n "${IDIOT_EVAL_FILE:-}" ] &&
			[ -f "${IDIOT_EVAL_FILE}" ] && [ -w "${IDIOT_EVAL_FILE}" ]; then
			_counted doctor
			run_cmd "${IDIOT_CMD_DIR}/doctor" 1 doctor "$@"
		fi
		exec "${IDIOT_CMD_DIR}/doctor" "$@"
		;;
	*)
		cmd_file="${IDIOT_CMD_DIR}/${cmd}"
		if [ -d "${cmd_file}" ]; then
			case "${1:-}" in
			"" | -h | --help | help) ;;
			*) _counted "${cmd} ${1}" ;;
			esac
			dispatch_subcmd "${cmd}" "${cmd_file}" "$@"
		elif [ -x "${cmd_file}" ]; then
			case "${cmd}" in
			init) exec "${cmd_file}" "$@" ;;
			*)
				require_shell "${cmd}" "$@"
				_counted "${cmd}"
				run_cmd "${cmd_file}" 1 "${cmd}" "$@"
				;;
			esac
		else
			die "unknown command: ${cmd}"
		fi
		;;
	esac
}
main "$@"
